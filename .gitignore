# Rust build artifacts
rust/target/
rust/**/target/
target/

# Python bytecode / caches
**/__pycache__/
*.py[cod]
*.pyo

# Build outputs that are regenerated
*.so
*.dylib
*.dll
*.o

# The org.waywallen.kde Plasma wallpaper plugin does NOT lie in git: the package downloads
# the official release archive (packaging/aur/PKGBUILD), and for running from the tree
# `vendor-check --выкачать` unpacks it here. Only the description is in git.
data/kpackage/org.waywallen.kde/*
!data/kpackage/org.waywallen.kde/vendor.toml

# CMake/ninja build dir for kpackage helper (regenerated)
_archived/rexon/kpackage/org.rexon.wallpaper/build/

# Frame dumps / mmap / shared-memory artifacts
*.mmap
*.rgba
*.raw
/run/

# Virtual environments
venv/
.venv/
env/

# Editor / OS
.DS_Store
*.swp
*~

# Misc caches
.cache/
.mypy_cache/
.pytest_cache/
_archived/rexon/kpackage/org.rexon.wallpaper/compile_commands.json
_archived/rexon/kpackage/org.rexon.wallpaper/build/

# The description translation model (43 MB) is NOT put into the tree: its place is the delivery
# (packaging/aur/PKGBUILD downloads the archives and unpacks them into the data directory)
# or a stand copy via REXON_TRANSLATE_MODEL_DIR. The directory where the core
# looks for the model in the developer tree is closed entirely — a copy put there
# must not silently get into a commit.
/data/translate/
model.*.intgemm.alphas.bin
*vocab.*.spm
_archived/rexon/kpackage/io.openaxon.rexon.video/
/.build-queue.lock
/target-shared/
/target-slot*/
/target-wt/
/.build-queue.slots
/.build-queue.lock.*
/.build-queue.d/
