#!/usr/bin/env python3
"""Check that a change touched comments only.

Usage: scripts/check-comment-only-diff [BASE]   (default BASE: HEAD)

For every changed .rs/.cpp/.h/.qml/.js file between BASE and the working
tree, strips comments and whitespace from both versions and compares the
rest. Exit 1 and list the files whose code differs. Used when translating
comments, so a translation can never change behaviour.
"""
import argparse
import os
import re
import subprocess
import sys

EXTS = (".rs", ".cpp", ".h", ".hpp", ".qml", ".js", ".mjs")


def strip(src: str, ext: str) -> str:
    out = []
    i, n = 0, len(src)
    rust = ext == ".rs"
    while i < n:
        c = src[i]
        nxt = src[i + 1] if i + 1 < n else ""
        if c == "/" and nxt == "/":
            j = src.find("\n", i)
            i = n if j < 0 else j
            continue
        if c == "/" and nxt == "*":
            depth, i = 1, i + 2
            while i < n and depth:
                if rust and src.startswith("/*", i):
                    depth, i = depth + 1, i + 2
                elif src.startswith("*/", i):
                    depth, i = depth - 1, i + 2
                else:
                    i += 1
            continue
        if rust and c in "rb" and re.match(r'b?r#*"', src[i:i + 300]) and (i == 0 or not (src[i - 1].isalnum() or src[i - 1] == "_")):
            m = re.match(r'b?r(#*)"', src[i:])
            close = '"' + m.group(1)
            j = src.find(close, i + len(m.group(0)))
            j = n if j < 0 else j + len(close)
            out.append(src[i:j])
            i = j
            continue
        if c in "\"`" or (c == "'" and not rust):
            j = i + 1
            while j < n and src[j] != c:
                j += 2 if src[j] == "\\" else 1
            out.append(src[i:j + 1])
            i = j + 1
            continue
        if rust and c == "'":
            m = re.match(r"'(\\.[^']*|[^'\\])'", src[i:i + 12])
            if m:
                out.append(m.group(0))
                i += len(m.group(0))
                continue
        out.append(c)
        i += 1
    return re.sub(r"\s+", "", "".join(out))


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("base", nargs="?", default="HEAD", help="revision to compare against (default: HEAD)")
    args = parser.parse_args()
    base = args.base
    if subprocess.run(["git", "rev-parse", "--verify", base], capture_output=True).returncode != 0:
        print(f"check-comment-only-diff: unknown base revision: {base}", file=sys.stderr)
        return 2
    root = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True,
                          check=True).stdout.strip()
    files = subprocess.run(["git", "diff", "--name-only", base, "--"], capture_output=True, text=True, check=True).stdout.split()
    bad, checked = [], 0
    for f in files:
        if not f.endswith(EXTS):
            continue
        ext = "." + f.rsplit(".", 1)[1]
        old = subprocess.run(["git", "show", f"{base}:{f}"], capture_output=True, text=True).stdout
        try:
            new = open(os.path.join(root, f), encoding="utf-8").read()
        except FileNotFoundError:
            bad.append(f + " (deleted)")
            continue
        checked += 1
        if strip(old, ext) != strip(new, ext):
            bad.append(f)
    for f in bad:
        print("CODE CHANGED:", f)
    print(f"checked {checked} file(s), {len(bad)} with code changes")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
