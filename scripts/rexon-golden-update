#!/usr/bin/env python3
"""Single entry point for recapturing Rexon reference files (Wehrwolfmann).

WHY. There are over two hundred reference files in the tree, and they were updated in FOUR
different ways: some — by an environment variable of the bridge comparison, others —
by a generator next to the golden, third — by a core test, fourth — by recapturing
from the LIVE daemon. What updates this particular file had to be
found out in a separate pass. Measurement of the waywallen update to 0.3.8: ~13 hours,
and FOUR commits out of six fixed our own scaffolding rather than accepting someone else's
changes. This command closes the gap: one entry point, one summary, an honest exit
code.

WHAT COUNTS AS A REFERENCE. Everything the code is compared against and that has to be
recaptured from time to time: goldens of the core and the interface layer, the document built from
the matrix and the compiled translation catalog.

⚠️ Since 02.10.2026 Python in the project is only an archive (`_archived/`), neither a reference nor
a bridge. The Python generators (`*_cases.py`, `frozen_*.py`), the `rexon_py` bridge
comparisons and capturing daemon frames with the Python client went there too; their
references stayed in the tree FROZEN and are listed in the "manual" bucket
with this reason. The full table is `docs/golden_reference_map.md`;
`--list` prints it from the REGISTRY BELOW, so they have nowhere to diverge.

⚠️ HONEST SEPARATION IS THE MAIN PROPERTY. References fall into three kinds:

  * `code`   — captured from the tree and reproducible on any machine;
  * `live`   — require a system tool (`lrelease`). Without them the run must say "NOT CHECKED"
               and name the reason. ⛔A silent skip is WORSE than no check:
               on 6 September the comparison was red twice over, and the second defect was not
               visible behind the first;
  * `manual` — there is no recapture mechanism at all (the Python generator went into
               the archive, a raw network answer, a handmade input sample). These are listed by name with a reason and
               are NEVER passed off as checked.

The summary always prints ALL three buckets, even when the first one is already red.

Run:
    scripts/rexon-golden-update --check          — write nothing, say
                                                   what diverged (code ≠ 0)
    scripts/rexon-golden-update                  — update everything and show the delta
    scripts/rexon-golden-update --list           — the table "reference → what updates it"
    scripts/rexon-golden-update --kind code      — only this kind
    scripts/rexon-golden-update de_matrix        — only groups with this substring
    scripts/rexon-golden-update --check --verbose — a line for every file

Exit codes:
    0 — everything matched and everything was checked;
    1 — there are divergences (listed by name);
    2 — the run failed (no generator, a broken tool);
    3 — no divergences, but some references were NOT CHECKED (no daemon and so on).
    ⚠️ 1 overrides 3, so "not checked" is printed in the summary as a SEPARATE
    line, also when red.

⛔ Does not touch the live system: installs nothing into the system, does not query the daemon.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from pathlib import Path
from typing import Callable

REPO = Path(__file__).resolve().parent.parent
CORE_GOLDEN = REPO / "rust/rexon-core/tests/golden"
GUI_GOLDEN = REPO / "rust/rexon-gui/tests/golden"

KIND_CODE = "code"
KIND_LIVE = "live"
KIND_MANUAL = "manual"

GEN_TIMEOUT = 900


class Unavailable(Exception):
    """There is no prerequisite for recapturing — this is "NOT CHECKED", not "matches"."""


class Broken(Exception):
    """Recapturing broke — the run failed."""


# ══════════════════════════════════════════════════════════════════════════
#  Printing
# ══════════════════════════════════════════════════════════════════════════

_TTY = sys.stdout.isatty()


def paint(text: str, code: str) -> str:
    return f"\033[{code}m{text}\033[0m" if _TTY else text


def red(t: str) -> str:
    return paint(t, "31")


def green(t: str) -> str:
    return paint(t, "32")


def yellow(t: str) -> str:
    return paint(t, "33")


def rel(p: Path) -> str:
    try:
        return str(p.relative_to(REPO))
    except ValueError:
        return str(p)


# ══════════════════════════════════════════════════════════════════════════
#  Delta
# ══════════════════════════════════════════════════════════════════════════

def _leaves(node, prefix: str, out: dict) -> None:
    """Flatten JSON into a flat map "path → value" for showing the delta."""
    if isinstance(node, dict):
        for k, v in node.items():
            _leaves(v, f"{prefix}.{k}" if prefix else str(k), out)
    elif isinstance(node, list):
        out[prefix + "[]"] = len(node)
        for i, v in enumerate(node):
            _leaves(v, f"{prefix}[{i}]", out)
    else:
        out[prefix] = node


def describe_delta(path: Path, old: bytes, new: bytes, limit: int = 6) -> list[str]:
    """A human "what changed and by how much" between two revisions."""
    lines = [f"{len(old)} → {len(new)} bytes ({len(new) - len(old):+d})"]
    if path.suffix == ".json":
        try:
            a, b = json.loads(old), json.loads(new)
        except Exception:
            a = b = None
        if a is not None:
            la, lb = {}, {}
            _leaves(a, "", la)
            _leaves(b, "", lb)
            added = sorted(set(lb) - set(la))
            removed = sorted(set(la) - set(lb))
            changed = sorted(k for k in set(la) & set(lb) if la[k] != lb[k])
            lines.append(
                f"fields: +{len(added)} −{len(removed)} changed {len(changed)}")
            for tag, keys in (("+", added), ("−", removed), ("~", changed)):
                for k in keys[:limit]:
                    lines.append(f"    {tag} {k or '(root)'}")
                if len(keys) > limit:
                    lines.append(f"    {tag} … {len(keys) - limit} more")
            return lines
    if path.suffix in (".md", ".ts", ".py", ".rs", ".txt"):
        na = old.decode("utf-8", "replace").splitlines()
        nb = new.decode("utf-8", "replace").splitlines()
        lines.append(f"lines: {len(na)} → {len(nb)} ({len(nb) - len(na):+d})")
    return lines


# ══════════════════════════════════════════════════════════════════════════
#  Shared recapture executors
# ══════════════════════════════════════════════════════════════════════════

def run(argv: list[str], *, cwd: Path = REPO, env: dict | None = None,
        capture_stdout: bool = False) -> subprocess.CompletedProcess:
    e = dict(os.environ)
    if env:
        e.update(env)
    return subprocess.run(
        argv, cwd=str(cwd), env=e, timeout=GEN_TIMEOUT,
        stdout=subprocess.PIPE if capture_stdout else subprocess.DEVNULL,
        stderr=subprocess.PIPE)


def capture_cargo_doc(test: str, dest: Path) -> dict[Path, bytes]:
    """A document that a core test builds under `REXON_UPDATE_DOC=1`."""
    saved = dest.read_bytes() if dest.exists() else None
    try:
        res = run(["cargo", "test", "-p", "rexon-core", "--test", test],
                  cwd=REPO / "rust", env={"REXON_UPDATE_DOC": "1"})
        if res.returncode != 0:
            raise Broken(f"cargo test --test {test} failed:\n"
                         + res.stderr.decode("utf-8", "replace")[-1500:])
        return {dest: dest.read_bytes()}
    finally:
        if saved is not None:
            dest.write_bytes(saved)


#: The vendored translation catalogs (`waywallen_<lang>.ts`) and where the built ones
#: go (`waywallen_<lang>.qm` next to the module). There are as many catalogs
#: as `.ts` files are vendored: since waywallen 0.5.0 — ru and de. Previously a single
#: Russian one was pinned here, and a German Rexon saw the vendor pages
#: in English, although upstream has the translation.
VENDOR_I18N = REPO / "data/qt_wallpaper_engine/qml_ui/waywallen/ui/i18n"
VENDOR_QM_DIR = REPO / "data/qt_wallpaper_engine/qml_ui"


def _vendor_catalogs() -> list[tuple[Path, Path]]:
    """Pairs (vendored `.ts`, built `.qm`) for all vendor languages."""
    return [(ts, VENDOR_QM_DIR / (ts.stem + ".qm"))
            for ts in sorted(VENDOR_I18N.glob("waywallen_*.ts"))]


def capture_qm() -> dict[Path, bytes]:
    """Translation catalogs of the vendor labels: each `.ts` → `lrelease` → `.qm`."""
    catalogs = _vendor_catalogs()
    if not catalogs:
        raise Broken(f"no vendored catalogs {rel(VENDOR_I18N)}/waywallen_*.ts")
    tool = _find_lrelease()
    if tool is None:
        raise Unavailable(
            "`lrelease` from Qt not found — the translation catalog was not rebuilt. "
            "Install `qt6-tools` (Arch/CachyOS) or the distribution's equivalent")
    built: dict[Path, bytes] = {}
    with tempfile.TemporaryDirectory() as d:
        for ts, qm in catalogs:
            out = Path(d) / qm.name
            res = subprocess.run([tool, str(ts), "-qm", str(out)],
                                 capture_output=True, timeout=GEN_TIMEOUT)
            if res.returncode != 0 or not out.exists():
                raise Broken(f"lrelease did not build the catalog {ts.name}:\n"
                             + res.stderr.decode("utf-8", "replace")[-1500:])
            built[qm] = out.read_bytes()
    return built


def _find_lrelease() -> str | None:
    """The same candidate order as in the core: Qt6 first, then PATH."""
    for cand in ("/usr/lib/qt6/bin/lrelease", "/usr/bin/lrelease-qt6",
                 "/usr/lib/qt/bin/lrelease"):
        if os.access(cand, os.X_OK):
            return cand
    return shutil.which("lrelease-qt6") or shutil.which("lrelease")


# ══════════════════════════════════════════════════════════════════════════
#  Registry
# ══════════════════════════════════════════════════════════════════════════

@dataclass
class Result:
    same: list = field(default_factory=list)
    diff: list = field(default_factory=list)      # (path, [delta lines])
    broken: list = field(default_factory=list)    # (path, reason)


@dataclass
class Group:
    name: str
    kind: str
    title: str
    how: str                       # what updates it NOW (one line)
    was: str                       # what updated it BEFORE this entry point
    paths: list = field(default_factory=list)
    capture: Callable | None = None    # → {path: new bytes}
    custom: Callable | None = None     # its own check (update, verbose)
    note: str = ""


def registry() -> list[Group]:
    """All references with a recapture mechanism. Order — from cheap to expensive."""
    g = [
        Group(
            name="de_matrix",
            kind=KIND_CODE,
            title="environment customization matrix (document)",
            how="`REXON_UPDATE_DOC=1 cargo test -p rexon-core --test de_customization`",
            was="the same command, but only the text inside the document itself knew it",
            paths=[REPO / "docs/de_customization_matrix.md"],
            capture=lambda: capture_cargo_doc(
                "de_customization", REPO / "docs/de_customization_matrix.md"),
        ),
        Group(
            name="waywallen_qm",
            kind=KIND_LIVE,
            title="translation catalog of the waywallen vendor labels",
            how="`lrelease` of the vendored `.ts` → `.qm`",
            was="the `lrelease …` line from `docs/testing.md`, by hand",
            paths=[qm for _, qm in _vendor_catalogs()],
            capture=capture_qm,
            note="needs `lrelease` from Qt on the machine; the `.ts` itself is vendored by "
                 "`scripts/sync-waywallen-*.py`, it is not touched here",
        ),
    ]
    return g


# ══════════════════════════════════════════════════════════════════════════
#  References WITHOUT a recapture mechanism
# ══════════════════════════════════════════════════════════════════════════
#
# They must not be silently left out: "not listed" reads as "fine".
# The reasons are taken from the headers of the comparisons that read these files.

MANUAL_REASONS = [
    ("we_client_reference.json",
     "edited BY HAND and only with proof; disputes are settled by the live "
     "control_pb2 descriptor from the vendor .proto"),
    ("_raw.json", "a recorded answer of an external service (network)"),
    ("_raw.html", "a recorded answer of an external service (network)"),
    (".xml", "a recorded OCS API answer"),
    (".rxn", "a handmade input sample, not a snapshot"),
    (".vdf", "synthetic input for parser corner cases"),
    (".ron", "recorded output of `cosmic-settings appearance export` (1.11.0) "
     "in a separate HOME, recapture with the same command"),
    ("we_live_frames.json",
     "captured from the live daemon with the Python client; the client went into the archive "
     "(_archived/) — the snapshot is frozen"),
    ("_reference.json",
     "a recorded reference of the live Python; the bridge and Python are archived, frozen"),
    ("_cases.json",
     "captured by a Python generator; the generators are archived (_archived/golden), "
     "the reference is frozen"),
]

#: Files that are NOT references (generators, cache, helpers).
NOT_A_GOLDEN = ("__pycache__", ".py")


def manual_files() -> list[tuple[Path, str]]:
    """References without recapturing: path and reason. New ones appear by themselves."""
    covered = {p for g in registry() for p in g.paths}
    out = []
    for root in (CORE_GOLDEN, GUI_GOLDEN):
        if not root.exists():
            continue
        for p in sorted(root.rglob("*")):
            if not p.is_file() or p in covered:
                continue
            if any(part in NOT_A_GOLDEN or part.endswith(".py")
                   for part in (p.name, p.parent.name)):
                continue
            reason = "no recapture mechanism"
            for suffix, why in MANUAL_REASONS:
                if why and p.name.endswith(suffix):
                    reason = why
                    break
            if root is GUI_GOLDEN:
                reason = ("FROZEN: the Python mirrors of the tab were removed, "
                          "nothing to capture from")
            out.append((p, reason))
    return out


def orphan_goldens() -> list[Path]:
    """References that no comparison reads are a defect too.

    A file that nobody reads gives a false sense of coverage on a vendor
    update: it lies there, looks like a reference and guards nothing.
    """
    haystacks = []
    for d in (REPO / "rust/rexon-core/tests", REPO / "rust/rexon-gui",
              REPO / "rust/rexon-core/src", REPO / "scripts"):
        for f in d.rglob("*"):
            if f.is_file() and f.suffix in (".rs", ".py") and "golden" not in f.parts[-2:]:
                try:
                    haystacks.append(f.read_text(encoding="utf-8", errors="replace"))
                except OSError:
                    pass
    blob = "\n".join(haystacks)
    out = []
    for p, _ in manual_files():
        if p.name not in blob:
            out.append(p)
    return out


# ══════════════════════════════════════════════════════════════════════════
#  Run
# ══════════════════════════════════════════════════════════════════════════

def run_group(g: Group, update: bool, verbose: bool) -> tuple[Result, str]:
    """→ (result, the "not checked" reason or an empty string)."""
    print(f"\n[{g.kind}] {g.name} — {g.title}")
    print(f"    how: {g.how}")
    try:
        if g.custom is not None:
            return g.custom(update, verbose), ""
        res = Result()
        fresh = g.capture()
        for path, new in fresh.items():
            old = path.read_bytes() if path.exists() else b""
            if old == new:
                res.same.append(path)
                print(f"    {green('matches')}  {rel(path)}")
                continue
            delta = describe_delta(path, old, new)
            res.diff.append((path, delta))
            if update:
                path.write_bytes(new)
                print(f"    {yellow('updated')} {rel(path)}")
            else:
                print(f"    {red('DIVERGED')} {rel(path)}")
            for line in delta:
                print(f"        {line}")
        return res, ""
    except Unavailable as e:
        print(f"    {yellow('NOT CHECKED')}: {e}")
        return Result(), str(e)
    except Broken as e:
        print(f"    {red('RUN FAILED')}: {e}")
        r = Result()
        r.broken.append((Path(g.name), str(e)))
        return r, ""
    except subprocess.TimeoutExpired:
        msg = f"recapturing did not fit into {GEN_TIMEOUT} s"
        print(f"    {red('RUN FAILED')}: {msg}")
        r = Result()
        r.broken.append((Path(g.name), msg))
        return r, ""


def print_table() -> None:
    print("REFERENCES WITH A RECAPTURE MECHANISM\n")
    for g in registry():
        print(f"  {g.name}  [{g.kind}]  — {g.title}")
        print(f"      files:  {len(g.paths)}")
        print(f"      was:    {g.was}")
        print(f"      now:    scripts/rexon-golden-update {g.name}")
        print(f"              (inside: {g.how})")
        if g.note:
            print(f"      ⚠️ {g.note}")
        print()
    manual = manual_files()
    print(f"REFERENCES WITHOUT RECAPTURING — {len(manual)} "
          "(edited by hand, each with a reason)\n")
    by_reason: dict[str, list[Path]] = {}
    for p, why in manual:
        by_reason.setdefault(why, []).append(p)
    for why, items in sorted(by_reason.items(), key=lambda kv: -len(kv[1])):
        print(f"  {len(items):3} × {why}")
        for p in items[:4]:
            print(f"        {rel(p)}")
        if len(items) > 4:
            print(f"        … {len(items) - 4} more")
        print()


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Single entry point for recapturing Rexon reference files",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__)
    ap.add_argument("filters", nargs="*",
                    help="substrings of group names (empty — all)")
    ap.add_argument("--check", action="store_true",
                    help="write nothing, only say what diverged")
    ap.add_argument("--list", action="store_true",
                    help="the table \"reference → what updates it\"")
    ap.add_argument("--kind", choices=[KIND_CODE, KIND_LIVE],
                    help="only references of this kind")
    ap.add_argument("--verbose", "-v", action="store_true",
                    help="a line for every file, not only for divergences")
    args = ap.parse_args()

    if args.list:
        print_table()
        return 0

    groups = registry()
    if args.kind:
        groups = [g for g in groups if g.kind == args.kind]
    if args.filters:
        groups = [g for g in groups
                  if any(f in g.name or f in g.title for f in args.filters)]
    if not groups:
        print(red("no group matched the filter"), file=sys.stderr)
        return 2

    update = not args.check
    print("mode: " + ("UPDATE (files will be rewritten)" if update
                       else "CHECK (the tree does not change)"))
    started = time.time()
    same, diff, broken, unchecked = [], [], [], []
    for g in groups:
        res, why = run_group(g, update, args.verbose)
        same += res.same
        diff += [(g, p, d) for p, d in res.diff]
        broken += [(g, p, r) for p, r in res.broken]
        if why:
            unchecked.append((g, why))

    print("\n" + "═" * 72)
    print(f"SUMMARY ({time.time() - started:.0f} s)")
    print(f"  matched: {len(same)}")

    # ⚠️ The three buckets are printed ALWAYS and separately. Lesson of 06.09.2026:
    # the comparison was red twice over, and the second defect was not visible behind the first.
    verb = "updated" if update else "DIVERGED"
    print(f"  {verb}: {len(diff)}")
    for g, p, d in diff:
        # Into the summary — the most informative line: "fields: …" says more
        # than "so many bytes".
        head = next((l for l in d if l.startswith(("fields", "lines"))),
                    d[0] if d else "")
        print(f"      [{g.name}] {rel(p)} — {head}")

    print(f"  NOT CHECKED: {len(unchecked)} "
          + ("(no prerequisites — this is NOT \"fine\")" if unchecked else ""))
    for g, why in unchecked:
        print(f"      [{g.name}] {why}")

    print(f"  run failed: {len(broken)}")
    for g, p, r in broken:
        print(f"      [{g.name}] {p.name}: {r.splitlines()[0]}")

    manual = manual_files()
    print(f"  without a recapture mechanism: {len(manual)} "
          "(see --list and docs/golden_reference_map.md)")
    orphans = orphan_goldens()
    if orphans:
        print(f"  {yellow('ORPHAN REFERENCE')}: {len(orphans)} "
              "— the file lies there, but no comparison reads it")
        for p in orphans:
            print(f"      {rel(p)}")

    if broken:
        return 2
    if diff and not update:
        return 1
    if unchecked:
        return 3
    return 0


if __name__ == "__main__":
    sys.exit(main())
