#!/usr/bin/env bash
# Pre-flight QML check wrapper. Usage:
#   qmllint-check file1.qml [file2.qml ...]
# Exit 0 = all OK (warnings allowed)
# Exit 1 = errors found
# Exit 2 = qmllint not available
#
# Wraps /usr/lib/qt6/bin/qmllint так как qmllint6 alias не существует.
# Использовать ПОСЛЕ edit .qml файла, ДО kpackage rebuild + plasmashell restart.

set -u

QMLLINT="/usr/lib/qt6/bin/qmllint"

if [ ! -x "$QMLLINT" ]; then
    QMLLINT="$(command -v qmllint 2>/dev/null || true)"
    if [ -z "$QMLLINT" ]; then
        echo "ERROR: qmllint not found. Install qt6-declarative." >&2
        exit 2
    fi
fi

if [ "$#" -lt 1 ]; then
    echo "Usage: qmllint-check file1.qml [file2.qml ...]" >&2
    exit 2
fi

RC=0
for f in "$@"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: $f not found" >&2
        RC=2
        continue
    fi
    out="$("$QMLLINT" "$f" 2>&1)" || RC=1
    if [ -n "$out" ]; then
        echo "==> $f"
        printf '%s\n' "$out"
    fi
done

exit $RC
