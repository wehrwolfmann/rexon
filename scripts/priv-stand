#!/usr/bin/env bash
# Bench of the session privilege helper ("one password per launch", levels 2–3;
# all three levels are described in docs/testing.md).
#
# Without root, without pkexec, without the real pacman and without a GUI:
#   * level 2 — tests/priv_stand.rs: the real window (privilege::client) and
#     the `rexon-priv-stand` helper as an ORDINARY process via socketpair on fd 0/1;
#     a "dry" RootIo with a prefix root, an argv log, fake logind/clock/sleep;
#   * level 3 — tests/priv_userns.rs: the REAL rexon-priv-helper as "root"
#     in `unshare -r --mount` (packaging/test/priv-ns-enter.sh): fake
#     /usr/bin, /etc, /usr/share, /var/tmp; real files, PDEATHSIG, EOF.
#     No unshare or the kernel does not allow namespaces — SKIPPED with a reason.
#
# Usage:
#   scripts/priv-stand                 # both levels (built through build-queue)
#   scripts/priv-stand --release-check # + check the built release helper
#   scripts/priv-stand -- <filter>     # arguments after -- go to the test runner
#
# Exit code — as for cargo test; --release-check: 1 if the release
# rexon-priv-helper contains a bench string or rexon-priv-stand lies next to it.

set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

release_check=0
extra=()
while [ $# -gt 0 ]; do
    case "$1" in
        --release-check) release_check=1; shift ;;
        --) shift; extra=("$@"); break ;;
        -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "priv-stand: unknown option $1" >&2; exit 2 ;;
    esac
done

BUILD_QUEUE_SLOTS="${BUILD_QUEUE_SLOTS:-1}" "$ROOT/scripts/build-queue" \
    test -p rexon-core --features stand --test priv_stand --test priv_userns \
    -- --nocapture "${extra[@]}"

if [ "$release_check" -eq 1 ]; then
    rel="${BUILD_QUEUE_TARGET:-$ROOT/target-shared}/release"
    if [ ! -x "$rel/rexon-priv-helper" ]; then
        echo "priv-stand: NOT CHECKED — no $rel/rexon-priv-helper (build: scripts/build-queue build-app)" >&2
        exit 3
    fi
    bad=0
    for needle in REXON_STAND_DIR REXON_STAND_BUILD rexon-priv-stand priv-ns-enter; do
        if grep -qaF "$needle" "$rel/rexon-priv-helper"; then
            echo "priv-stand: ⛔ the release rexon-priv-helper contains the bench string «$needle»" >&2
            bad=1
        fi
    done
    if [ -e "$rel/rexon-priv-stand" ]; then
        echo "priv-stand: ⛔ $rel contains rexon-priv-stand — was the release built with the stand feature?" >&2
        bad=1
    fi
    [ "$bad" -eq 0 ] && echo "priv-stand: the release helper is clean ($rel/rexon-priv-helper)"
    exit "$bad"
fi
