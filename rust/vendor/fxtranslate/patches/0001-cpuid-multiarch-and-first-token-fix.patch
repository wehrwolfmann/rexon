+    /// испорченным первым словом и 88 % строк со строчной первой буквы.
+    fn начала_слов(&self) -> &[bool] {
+        self.начала.get_or_init(|| {
+            (0..self.weights.output_vocab() as u32)
+                .map(|id| {
