+fn первый_токен_лечить() -> bool {
+    static M: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *M.get_or_init(|| std::env::var("FXT_FIRST_TOKEN").map(|v| v != "0").unwrap_or(true))
+}
+
+/// Whether the shortlist is applied per block (marian's `CorpusBatch` behaviour)
