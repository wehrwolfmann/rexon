+    /// argmax по готовым логитам, но только среди пьес-начал (см. `начала_слов`).
+    fn argmax_начала(&self, logits: &[f32]) -> u32 {
+        let маска = self.начала_слов();
+        let mut best = usize::MAX;
+        for (i, &l) in logits.iter().enumerate() {
+            if маска.get(i).copied().unwrap_or(true) && (best == usize::MAX || l > logits[best]) {
+                best = i;
+            }
+        }
+        if best == usize::MAX {
+            argmax(logits)
+        } else {
+            best as u32
+        }
+    }
