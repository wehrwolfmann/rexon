+/// The tied output projection restricted to one *block's* shared shortlist,
+/// prepared once per block: candidate rows gathered, prepared bias computed and
+/// (with the SIMD kernel) the weight packed. The per-token path rebuilt all of
+/// this on every decode step, which is why a shortlist never paid for itself.
+struct BlockProj {
+    ids: Vec<u32>,
+    bias: Vec<f32>,
+    qa: f32,
+    unquant: f32,
+    b_raw: Vec<i8>,
+    #[cfg(fast_gemm)]
+    pb: Option<crate::gemm::PreparedB>,
+}
+
+impl BlockProj {
+    /// `logits[m, n]` over the candidate columns.
+    fn logits(&self, a: &[u8], m: usize, d: usize) -> Vec<f32> {
+        #[cfg(fast_gemm)]
+        if let Some(pb) = self.pb.as_ref() {
+            return pb.matmul(a, m, self.unquant, &self.bias);
+        }
+        ops::intgemm_affine(a, m, d, &self.b_raw, self.ids.len(), self.unquant, &self.bias)
+    }
+}
