  "translation_ttl": 2592000,
  "sql_literals": [
    "\n                CREATE TABLE IF NOT EXISTS items (\n                    id TEXT PRIMARY KEY,\n                    category_id INTEGER,\n                    name TEXT, author TEXT,\n                    description TEXT, description_ru TEXT,\n                    rating INTEGER, downloads INTEGER,\n                    preview_url TEXT, download_url TEXT,\n                    download_name TEXT, download_size INTEGER,\n                    version TEXT, license TEXT,\n                    created TEXT, updated TEXT,\n                    cached_at REAL\n                );\n                CREATE TABLE IF NOT EXISTS previews (\n                    url TEXT PRIMARY KEY,\n                    local_path TEXT,\n                    cached_at REAL\n                );\n                CREATE TABLE IF NOT EXISTS lists (\n                    key TEXT PRIMARY KEY,\n                    ids TEXT,\n                    total INTEGER,\n                    cached_at REAL\n                );\n                CREATE TABLE IF NOT EXISTS translations (\n                    src_hash TEXT PRIMARY KEY,\n                    translated TEXT,\n                    cached_at REAL\n                );\n                ",
    "ALTER TABLE items ADD COLUMN preview_urls TEXT",
    "DELETE FROM lists",
    "DELETE FROM translations WHERE cached_at < ?",
    "DELETE FROM translations WHERE src_hash=?",
    "INSERT OR REPLACE INTO items\n               (id, category_id, name, author, description, description_ru,\n                rating, downloads, preview_url, preview_urls, download_url,\n                download_name, download_size, version, license, created,\n                updated, cached_at)\n               VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
    "INSERT OR REPLACE INTO lists (key, ids, total, cached_at) VALUES (?,?,?,?)",
    "INSERT OR REPLACE INTO previews (url, local_path, cached_at) VALUES (?,?,?)",
    "INSERT OR REPLACE INTO translations (src_hash, translated, cached_at) VALUES (?,?,?)",
    "PRAGMA table_info(items)",
    "SELECT * FROM items WHERE id=?",
    "SELECT id, name, preview_url FROM items",
    "SELECT ids, total, cached_at FROM lists WHERE key=?",
    "SELECT local_path FROM previews WHERE url=?",
    "SELECT translated, cached_at FROM translations WHERE src_hash=?",
    "SELECT url, local_path FROM previews"
  ],
