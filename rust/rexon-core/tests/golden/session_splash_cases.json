  "kwin_rule_body": "Description=Rexon: заставка входа поверх всего\nfsplevel=0\nfsplevelrule=2\nabove=true\naboverule=2\nfullscreen=true\nfullscreenrule=2\nnoborder=true\nnoborderrule=2\nskiptaskbar=true\nskiptaskbarrule=2\nskippager=true\nskippagerrule=2\nskipswitcher=true\nskipswitcherrule=2\nwmclass=rexon-session-splash\nwmclassmatch=1\ntypes=1\n",
  "splash_qml": "import QtQuick\n\nRectangle {\n    id: root\n    color: \"black\"\n\n    property int stage\n\n    Image {\n        anchors.fill: parent\n        fillMode: Image.PreserveAspectFit\n        asynchronous: false\n        cache: false\n        source: \"images/poster.png\"\n    }\n}\n",
  "runtime_dir": "/HOME/run",
  "launcher_exec_rexon": "/usr/local/bin/rexon --session-splash",
  "systemd_unit_content": "[Unit]\nDescription=Rexon Session Splash (startup movie at login, Steam style)\nPartOf=graphical-session.target\nAfter=plasma-kwin_wayland.service plasma-kwin_x11.service\nBefore=plasma-plasmashell.service\n\n[Service]\nType=notify\nExecStart=/usr/local/bin/rexon --session-splash\nSlice=session.slice\n# страховки: сломанный mpv задержит вход максимум на ~15 с\n# (overlay-порог 6 c + фолбэк-mpv 6 c = 12 c до READY, + слак).\nTimeoutStartSec=15\nTimeoutStopSec=5\n\n[Install]\nWantedBy=plasma-workspace.target\n",
  "launcher_exec_fallback": "/usr/bin/python3 -m rexon.app --session-splash",
  "python_executable": "/usr/bin/python3",
  "steam_root": "/HOME/.local/share/Steam",
  "vdf_text": "\"UserLocalConfigStore\"\n{\n\t\"Software\"\n\t{\n\t\t\"GetStartupMovies\"\t\t\"[{\\\"communityitemid\\\": \\\"34806\\\", \\\"name\\\": \\\"Special Delivery\\\", \\\"item_title\\\": \\\"Special Delivery Movie\\\", \\\"appid\\\": 1234}, {\\\"communityitemid\\\": \\\"777\\\", \\\"name\\\": \\\"\\\", \\\"item_title\\\": \\\"Days Gone\\\", \\\"appid\\\": 5678}, {\\\"communityitemid\\\": \\\"\\\", \\\"name\\\": \\\"ignored\\\"}]\"\n\t}\n}\n",
