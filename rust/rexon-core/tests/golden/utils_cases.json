 "parse_dbus_reply": {
  "array": {
   "raw": "method return time=1\n   array [\n      string \"a\"\n   ]\n",
   "want": "a"
  },
  "bool_int": {
   "raw": "method return time=1\n   boolean true\n   int32 -5\n",
   "want": "true\n-5"
  },
  "cyrillic": {
   "raw": "method return time=1\n   string \"Загрузки/обои.png\"\n",
   "want": "Загрузки/обои.png"
  },
  "dict_entry": {
   "raw": "method return time=1\n   array [\n      dict entry(\n         string \"k\"\n         variant string \"v\"\n      )\n   ]\n",
   "want": "k\nv"
  },
  "empty": {
   "raw": "",
   "want": ""
  },
  "empty_value": {
   "raw": "method return time=1\n   string \n",
   "want": ""
  },
  "get_id": {
   "raw": "method return time=1785366332.815390 sender=org.freedesktop.DBus -> destination=:1.1424 serial=4294967295 reply_serial=2\n   string \"52c534ada5d0fd8c9c63561edb4845fc\"\n",
   "want": "52c534ada5d0fd8c9c63561edb4845fc"
  },
  "not_a_type": {
   "raw": "method return time=1\n   stringy 5\n   variantstring 6\n",
   "want": ""
  },
  "object_path": {
   "raw": "method return time=1\n   object path \"/org/kde/KWin\"\n",
   "want": "/org/kde/KWin"
  },
  "object_path_spaced": {
   "raw": "method return time=1\n   object    path \"/x\"\n",
   "want": "/x"
  },
  "only_header": {
   "raw": "method return time=1 sender=x -> destination=y\n",
   "want": ""
  },
  "quotes_inside": {
   "raw": "method return time=1\n   string \"он сказал \"да\"\"\n",
   "want": "он сказал \"да\""
  },
  "server_info": {
   "raw": "method return time=1785366332.816689 sender=:1.46 -> destination=:1.1425 serial=10076 reply_serial=2\n   string \"Plasma\"\n   string \"KDE\"\n   string \"6.7.3\"\n   string \"1.2\"\n",
   "want": "Plasma\nKDE\n6.7.3\n1.2"
  },
  "single_quote_char": {
   "raw": "method return time=1\n   string \"\n",
   "want": "\""
  },
  "trailing_spaces": {
   "raw": "method return time=1\n   string \"x\"   \n",
   "want": "x"
  },
  "types": {
   "raw": "method return time=1\n   byte 7\n   double 1.5\n   signature \"s\"\n   uint64 18446744073709551615\n   int16 -3\n   uint16 3\n   int64 -9\n",
   "want": "7\n1.5\ns\n18446744073709551615\n-3\n3\n-9"
  },
  "variant_array": {
   "raw": "method return time=1785366332.818334 sender=org.freedesktop.DBus -> destination=:1.1427 serial=4294967295 reply_serial=2\n   variant       array [\n      ]\n",
   "want": ""
  },
  "variant_prefixed": {
   "raw": "method return time=1\n   variant   string \"x y\"\n",
   "want": "x y"
  },
  "variant_uint32": {
   "raw": "method return time=1785366332.817569 sender=:1.92 -> destination=:1.1426 serial=9900 reply_serial=2\n   variant       uint32 2\n",
   "want": "2"
  }
 },
