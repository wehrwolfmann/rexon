"backup-this-file@h3nr1ke/metadata.json": "{\n    \"description\": \"Create a backup of the selected file by copying it and appending the suffix .bkp.\",\n    \"uuid\": \"backup-this-file@h3nr1ke\",\n    \"name\": \"Backup this file\",\n    \"author\": \"h3nr1ke\",\n    \"version\": \"0.0.1\"\n}",
"backup-this-file@h3nr1ke.nemo_action": "[Nemo Action]\nName=Backup this file\nName[ca]=Crea una còpia de seguretat d'aquest fitxer\nName[cs]=Zálohuj tento soubor\nName[da]=Tag en sikkerhedskopi af denne fil\nName[de]=Backup dieser Datei erstellen\nName[el]=Backup του αρχείου\nName[es]=Crear una copia de seguridad de este archivo\nName[eu]=Egin fitxategi honen babeskopia\nName[fi]=Varmista tämä tiedosto\nName[fr]=Sauvegarder ce fichier\nName[hu]=Biztonsági mentés erről a fájlról\nName[it]=Effettua il backup di questo file\nName[ja]=このファイルをバックアップ\nName[nl]=Maak een back-up van dit bestand\nName[pt]=Criar uma cópia de segurança deste ficheiro\nName[pt_BR]=Criar um backup deste arquivo\nName[uk]=Створити резервну копію\nName[vi]=Sao lưu tập tin này\nName[zh_CN]=备份此文件\nComment=Backup the selected file by creating a copy and appending the suffix .bkp\nComment[ja]=ファイル名に .bkp を付け足したコピーを作成し、選択したファイルをバックアップします\nExec=<backup-this-file@h3nr1ke/backup-this-file.sh \"%F\">\nConditions=exec <backup-this-file@h3nr1ke/check.sh \"%F\">;\nIcon-Name=edit-copy-symbolic\nSelection=notnone\nExtensions=any;\nDependencies=gettext;bash;\nSeparator=\" \""
}
