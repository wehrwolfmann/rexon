msgstr "SVG-зображення містить сценарії або посилання в інтернет"

#: rust/rexon-core/src/rxn_manifest.rs
msgid ""
"the file runs code (%1), but its item does not declare the 'exec' permission"
msgstr "файл запускає код (%1), але його елемент не оголошує дозвіл 'exec'"

#: rust/rexon-core/src/rxn_manifest.rs
msgid "Conky widget settings"
msgstr "налаштування віджета Conky"

#: rust/rexon-core/src/rxn_manifest.rs
msgid "Lua script"
msgstr "сценарій Lua"

#: rust/rexon-core/src/rxn_manifest.rs
msgid "JavaScript"
msgstr "JavaScript"

#: rust/rexon-core/src/rxn_manifest.rs
msgid "web page with scripts"
msgstr "вебсторінка зі сценаріями"

#: rust/rexon-core/src/rxn_manifest.rs
msgid "QML"
msgstr "QML"

#: rust/rexon-core/src/rxn_manifest.rs
msgid "shortcut that runs a command"
msgstr "ярлик, який запускає команду"

#: rust/rexon-core/src/rxn_manifest.rs
msgid "script"
msgstr "сценарій"

#: rust/rexon-core/src/rxn_manifest.rs
msgid "program"
msgstr "програма"

#: rust/rexon-core/src/rxn_manifest.rs
msgid ""
"'%1' is not under a free license, so a derived package cannot be made from it"
msgstr ""
"'%1' не під вільною ліцензією, тому зробити на його основі похідний пакунок "
"не можна"

#: rust/rexon-core/src/rxn_manifest.rs
msgid "the package is derived from '%1' and must keep its license %2"
msgstr "пакунок зроблено на основі '%1', і він має зберегти його ліцензію %2"

#: rust/rexon-core/src/rxn_manifest.rs
msgid "'%1' has no license, so Rexon cannot make a derived package from it."
msgstr ""
"У '%1' немає ліцензії, тому Rexon не може зробити на його основі похідний "
"пакунок."

#: rust/rexon-core/src/rxn_manifest.rs
msgid ""
"The license of '%1' does not allow derived works to be shared, so Rexon "
"cannot make a derived package from it."
msgstr ""
"Ліцензія '%1' не дозволяє поширювати похідні роботи, тому Rexon не може "
"зробити на його основі похідний пакунок."

#: rust/rexon-core/src/rxn_manifest.rs
msgid "%1 has no license: it can be installed here, but not shared"
msgstr "%1 без ліцензії: тут його можна встановити, але не опублікувати"

#: rust/rexon-core/src/rxn_manifest.rs
msgid ""
"%1 is licensed for non-commercial use only — the Workshop does not allow that"
msgstr ""
"%1 під ліцензією лише для некомерційного використання — Майстерня такого не "
"допускає"

#: rust/rexon-core/src/rxn_manifest.rs
msgid "%1 forbids changes (ND) — Rexon does not share such content"
msgstr "%1 забороняє зміни (ND) — Rexon такого не публікує"

#: rust/rexon-core/src/rxn_manifest.rs
msgid "%1 is not free to share"
msgstr "%1 не можна вільно публікувати"

#: rust/rexon-core/src/rxn_manifest.rs
msgid ""
"Rexon does not know the license %1 of %2 and cannot tell whether it allows "
"sharing"
msgstr ""
"%2: Rexon не знає ліцензії %1 і не може сказати, чи дозволяє вона публікацію"

#: rust/rexon-core/src/rxn_manifest.rs
msgid "The package"
msgstr "Пакунок"

#: rust/rexon-core/src/rxn_manifest.rs
msgid ""
"'%1' is downloaded during installation — a shared package must contain its "
"files"
msgstr ""
"'%1' завантажується під час встановлення — пакунок для публікації має сам "
"містити свої файли"

#: rust/rexon-core/src/rxn_manifest.rs
msgid "path to your home folder"
msgstr "шлях до вашої домашньої теки"

#: rust/rexon-core/src/rxn_manifest.rs
msgid "your user name"
msgstr "ваше ім’я користувача"

#: rust/rexon-core/src/rxn_manifest.rs
