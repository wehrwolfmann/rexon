#: rust/rexon-core/src/animations.rs
msgid "Could not change the setting: %1 failed."
msgstr "Не вдалося змінити налаштування: %1 завершилася з помилкою."

#: rust/rexon-core/src/animations.rs
#: rust/rexon-core/src/appearance_installer.rs
msgid "Couldn't remove %1."
msgstr "Не вдалося вилучити %1."

#: rust/rexon-core/src/animations.rs
msgid "%1 is too old for this (version %2.%3 or newer is needed)."
msgstr "%1 надто старий для цього (потрібна версія %2.%3 або новіша)."

#: rust/rexon-core/src/animations.rs
msgid ""
"The %1 config was not found. Start %1 once so that it creates its config."
msgstr ""
"Конфігурацію %1 не знайдено. Запустіть %1 один раз, щоб він створив свою "
"конфігурацію."

#: rust/rexon-core/src/animations.rs
msgid "%1 rejected the change. Check the config: %2"
msgstr "%1 не прийняв правку. Перевірте конфігурацію: %2"

#: rust/rexon-core/src/animations.rs
msgid "%1 rejected the change; the config is restored as it was."
msgstr "%1 не прийняв правку — конфігурацію повернуто як було."

#
#: rust/rexon-core/src/animations.rs
msgid "this desktop"
msgstr "це середовище"

#: rust/rexon-core/src/animations.rs
msgid "Window open and close"
msgstr "Відкриття й закриття вікон"

#: rust/rexon-core/src/animations.rs
msgid "Opening windows"
msgstr "Відкриття вікон"

#: rust/rexon-core/src/animations.rs
msgid "Closing windows"
msgstr "Закриття вікон"

#
#: rust/rexon-core/src/animations.rs
msgid "Window maximize"
msgstr "Розгортання вікон"

#: rust/rexon-core/src/animations.rs
msgid "Resizing and tiling windows"
msgstr "Зміна розміру й прикріплення вікон"

#
#: rust/rexon-core/src/animations.rs
msgid "Window minimize"
msgstr "Згортання вікон"

#
#: rust/rexon-core/src/animations.rs
msgid "Window full screen"
msgstr "Перехід у повноекранний режим"

#
#: rust/rexon-core/src/animations.rs
msgid "Peek at desktop"
msgstr "Зазирнути на стільницю"

#: rust/rexon-core/src/animations.rs
msgid "Virtual desktop switching"
msgstr "Перемикання віртуальних стільниць"

#: rust/rexon-core/src/animations.rs
msgid "Fading popups"
msgstr "Розчинення спливних вікон"

#: rust/rexon-core/src/animations.rs
msgid "Sliding popups"
msgstr "Ковзання спливних вікон"

#
#: rust/rexon-core/src/animations.rs
msgid "Sliding notifications"
msgstr "Ковзання сповіщень"

#: rust/rexon-core/src/animations.rs
msgid "Login"
msgstr "Вхід до системи"

#: rust/rexon-core/src/animations.rs
msgid "Logout"
msgstr "Завершення сеансу"

#: rust/rexon-core/src/animations.rs
msgid "Effects on menus"
msgstr "Ефекти в меню"

#: rust/rexon-core/src/animations.rs
msgid "Effects on dialog boxes"
msgstr "Ефекти в діалогових вікнах"

#: rust/rexon-core/src/animations.rs
