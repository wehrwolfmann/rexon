msgstr "залежність %1 не знайдено ні в репозиторіях, ні в AUR"

#: rust/rexon-core/src/aur_install.rs
msgid "a dependency wasn't found in the repositories or the AUR"
msgstr "залежність не знайдено ні в репозиторіях, ні в AUR"

