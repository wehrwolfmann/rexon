msgstr ""
"la ruta de la carpeta temporal tiene espacios o caracteres especiales: %1"

#: rust/rexon-core/src/installer_exec.rs
msgid "the installation plan contains an unknown step"
msgstr "el plan de instalación contiene un paso desconocido"

#: rust/rexon-core/src/installer_exec.rs
msgid ""
"the administrator script finished successfully, but %1 or %2 was not found"
msgstr ""
"el script de administrador ha terminado correctamente, pero no se ha "
"encontrado %1 o %2"

#: rust/rexon-core/src/installer_exec.rs
msgid "the home folder is not known (HOME=%1)"
msgstr "no se conoce la carpeta personal (HOME=%1)"

#: rust/rexon-core/src/installer_exec.rs
msgid "%1 is a link to another folder; the installation won't replace it"
msgstr "%1 es un enlace a otra carpeta; la instalación no lo sustituirá"

#: rust/rexon-core/src/installer_exec.rs
msgid "%1 or %2 was not found after the installation"
msgstr "no se ha encontrado %1 o %2 después de la instalación"

#: rust/rexon-core/src/installer_exec.rs
msgid ""
"the Rexon window is missing from the package: %1 was not found next to it"
msgstr ""
"falta la ventana de Rexon en el paquete: no se ha encontrado %1 a su lado"

#: rust/rexon-core/src/installer_exec.rs
msgid "the removal plan contains an unknown step"
msgstr "el plan de desinstalación contiene un paso desconocido"

#: rust/rexon-core/src/kdecoration.rs rust/rexon-core/src/themes.rs
