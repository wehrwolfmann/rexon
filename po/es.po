msgstr "Script de compilación del paquete: qué se descargará y ejecutará"

#: rust/rexon-core/src/aur_trust.rs
msgid "PKGBUILD — %1"
msgstr "PKGBUILD: %1"

#: rust/rexon-core/src/aur_trust.rs
msgid "Loading PKGBUILD…"
msgstr "Cargando el PKGBUILD…"

#: rust/rexon-core/src/aur_trust.rs
msgid "⚠️ Signs of risk in packages from AUR (installation isn't blocked):"
msgstr ""
"⚠️ Señales de riesgo en paquetes de AUR (la instalación no está prohibida):"

