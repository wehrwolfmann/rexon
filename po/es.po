msgstr "rexon-splash-overlay ha devuelto el código %1"

#: rust/rexon-core/src/session_splash.rs
msgid "The hybrid didn't work (%1) — regular autostart is on instead"
msgstr "El híbrido ha fallado (%1): se ha activado el inicio automático normal"

#: rust/rexon-core/src/session_splash.rs
msgid "Couldn't create the theme folder: %1"
msgstr "No se ha podido crear el directorio del tema: %1"

#: rust/rexon-core/src/session_splash.rs
msgid "Couldn't write the theme: %1"
msgstr "No se ha podido escribir el tema: %1"

#: rust/rexon-core/src/session_splash.rs
msgid "ffmpeg isn't installed"
msgstr "ffmpeg no está instalado"

#: rust/rexon-core/src/session_splash.rs
msgid "ffmpeg: failed"
msgstr "ffmpeg: ha fallado"

#: rust/rexon-core/src/session_splash.rs
