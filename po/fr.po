#: rust/rexon-core/src/gamemode_guard.rs
msgid "Video card %1: connected screens: %2"
msgstr "Carte graphique %1 : écrans connectés : %2"

#. TRANSLATORS: game mode check result. %1 = "1002:15bf", %2 = "card1".
#: rust/rexon-core/src/gamemode_guard.rs
msgid ""
"Game mode will draw on the card with the screen: VULKAN_ADAPTER=%1 (%2)."
msgstr ""
"Le mode jeu dessinera sur la carte à laquelle l'écran est connecté : "
"VULKAN_ADAPTER=%1 (%2)."

#: rust/rexon-core/src/gamemode_guard.rs
msgid ""
"VULKAN_ADAPTER=%1 points to a card without a screen or to no card at all; "
"using %2 (%3) instead."
msgstr ""
"VULKAN_ADAPTER=%1 désigne une carte sans écran ou une carte qui n'existe "
"pas ; à la place : %2 (%3)."

#: rust/rexon-core/src/gamemode_guard.rs
msgid "One video card: nothing to choose."
msgstr "Une seule carte graphique — rien à choisir."

#: rust/rexon-core/src/gamemode_guard.rs
msgid "VULKAN_ADAPTER already points to the card with the screen."
msgstr "VULKAN_ADAPTER désigne déjà la carte avec l'écran."

#. TRANSLATORS: game mode check result. %1 = the VULKAN_ADAPTER value the user set.
#: rust/rexon-core/src/gamemode_guard.rs
msgid "VULKAN_ADAPTER=%1 is set by you; left as it is."
msgstr "VULKAN_ADAPTER=%1 a été défini par vous — laissé tel quel."

#. TRANSLATORS: game mode check result. %1 = "1002:15bf".
#: rust/rexon-core/src/gamemode_guard.rs
