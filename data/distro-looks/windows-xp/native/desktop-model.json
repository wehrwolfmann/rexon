{
  "schema": "rexon-desktop-model/1",
  "about": "Rexon's own description of a Windows XP style desktop for MATE, Xfce and Cinnamon: roles and values only, no code. From the community theme only the GTK, Metacity and xfwm4 parts are taken (copy_only): its Cinnamon, GNOME Shell and Unity parts are not copied. The icon set gets inherited themes that exist on every system.",
  "copy_only": [
    "sources/xp-theme/Windows XP Luna/index.theme",
    "sources/xp-theme/Windows XP Luna/gtk-2.0",
    "sources/xp-theme/Windows XP Luna/gtk-3.0",
    "sources/xp-theme/Windows XP Luna/gtk-3.20",
    "sources/xp-theme/Windows XP Luna/gtk-4.0",
    "sources/xp-theme/Windows XP Luna/metacity-1",
    "sources/xp-theme/Windows XP Luna/xfwm4"
  ],
  "exclude": [
    "sources/Windows-XP/icon-theme.cache"
  ],
  "edits": [
    {"file": "sources/Windows-XP/index.theme", "ini_set": {"group": ["Icon Theme"], "key": "Inherits", "value": "Adwaita,hicolor"}}
  ],
  "panels": [
    {
      "edge": "bottom",
      "size": 30,
      "expand": true,
      "items": [
        {"role": "menu", "prefer": "mate-menu",
         "label": {"en": "Start", "ru": "Пуск", "de": "Start", "zh_CN": "开始", "fr": "Démarrer", "es": "Inicio", "uk": "Пуск"}},
        {"role": "show-desktop"},
        {"role": "windows"},
        {"role": "tray", "align": "end"},
        {"role": "clock", "align": "end"}
      ]
    }
  ],
  "behaviour": {
    "window_buttons": ":minimize,maximize,close"
  }
}
