+    // REXON EDIT (a defect fix, not a feature): Rexon itself installs
+    // the Plasma wallpaper plugin and assigns it on «Apply», so instead of
+    // «install the extension from GitHub/KDE Store and select it in the desktop
+    // settings» we show what to actually do. On X11 outside KDE (MATE,
+    // XFCE, Cinnamon X11) the output is brought up by the Rexon host — there the hint
+    // is shown with any daemon backend, otherwise under «No monitors
+    // registered» it was empty. The text comes from the Rexon core
+    // (`W.App.noDisplaysHint`); empty — the upstream look. The edit lives in
+    // patches/0010-apply-without-displays-on-kde.patch.
+    readonly property string rexonHint: W.App.noDisplaysHint
+
     spacing: 12
-    visible: W.Notify.displayBackend.name === "kde-plasma"
+    visible: W.Notify.displayBackend.name === "kde-plasma" || root.rexonHint.length > 0
 
     MD.Text {
         Layout.fillWidth: true
-        text: qsTr("KDE Plasma needs the <b>waywallen-display</b> wallpaper extension to bridge wallpapers to the desktop. Install it from either source:")
+        text: root.rexonHint.length > 0 ? root.rexonHint : qsTr("KDE Plasma needs the <b>waywallen-display</b> wallpaper extension to bridge wallpapers to the desktop. Install it from either source:")
         textFormat: Text.StyledText
         wrapMode: Text.WordWrap
         horizontalAlignment: Text.AlignHCenter
@@ -26,6 +34,7 @@ ColumnLayout {
     RowLayout {
         Layout.alignment: Qt.AlignHCenter
         spacing: 8
+        visible: root.rexonHint.length === 0
 
         MD.Button {
             text: qsTr("GitHub")
@@ -45,6 +54,7 @@ ColumnLayout {
 
     MD.Text {
         Layout.fillWidth: true
+        visible: root.rexonHint.length === 0
         text: qsTr("Then right-click the desktop → <b>Configure Desktop and Wallpaper…</b> and pick the <b>Waywallen</b> wallpaper plugin.")
         textFormat: Text.StyledText
         wrapMode: Text.WordWrap
