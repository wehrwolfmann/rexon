	optdepends = yt-dlp: YouTube wallpapers
	optdepends = yay: install AUR themes from the Appearance tab
	optdepends = xdg-terminal-exec: correct default terminal for GLib launches
	optdepends = kvantum: apply Kvantum themes
	optdepends = vulkan-driver: Flash wallpapers
	optdepends = 7zip: extract .7z/.rar cursor archives that bsdtar cannot open
	optdepends = unrar: extract RAR cursor archives that bsdtar and 7zip cannot open
	optdepends = kwin: KDE window decoration preview
	optdepends = plasma-wallpaper-waywallen: live wallpapers on Plasma (Rexon installs it on KDE)
	optdepends = waywallen-display: Wallpaper Engine scenes on X11 desktops without Plasma
