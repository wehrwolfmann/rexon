pkgbase = rexon-git
	pkgdesc = Universal desktop environment manager for Linux: install/switch DE, themes, live wallpapers (git version)
	pkgver = 0.1.1.r2100.g0000000
	pkgrel = 1
	url = https://github.com/wehrwolfmann/rexon
	install = rexon-git.install
	arch = x86_64
	license = Apache-2.0
	license = MPL-2.0
	license = MIT
	license = BSD-3-Clause
	checkdepends = desktop-file-utils
	checkdepends = appstream
	makedepends = git
	makedepends = glib2
	makedepends = rust
	makedepends = cmake
	makedepends = ninja
	makedepends = protobuf
	makedepends = qt6-shadertools
	makedepends = lito>=0.8.7
	makedepends = clang
	makedepends = lld
	makedepends = llvm
	makedepends = glslang
	makedepends = vulkan-headers
	makedepends = libpulse
	makedepends = java-runtime-headless
	makedepends = gettext
	depends = glibc
	depends = libgcc
	depends = libstdc++
	depends = bash
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-translations
	depends = qt6-svg
	depends = qt6-imageformats
	depends = qt6-webengine
	depends = qt6-multimedia
	depends = qt6-websockets
	depends = layer-shell-qt
	depends = vulkan-icd-loader
	depends = alsa-lib
	depends = mpv
	depends = wayland
	depends = libglvnd
	depends = dbus
	depends = openssl
	depends = polkit
	depends = pacman-contrib
	depends = qt6ct
	depends = hicolor-icon-theme
	depends = noto-fonts-emoji
	depends = noto-fonts
	depends = qt6-grpc
	depends = libarchive
	depends = xorg-server-xvfb
	depends = ffmpeg
	depends = libva
	depends = curl
	depends = waywallen>=0.6.1
	depends = open-wallpaper-engine>=0.3.4
	optdepends = yt-dlp: YouTube wallpapers (streamed video as wallpaper)
	optdepends = yay: install AUR themes from the Appearance tab (AeroThemePlasma etc.)
	optdepends = xdg-terminal-exec: correct default terminal for GLib launches (AUR)
	optdepends = kvantum: apply Kvantum themes (Qt style engine)
	optdepends = vulkan-driver: Flash wallpapers (any GPU Vulkan driver: vulkan-radeon, vulkan-intel, nvidia-utils)
	optdepends = 7zip: fallback extraction of .7z/.rar cursor archives that bsdtar cannot open
	optdepends = unrar: fallback extraction of RAR cursor archives that bsdtar and 7zip cannot open
	optdepends = kwin: KDE window decoration preview (QML module org.kde.kwin.private.kdecoration)
	optdepends = plasma-wallpaper-waywallen: live waywallen wallpapers on the Plasma desktop (AUR; Rexon installs it on KDE by itself)
	optdepends = waywallen-display: Wallpaper Engine scenes on X11 desktops without Plasma (XFCE, MATE, Cinnamon on X11)
	provides = rexon
	conflicts = rexon
