# Maintainer: Alexander Berg (Wehrwolfmann) <256216494+wehrwolfmann@users.noreply.github.com>

pkgname=rexon-git
pkgver=0.1.1.r2100.g0000000
pkgrel=1
pkgdesc="Universal desktop environment manager for Linux: install/switch DE, themes, live wallpapers (git version)"
arch=('x86_64')
url="https://github.com/wehrwolfmann/rexon"
license=('Apache-2.0' 'MPL-2.0' 'MIT' 'BSD-3-Clause' 'OFL-1.1')
# Lowest engine versions the vendored protocol and plugin contract were checked against.
_ww_min=0.6.3
_owe_min=0.3.4
depends=(
  glibc libgcc libstdc++ bash
  qt6-base qt6-declarative qt6-translations qt6-svg qt6-imageformats
  qt6-webengine qt6-multimedia qt6-websockets qt6-grpc layer-shell-qt qt6ct
  vulkan-icd-loader alsa-lib mpv wayland libglvnd dbus openssl polkit
  pacman-contrib hicolor-icon-theme noto-fonts noto-fonts-emoji
  libarchive xorg-server-xvfb ffmpeg libva curl
  "waywallen>=$_ww_min"
  "open-wallpaper-engine>=$_owe_min"
)
makedepends=(git glib2 rust cmake ninja protobuf qt6-shadertools
             'lito>=0.8.11' clang lld llvm glslang vulkan-headers libpulse
             java-runtime-headless gettext)
checkdepends=(desktop-file-utils appstream)
optdepends=(
  'yt-dlp: YouTube wallpapers'
  'yay: install AUR themes from the Appearance tab'
  'xdg-terminal-exec: correct default terminal for GLib launches'
  'kvantum: apply Kvantum themes'
  'vulkan-driver: Flash wallpapers'
  '7zip: extract .7z/.rar cursor archives that bsdtar cannot open'
  'unrar: extract RAR cursor archives that bsdtar and 7zip cannot open'
  'kwin: KDE window decoration preview'
  'plasma-wallpaper-waywallen: live wallpapers on Plasma (Rexon installs it on KDE)'
  'waywallen-display: Wallpaper Engine scenes on X11 desktops without Plasma'
)
provides=(rexon)
conflicts=(rexon)
# cxx-qt builds its C++ with makepkg's CFLAGS; with LTO the static libraries
# hold only GIMPLE and rustc cannot link them. Rust LTO is set in Cargo.toml.
options=('!lto')
install=rexon-git.install

# Pinned next to the vendored QML: data/qt_wallpaper_engine/qml_ui/waywallen/ui/QML_MATERIAL_PIN
_qm_pin=712fb288660c470e7883b590569f5ec06f25a24c
# The repository stores these fonts as git-lfs pointers.
_qm_fonts=(MaterialSymbolsRounded.wght_400.opsz_24.fill_0.ttf
           MaterialSymbolsRounded.wght_400.opsz_24.fill_0.woff2
           MaterialSymbolsRounded.wght_400.opsz_24.fill_1.ttf
           MaterialSymbolsRounded.wght_400.opsz_24.fill_1.woff2
           MaterialSymbolsRounded.wght_400.opsz_24.woff2)
# Firefox en→ru translation model (MPL-2.0), shipped so translation works offline.
_mt_tag=AYqN3ysXRp2EGkEqeaA5Rg
_mt_url="https://storage.googleapis.com/moz-fx-translations-data--303e-prod-translations-data/models/en-ru/student_base_${_mt_tag}/exported"

# REXON_GITURL: build from a local clone, e.g. git+file:///path/to/rexon
source=("rexon::${REXON_GITURL:-git+https://github.com/wehrwolfmann/rexon.git}"
        "QmlMaterial::git+https://github.com/hypengw/QmlMaterial.git#commit=${_qm_pin}"
        "${_mt_tag:0:8}-model.enru.intgemm.alphas.bin.gz::${_mt_url}/model.enru.intgemm.alphas.bin.gz"
        "${_mt_tag:0:8}-vocab.enru.spm.gz::${_mt_url}/vocab.enru.spm.gz")
for _f in "${_qm_fonts[@]}"; do
  source+=("${_qm_pin:0:12}-${_f}::https://media.githubusercontent.com/media/hypengw/QmlMaterial/${_qm_pin}/assets/${_f}")
done
unset _f
sha256sums=('SKIP'
            'SKIP'
            '3c6e3ffd275c96a220ae28ddb55b8c2b86b44ffecc1eeb6c8195c1536de4ac74'
            '07ed9055319f2adc50a16bc7e636fe1547ab745eb986e40b6384956dc1fc6cfd'
            '143e9b3d74c73e856478680149d51015e9cb37263510c6fce9e8c840166fb755'
            '78edd47b5b770f4c14bafda458214c2ea07bbaf2add54919dbcfcfaf5d2729e5'
            '7ad2da5886792f7169fa73728e86bf1dc165afd88aa2741d27a4112051b64c72'
            '72d77058be3c7f5b1a729ac3470daae79efea6a47a04b3a3fd11a76a0d410f62'
            '22663f2633246da809ba5e3b08161e774117135500c22664a17352c10eb1db34')

pkgver() {
  cd rexon
  printf '%s.r%s.g%s' "$(grep -m1 -oP '^version = "\K[^"]+' rust/Cargo.toml)" \
    "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd rexon/rust
  cargo fetch --locked --target "$(rustc --print host-tuple)"
  ../scripts/package-build prepare "$srcdir"
}

build() {
  rexon/scripts/package-build build "$srcdir"
}

check() {
  rexon/scripts/package-build check "$srcdir"
}

package() {
  rexon/scripts/package-build install "$srcdir" "$pkgdir" "$pkgname"
}
