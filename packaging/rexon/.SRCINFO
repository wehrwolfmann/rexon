pkgbase = rexon
	pkgdesc = Universal desktop environment manager for Linux: install/switch DE, themes, live wallpapers
	pkgver = 0.1.1
	pkgrel = 3
	url = https://github.com/wehrwolfmann/rexon
	install = rexon.install
	arch = x86_64
	license = Apache-2.0
	license = MPL-2.0
	license = MIT
	license = BSD-3-Clause
	license = GPL-2.0-or-later
	license = GPL-2.0-only
	checkdepends = desktop-file-utils
	checkdepends = appstream
	makedepends = git
	makedepends = glib2
	makedepends = rust
	makedepends = cmake
