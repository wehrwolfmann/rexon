# Maintainer: Wehrwolfmann <256216494+wehrwolfmann@users.noreply.github.com>
#
# Rexon — универсальный менеджер рабочих столов для Linux.
# Лицензия: Apache-2.0, включая формат .rxn (см. LICENSE и NOTICE в корне
# репозитория → /usr/share/licenses/rexon/).
#
# Пакет выпуска: собирается из подписанной метки v${pkgver} публичного
#   репозитория (_giturl ниже). Свежий код из ветки — пакет rexon-git
#   (packaging/aur/PKGBUILD).

pkgname=rexon
pkgver=0.1.1
pkgrel=1
pkgdesc="Universal desktop environment manager for Linux: install/switch DE, themes, live wallpapers"
url="https://github.com/wehrwolfmann/rexon"
# Пакет вёз один Python (arch=any); теперь в нём собранные бинари:
# Rust-окно, хост обоев, заставка входа и привилегированные помощники.
# Интерпретатора в пакете нет вовсе — вход /usr/bin/rexon ведёт на Rust-окно.
arch=('x86_64')
# Вариант сборки движка обоев. По умолчанию (0) движок — отдельные пакеты
# дистрибутива waywallen и open-wallpaper-engine (так собирается пакет AUR
# и CachyOS, и только этот вариант описан в .SRCINFO). 1 — движок ВШИТ:
# AppImage waywallen, плагин OWE и архив его GPL-исходников едут в самом
# пакете, в /usr/lib/rexon/engine — для поставки Steam, ручной установки и
# машин без пакетов движка. Включается из окружения:
#   REXON_BUNDLED_ENGINE=1 makepkg
# Подробности — блок «Движок обоев» после options и README.md.
case "${REXON_BUNDLED_ENGINE:-0}" in
  1) _bundled_engine=1 ;;
  0) _bundled_engine=0 ;;
  *) echo "ERROR: REXON_BUNDLED_ENGINE=${REXON_BUNDLED_ENGINE} — допустимо 0 или 1" >&2
     _bundled_engine=invalid ;;   # prepare() остановит сборку
esac
# Нижние границы пакетов движка обоев (depends ниже); почему именно они —
# блок «Движок обоев» после options.
_ww_min=0.5.0
_owe_min=0.3.2
# Своё — Apache-2.0 (LICENSE + NOTICE), но в пакете едет и чужое: движок автоперевода
# (fxtranslate, MPL-2.0) с вкомпилированными gemmology (MIT) и xsimd
# (BSD-3-Clause), файлы модели Mozilla (MPL-2.0) и Plasma-плагин обоев
# org.waywallen.kde (официальный архив выпуска без изменений). Лицензия
# плазмоида у апстрима записана двояко: extensions/kde/LICENSE — MIT, а
# metadata.json — GPL-2.0-or-later; вопрос задан автору
# (waywallen/waywallen-display#70), до ответа в поле стоят обе и ставятся
# оба текста. Вложенная в него libwaywallen-display-qml.so — MIT (сборка их
# библиотеки waywallen-display, линкуется только с Qt6).
# QML-плагин QExtra (собирается из исходников автора без изменений) и
# статически вошедшие в него wavsen, ncrequest, rstd, vvk, lihttpto — MIT
# (у всех, кроме ncrequest, на выбор «MIT OR Apache-2.0»; берём MIT).
# Поле обязано перечислять лицензии ВСЕГО, что лежит в пакете, иначе оно
# врёт покупателю и сопровождающим; тексты всех ставятся в
# /usr/share/licenses.
#
# Движок обоев по умолчанию в пакете НЕ лежит (с 30.10.2026): демон
# waywallen и плагин Open Wallpaper Engine — отдельные пакеты дистрибутива,
# ниже в depends. Их файлы, лицензии и исходники — забота их пакетов; с кодом
# Rexon они не линкуются (демон — отдельный процесс, Rexon говорит с ним по
# D-Bus и WebSocket, рисовальщики OWE запускает сам демон).
# Вариант с вшитым движком (REXON_BUNDLED_ENGINE=1) везёт их сам: AppImage
# waywallen (MIT; внутри — чужие библиотеки со своими лицензиями, см.
# NOTICE) и плагин OWE — GPL-2.0-only, с полным исходником того же тега в
# /usr/share/rexon/sources (GPL-2 §3(a)); внутри плагина — CEF
# (BSD-3-Clause, уведомление отдельным файлом). GPL-код и тут за границей
# процесса — «простое объединение» (GPL-2 §2).
license=('Apache-2.0' 'MPL-2.0' 'MIT' 'BSD-3-Clause'
         'GPL-2.0-or-later')
if [[ $_bundled_engine == 1 ]]; then license+=('GPL-2.0-only'); fi
depends=(
  glibc
  gcc-libs
  bash                 # помощники polkit — bash-скрипты, и лаунчер /usr/bin/rexon
  qt6-base             # Core/Gui/Widgets/DBus/Network/WaylandClient
  qt6-declarative      # QML / QtQuick / Controls / Layouts
  qt6-webengine        # web-обои: rexon-wallpaper-host --mode web (dlopen + QML-импорт)
  qt6-multimedia       # звук scene-обоев: QML-импорт QtMultimedia
  qt6-websockets       # вкладка Wallpaper Engine (QtWebSockets)
  layer-shell-qt       # wlr-layer-shell BACKGROUND под Wayland
  vulkan-icd-loader    # Flash-обои: rexon-wallpaper-host --mode swf рисует через Vulkan (wgpu)
  alsa-lib             # звук Flash-обоев: cpal ходит в libasound (PipeWire отдаёт его своим плагином)
  mpv                  # rexon-splash-overlay линкуется с libmpv (заставка входа)
  wayland
  libglvnd             # EGL заставки входа
  dbus
  openssl
  polkit               # pkexec + named-действия org.rexon.* (пароль реже: auth_admin_keep)
  pacman-contrib       # checkupdates: что придёт с обновлением — без прав и не трогая
                       # базу системы; на нём предупреждение «обновление поставит
                       # набор пакетов вразнобой» (update_guard) и AeroThemePlasma
  qt6ct                # выбор стиля Qt вне KDE и LXQt (темы Kvantum:
                       # стиль, шрифты и значки Qt-программ). 180 КиБ,
                       # тянет только qt6-base/qt6-svg — они уже здесь
  hicolor-icon-theme
  noto-fonts-emoji     # значки вкладок, категорий и кнопок — эмодзи в тексте;
                       # без цветного шрифта эмодзи на чистой системе квадраты
                       # (проверка в контейнере с GNOME 51.1, 16.10.2026)
  qt6-grpc             # waywallen.control: Qt Protobuf + ProtobufQuick
  libarchive           # bsdtar: распаковка .rar/.7z при импорте курсоров Windows
                       # (`importers::extract_other_archive`); на Arch уже есть у pacman
  xorg-server-xvfb     # невидимый X-сервер: снимки виджетов Conky для плиток без
                       # показа на экране, и в Wayland (`conky_preview`); без него —
                       # заглушка. На SteamOS — тот же пакет внутри sysext Rexon
  # QML-плагин QExtra (картинки и анимации вкладки обоев).
  # ⚠️Со сменой старшей версии ffmpeg в дистрибутиве пакет пересобирается:
  # в плагине записаны libavcodec.so.N и соседи.
  ffmpeg               # декодер кадров: libavcodec/avformat/avutil/swscale
  # С LDFLAGS makepkg (--as-needed) эти две в NEEDED плагина не попадают —
  # из них нужны только заголовки на сборке; без --as-needed плагин
  # линкуется и с ними (libva.so.2, libva-drm.so.2, libcurl.so.4).
  libva
  curl
)
if [[ $_bundled_engine == 1 ]]; then
  # Движок из комплекта. Пакетов движка не требуем и с ними не конфликтуем:
  # файлы комплекта лежат в своих каталогах (/usr/lib/rexon/engine,
  # /usr/share/rexon/sources), а стоят оба — ядро берёт системный.
  depends+=(
    fuse3                # рантайм AppImage (type2-runtime) монтирует образ
                         # через fusermount из PATH
    at-spi2-core         # плагин OWE: libcef.so веб-рендерера линкуется с
                         # libatk/libatspi (namcap: E: Dependency at-spi2-core)
  )
else
  # Движок обоев — отдельными пакетами. Нижние границы — версии, под которые
  # сверены вендорный интерфейс и протокол (см. блок «Движок обоев» ниже):
  # демон старше 0.5.0 не знает полей control.proto, которые шлёт ядро.
  depends+=(
    "waywallen>=${_ww_min}"                 # демон /usr/bin/waywallen
    "open-wallpaper-engine>=${_owe_min}"    # scene- и web-обои Wallpaper Engine
  )
fi
makedepends=(git glib2 rust
             cmake ninja protobuf qt6-shadertools
             # QML-плагин QExtra собирает сборщик lito (C++23 с модулями —
             # только clang, связывает lld). В официальных репозиториях lito
             # нет: пакет из AUR, `lito` (из исходников) или `lito-bin`
             # (готовая сборка автора, provides=lito). Младше 0.8.7 не годится —
             # манифест wavsen 7564374 (QExtra b3fd790, waywallen 0.5.0) несёт
             # поле `condition` у зависимости, которое 0.8.5 не разбирает;
             # tools/build_qml_qextra.sh такой lito отвергает сам. Другой бинарь
             # подаётся переменной LITO.
             'lito>=0.8.7' clang lld llvm
             glslang vulkan-headers libpulse   # wavsen внутри QExtra
             alsa-lib    # заголовки libasound для cpal (звук Flash-обоев)
             # Flash-обои: build.rs крейта ruffle_core собирает встроенные
             # классы ActionScript 3 (playerglobal) компилятором на Java и
             # без `java` в PATH падает: «Java could not be found on your
             # computer». Нужна только на сборке, в пакет Java не едет.
             java-runtime-headless
             gettext)    # msgfmt: po/*.po → .mo переводов интерфейса (build.rs
                         # rexon-gui); его же читает QML — отдельного .qm нет
checkdepends=(desktop-file-utils appstream)
optdepends=(
  'yt-dlp: YouTube-обои (потоковое видео как обои)'
  'yay: установка AUR-тем из вкладки «Оформление» (AeroThemePlasma и т.п.)'
  'xdg-terminal-exec: корректный терминал по умолчанию для GLib-запусков (AUR)'
  'kvantum: применение тем Kvantum (движок стилей Qt)'
  'vulkan-driver: Flash-обои (любой Vulkan-драйвер видеокарты: vulkan-radeon, vulkan-intel, nvidia-utils)'
  '7zip: запасная распаковка архивов курсоров .7z/.rar, которые не берёт bsdtar'
  'unrar: запасная распаковка RAR-архивов курсоров, которые не открыли bsdtar и 7zip'
)

conflicts=(rexon-git)
# C++-части cxx-qt собираются через cc с CFLAGS makepkg: без !lto в
# статических библиотеках остаётся только GIMPLE, и rustc их не слинкует.
#
# !strip: .so плазмоида org.waywallen.kde обязан ехать бит в бит как в
# выпуске (по его хэшу ядро узнаёт версию, KNOWN_RUNTIME_SHA), а исключить
# один путь makepkg не умеет — свои бинари package() стрипует сам
# (_strip_own_binaries). ⛔ С вшитым движком !strip ещё и спасает AppImage:
# strip видит в нём обычный ELF и отрезает приклеенный squashfs (78 МиБ →
# <1 МиБ, движок мёртв). !debug — следом: отладочный пакет makepkg собирает
# только вместе со strip.
options=('!lto' '!strip' '!debug')
# post_remove: снять страховку экрана входа из /etc (см. сам файл).
install=rexon.install

# ── Движок обоев: отдельные пакеты дистрибутива ─────────────────────
# С 30.10.2026 пакет по умолчанию НЕ вшивает движок (AppImage waywallen со
# статически вшитыми чужими библиотеками, плагин OWE с CEF и архив его
# GPL-исходников внутри пакета Rexon) — он зависит от пакетов `waywallen` и
# `open-wallpaper-engine`, которые обновляет пакетный менеджер. Прежний
# рецепт остался вариантом REXON_BUNDLED_ENGINE=1 (блок «Вшитый движок»
# ниже). Куда они ставят файлы и как ядро их находит — `we_client::SYSTEM_DAEMON` и
# `we_client::SYSTEM_ENGINE_DIR` (демон из /usr/bin сам видит
# /usr/share/waywallen/plugins, флаг --plugin ему не нужен).
#
# Нижние границы версий — не формальность, они привязаны к вендорным кускам
# дерева:
#   * _ww_min — тег, с которого сняты протокол control plane
#     (data/qt_wallpaper_engine/proto/UPSTREAM_TAG) и вендорный интерфейс
#     вкладки; prepare() падает, если они разошлись. С демоном старше ядро
#     говорило бы полями, которых тот не знает;
#   * _owe_min — плагин, сверенный с демоном _ww_min: entry_version 4,
#     spawn_version 10 (договор плагинов SUPPORTED_ENTRY_VERSIONS = [3, 4],
#     SPAWN_VERSION = 10, мост — протокол 3; сверка по git diff тегов
#     30.10.2026).
# Верхних границ нет намеренно: договор плагинов и control.proto у апстрима
# растут добавлениями, а потолок в depends остановил бы обновление системы
# целиком. Что демон новее проверенного — видно в Rexon: бейдж сверки
# протокола (`we_parity`) и таблица протоколов вывода плазмоида
# (`waywallen_kde_plugin::DAEMON_PROTOCOLS_CHECKED_UP_TO`) — вне таблицы
# плазмоид не ставится поверх более нового и не угадывает совместимость.
#
# Плазмоид org.waywallen.kde едет здесь же, а не зависимостью
# `plasma-wallpaper-waywallen`: тот тянет libplasma, kirigami и
# plasma-workspace, то есть Plasma целиком на любой рабочий стол, а Rexon
# ставит плазмоид только на KDE и только человеку (kpackagetool6 в
# ~/.local/share). Демон и плазмоид обновляются ТОЛЬКО вместе: 0.4.x —
# протокол вывода v9; плазмоид 0.4.3 (waywallen-display, сверка 23.10.2026)
# демону 0.5.0 подходит.
# ⚠️В базе демона миграции только вперёд: демон, хоть раз запущенный новее,
# оставляет базу, на которой старший не стартует — откат движка только с
# базой.
# (_ww_min и _owe_min заданы выше depends: bash раскрывает массив сразу.)
# Plasma-плагин обоев org.waywallen.kde — официальный архив выпуска
# waywallen-display, ставится БЕЗ ИЗМЕНЕНИЙ (наших правок поверх нет). Версия
# и сумма записаны ещё в data/kpackage/org.waywallen.kde/vendor.toml;
# `vendor-check` краснеет, если они здесь и там разойдутся или сумма не
# совпадёт с digest выпуска на GitHub.
_wwd_ver=0.4.3
_wwd_zip="waywallen-kde-${_wwd_ver}-x86_64-embed.zip"

# ── Вшитый движок (REXON_BUNDLED_ENGINE=1) ───────────────────────────
# Рецепт прежней поставки (28.09–30.10.2026), оставлен вариантом: Steam,
# ручная установка, машина без пакетов waywallen и open-wallpaper-engine.
# Каталог — `we_client::ENGINE_DIR` ядра: AppImage демона и рядом
# plugins/<id>/; демону он передаётся флагом --plugin, и плагины демон ищет
# в <каталог>/plugins/ (сверка app_parity.rs). Ядро берёт эту раскладку,
# только если системного движка нет (`we_client::engine_layouts`).
# Версии прибиты: демон и плазмоид org.waywallen.kde обновляются ТОЛЬКО
# вместе, а плагин OWE обязан подходить демону (entry_version 4,
# spawn_version 10 — сверка по git diff тегов, см. блок выше). AppImage —
# ровно тот тег, с которого сняты протокол и вендорный интерфейс
# (_ww_ver = proto/UPSTREAM_TAG, prepare() сверяет), плагин — не младше
# _owe_min. Меняя одну из версий, сверять две другие.
_ww_ver=0.5.0
_ww_appimage="waywallen-${_ww_ver}-x86_64.AppImage"
_owe_ver=0.3.2
_owe_commit=dd07afa79d3e8c34daa61391cc641954d3d01fe0   # тег v0.3.2
_owe_id=org.waywallen.open-wallpaper-engine
_owe_zip="${_owe_id}-${_owe_ver}-linux-x86_64.zip"

# Полный исходник OWE (GPL-2.0-only §3(a)). Подмодулей git у тега нет, но
# сборка тянет зависимости своим сборщиком lito: их список, ревизии и
# суммы — lito.lock тега, выгруженный `lito lock export --format
# flatpak-sources`. Всё, что компилируется в бинари плагина, едет в архиве
# исходников: git-зависимости по коммиту и пакеты реестра lito по сумме из
# lito.lock. Раскладка внутри архива — та же, что у переносимого набора
# исходников lito (.lito/source-bundle/v1/).
# git: имя|адрес|коммит|каталог набора lito
_owe_git=(
  'glslang|https://github.com/KhronosGroup/glslang.git|275822a6261ee689aadb1da5f09a0ec2f058685c|c395e2aaa9cb8d8fb93b07b4c4d577edfa6e698ecff8b9495da8e176be545138'
  'wavsen|https://github.com/hypengw/wavsen.git|756437443d84905a027f115c75ec6ae6b19692e7|ae428a7b7cbbfb5d3e52828e69bd383980b4062df55286ee89687319a05eccb9'
  'quickjs|https://github.com/quickjs-ng/quickjs.git|3c051980ab7e783dfbfb1c70c014ce5e05ecf24c|331b9bd81fcec183b71723ba4f8b3c47ed128fe90f9e2095beff407999fe4283'
  'vectext|https://github.com/vecren/vectext.git|d918972da5c08b5afc73b812062e855fce2d847d|58b71a442d23e9c30c7ad7e559f8235bf4041fd325ca85c431b49aae79adea5a'
  'vrento|https://github.com/vecren/vrento.git|5cc289e6511d86cf6207a4677b22da88a3592505|1e02a493890947348849132f7d6d9766059f7eeee5fac408f5a5aac8bc7c74b6'
  'eigen|https://chromium.googlesource.com/external/gitlab.com/libeigen/eigen.git|bc3b39870ecb690a623a3f49149a358b95c5781d|b8200cc545ec10dd9086947f174b97b20d038960af0922e188a78f5b750992ef'
)
