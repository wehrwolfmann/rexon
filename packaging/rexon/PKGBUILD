# CEF (BSD-3-Clause) is Spotify's prebuilt distribution; the plugin ships its
# libcef.so as a binary. Only the libcef_dll_wrapper is statically linked
# into the web renderer binary — its sources (include/, libcef_dll/, cmake/)
# are taken from this archive into the source archive; the binary part
# (Release/, Resources/, 300 MB) is not: it is not GPL code, and it is
# already in the package as is.
_cef_archive='cef_binary_149.0.4+g2f1bfd8+chromium-149.0.7827.156_linux64_minimal.tar.bz2'
_cef_url="https://cef-builds.spotifycdn.com/${_cef_archive//+/%2B}"
_cef_sha=6d43607675e47ed6bfa40d1cfce136d04e7720529f8f1c4435d4ba1dcd1839b2

# The Qcm.Material QML plugin (QmlMaterial, MIT, hypengw) styles the vendored
# pages of the Wallpaper Engine tab. Its revision SHIPS TOGETHER WITH THE
# VENDOR CODE: scripts/sync-waywallen-qml.py writes the pin to
# data/qt_wallpaper_engine/qml_ui/waywallen/ui/QML_MATERIAL_PIN, and
# prepare() below fails if the copy here lags behind it (once they diverge,
# they produce the nastiest class of defects: the vendored QML is new, the
# library is old).
_qm_pin=9b942c175e89711de1a66467e6a7b35e976f2188

# The QExtra QML plugin (hypengw/QExtra, MIT OR Apache-2.0) — the real
# QE.AnimatedImage and QE.ImageCache of the wallpaper tab. Built from source
# by the tools/build_qml_qextra.sh script through our tools/qextra_plugin/
# wrapper. Revisions and checksums are exactly those in
# tools/qextra_plugin/lito.lock (a slice of the lito.lock of the waywallen
# release the vendored markup came with); prepare() fails if the lists below
# lag behind it. The build runs offline: build() puts these sources into a
# lito source set (.lito/source-bundle/v1/, the layout is named by
# `lito lock export` itself).
# git: name|url|commit
_qe_git=(
  'QExtra|https://github.com/hypengw/QExtra.git|1ce54ee77fda9679e2bedfb55d9addefb26aa114'
  'wavsen|https://github.com/hypengw/wavsen.git|fe27f752e29a94565b6a33083d90df9a020ee76f'
)
