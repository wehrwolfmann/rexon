# Источники вшитого движка — в хвост массивов, чтобы порядок и суммы
# варианта по умолчанию (и .SRCINFO) не менялись.
if [[ $_bundled_engine == 1 ]]; then
  source+=("${_ww_appimage}::https://github.com/waywallen/waywallen/releases/download/v${_ww_ver}/${_ww_appimage}"
           "waywallen-${_ww_ver}-LICENSE::https://raw.githubusercontent.com/waywallen/waywallen/v${_ww_ver}/LICENSE"
           "${_owe_zip}::https://github.com/waywallen/open-wallpaper-engine/releases/download/v${_owe_ver}/${_owe_zip}"
           "open-wallpaper-engine::git+https://github.com/waywallen/open-wallpaper-engine.git#commit=${_owe_commit}"
           "${_cef_archive}::${_cef_url}")
  sha256sums+=('e6216c5fffc7056122b105e5745950c9ee77710e294a63b687c4b3871e190083'  # AppImage (= digest выпуска GitHub)
               '2d1edaf74e77c63e166ed948c2fee17a50dd15f73d8e9db249117e5fde8bef24'  # MIT waywallen
               '282c97fc67857420135c25faca95eae40ea6a50169adc2671b008622ef126ad0'  # плагин OWE (= digest выпуска)
               'SKIP'                                                              # git OWE — прибит коммитом
               "$_cef_sha")
  noextract+=("${_owe_zip}"          # распаковывает prepare(): в свой каталог
              "${_cef_archive}")     # из 300 МБ нужны только исходники обёртки
  for _e in "${_owe_git[@]}"; do
    IFS='|' read -r _n _u _c _ <<<"$_e"
    source+=("owe-dep-${_n}::git+${_u}#commit=${_c}")
    sha256sums+=('SKIP')            # прибиты коммитами
  done
  # Архив реестра, который уже едет источником ради QExtra (то же имя и та
  # же сумма), второй раз не называется: makepkg не принимает два источника
  # с одним именем файла.
  for _e in "${_owe_reg[@]}"; do
    [[ " ${_qe_reg[*]} " == *" ${_e} "* ]] && continue
    IFS='|' read -r _n _v _s <<<"$_e"
    source+=("lito-${_n}-${_v}.tar.zst::https://registry.litocpp.org/packages/${_n}/${_n}-${_v}.tar.zst")
    sha256sums+=("$_s")
    noextract+=("lito-${_n}-${_v}.tar.zst")   # едут в архив исходников как есть
  done
fi
unset _e _n _u _c _v _s


prepare() {
  if [[ $_bundled_engine != [01] ]]; then
    echo "ERROR: REXON_BUNDLED_ENGINE=${REXON_BUNDLED_ENGINE} — допустимо 0 (движок из пакетов системы) или 1 (вшитый)" >&2
    return 1
  fi
  # Пакетный режим ядро узнаёт двумя способами: REXON_PACKAGED от лаунчера
  # /usr/bin/rexon (installer::detect_default_mode) и место своего файла под
  # /usr — по нему мастер первого запуска молчит и у ярлыка, который зовёт
  # бинарь окна напрямую (installer::packaged_location).
  # Пин Qcm.Material обязан совпадать с выписанным рядом с вендором.
  local pinfile="$srcdir/rexon/data/qt_wallpaper_engine/qml_ui/waywallen/ui/QML_MATERIAL_PIN"
  local want
  want=$(tr -d '[:space:]' < "$pinfile")
  if [[ "$want" != "$_qm_pin" ]]; then
    echo "ERROR: _qm_pin=$_qm_pin отстал от вендора ($want) — обновите источник и sha256" >&2
    return 1
  fi

  # Источники QExtra обязаны быть ровно теми, что закреплены в lito.lock
  # обёртки: сборка идёт с --frozen, и лишний или недостающий пакет она
  # отвергнет уже после получаса сборки Rust — здесь это видно сразу.
  local lock="$srcdir/rexon/tools/qextra_plugin/lito.lock" e n u c v
  for e in "${_qe_git[@]}"; do
    IFS='|' read -r n u c <<<"$e"
    grep -qxF "source = \"git+${u}#${c}\"" "$lock" || {
      echo "ERROR: _qe_git: $n@$c нет в tools/qextra_plugin/lito.lock — обновите список и суммы" >&2
      return 1
    }
  done
  for e in "${_qe_reg[@]}"; do
    IFS='|' read -r n v c <<<"$e"
    grep -qxF "checksum = \"$c\"" "$lock" || {
      echo "ERROR: _qe_reg: $n $v ($c) нет в tools/qextra_plugin/lito.lock — обновите список и суммы" >&2
      return 1
    }
  done
  if (( $(grep -c '^source = ' "$lock") != ${#_qe_git[@]} + ${#_qe_reg[@]} )); then
    echo "ERROR: в tools/qextra_plugin/lito.lock другое число источников, чем в _qe_git и _qe_reg" >&2
    return 1
  fi
  # Сценарий сборки QExtra отвергает каталог сборки с путём не из латиницы
  # (lito на таких падал) — сказать об этом до сборки Rust, а не после.
  if LC_ALL=C grep -q '[^ -~]' <<<"$srcdir"; then
    echo "ERROR: каталог сборки должен быть путём из латиницы (BUILDDIR): $srcdir" >&2
    return 1
  fi

  # Настоящие шрифты вместо указателей git-lfs: тогда tools/build_qml_material.sh
  # ничего не качает и собирается без сети.
  local f
  for f in "${_qm_fonts[@]}"; do
    cp "$srcdir/${_qm_pin:0:12}-$f" "$srcdir/QmlMaterial/assets/$f"
  done

  # Модель перевода: распаковываем В КАТАЛОГ НАПРАВЛЕНИЯ и сверяем сумму
  # РАСПАКОВАННОГО файла — именно он поедет в пакет.
  local mt="$srcdir/translate/$_mt_pair"
  install -d "$mt"
  gzip -dc "$srcdir/${_mt_tag:0:8}-${_mt_model}.gz" > "$mt/$_mt_model"
  gzip -dc "$srcdir/${_mt_tag:0:8}-${_mt_vocab}.gz" > "$mt/$_mt_vocab"
  printf '%s  %s\n%s  %s\n' \
    "$_mt_model_sum" "$mt/$_mt_model" \
    "$_mt_vocab_sum" "$mt/$_mt_vocab" | sha256sum --check --quiet || return 1

  # Нижняя граница демона в depends — тег, с которого сняты протокол и
  # вендорный интерфейс: обновили вендор, а границу забыли — пакет обещал бы
  # работу с демоном, которого ядро уже не понимает.
  local tag
  tag=$(awk 'NR==1{print $1}' "$srcdir/rexon/data/qt_wallpaper_engine/proto/UPSTREAM_TAG")
  # Сторож один на оба варианта: системный пакет обязан быть не младше
  # тега, вшитый AppImage — ровно этим тегом.
  if [[ "$tag" != "v$_ww_min" ]]; then
    echo "ERROR: _ww_min=$_ww_min, а протокол снят с $tag (proto/UPSTREAM_TAG) — сверьте depends" >&2
    return 1
  fi
  if [[ $_bundled_engine == 1 && "$tag" != "v$_ww_ver" ]]; then
    echo "ERROR: вшитый AppImage _ww_ver=$_ww_ver, а протокол снят с $tag (proto/UPSTREAM_TAG) — обновите _ww_ver и sha256" >&2
    return 1
  fi
  if [[ $_bundled_engine == 1 ]] && (( $(vercmp "$_owe_ver" "$_owe_min") < 0 )); then
    echo "ERROR: вшитый плагин OWE $_owe_ver младше _owe_min=$_owe_min" >&2
    return 1
  fi
  if [[ $_bundled_engine == 1 ]]; then
    _owe_prepare || return 1
  fi

  # Крейты скачиваются здесь, дальше сборка идёт без сети (--frozen).
  cd "$srcdir/rexon/rust"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/rexon/rust"
  export CARGO_TARGET_DIR="$srcdir/rexon/rust/target"

  # ── Сборочные пути наружу не уезжают ────────────────────────────
  # Без этой карты в готовых бинарях остаются абсолютные пути сборочной
  # машины, и makepkg ругается «Пакет содержит ссылку на директорию
  # '$srcdir'». Источников ДВА, и лечатся они разными флагами:
  #   * rustc печатает путь файла в метаданные паники (`core::panic::
  #     Location`) — оттуда ~250 строк на бинарь с путями крейтов из
  #     $CARGO_HOME/registry и путь сгенерированного prost'ом
  #     `waywallen.control.v1.rs` в OUT_DIR;
  #   * gcc подставляет __FILE__ в Q_ASSERT заголовков cxx-qt, которые
  #     cxx-qt-build кладёт в OUT_DIR и подключает абсолютным -I
  #     (qlist_private.h, qmap_private.h, cxx-qt/thread.h).
  # Отладочной информации в релизе нет вовсе (`debug` профиля выключен),
  # так что это НЕ она — строки лежат в .rodata и стрипом не снимаются.
  #
  # Штатный `trim-paths` профиля Cargo сюда не годится: в cargo 1.98 он
  # ещё не стабилизирован («feature `trim-paths` is required … not
  # stabilized in this version of Cargo», нужен нестабильный
  # `-Z trim-paths`). Поэтому карту задаём руками обеим половинам —
  # rustc через --remap-path-prefix, gcc через -ffile-prefix-map (он же
  # чинит __FILE__, а не только отладочную информацию).
  #
  # Профиля dev это не касается: переменные живут только внутри build()
  # пакета, локальная отладочная сборка исходники по-прежнему находит.
  local _cargo_home="${CARGO_HOME:-$HOME/.cargo}"
  local _remap="-ffile-prefix-map=$srcdir=/usr/src/rexon"
  _remap+=" -ffile-prefix-map=$_cargo_home=/usr/src/cargo"
  export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }--remap-path-prefix=$srcdir=/usr/src/rexon --remap-path-prefix=$_cargo_home=/usr/src/cargo"
  export CFLAGS="$CFLAGS $_remap"
  export CXXFLAGS="$CXXFLAGS $_remap"

  # Пакеты названы через -p: в rust/Cargo.toml стоит
  # `default-members = ["rexon-core"]`, и голый `cargo build --release`
  # собрал бы одно ядро. Набор тот же, что у псевдонима `cargo build-app`.
  # Flash-обои со звуком (режим хоста --mode swf, Ruffle) — фича `swf-sound`
  # rexon-gui, она включена по умолчанию: громкость обоев одна на видео и
  # Flash, и немая сборка означала бы ползунок, который у половины обоев
  # ничего не делает.
  cargo build --frozen --release -p rexon-core -p rexon-gui -p rexon-qt-filter
  # Заставка входа — отдельным прогоном, как `cargo build-splash`: в общем
  # прогоне сменилось бы объединение фич и rexon-gui собирался бы дважды.
  cargo build --frozen --release -p rexon-splash-overlay

  # Ярлыки печатает генератор ядра — вход на Rust-окно по пути пакета.
  # Статичных копий у пакета нет: прежняя отстала от генератора и оставила
  # ярлык на Python-входе.
  target/release/desktop-entry --package > "$srcdir/rexon.desktop"
  target/release/desktop-entry --package --recover > "$srcdir/rexon-recover.desktop"

  # ── QML-плагины вкладки Wallpaper Engine ────────────────────────
  # Первые два обязательны: без них `qml_modules::qml_plugins_ready` говорит «нет»,
  # и вендорные страницы не грузятся ни в Rust-окне, ни в классическом.
  # Собираем теми же tools/-скриптами, что и разработчик (вторая копия
  # команд cmake разъехалась бы с ними молча), но исходник и шрифты им
  # подаём из $srcdir, а сборочные каталоги уводим туда же — в сеть и в
  # $HOME они при этом не ходят.
  # Потоки C++-сборки — из MAKEFLAGS makepkg.conf (-jN / --jobs=N): `cmake
  # --build` MAKEFLAGS не читает (генератор Ninja), lito — тоже. Без этого
  # cmake и lito берут все ядра, а с LTO при 8 ГБ ОЗУ сборку убивал OOM
  # (cc1plus на control.qpb.cpp). Заданные явно переменные не трогаем.
  local _jobs
  _jobs=$(grep -oE '(^|[[:space:]])(-j[[:space:]]*|--jobs[=[:space:]]+)[0-9]+' \
    <<<"${MAKEFLAGS:-}" | grep -oE '[0-9]+$' | tail -n1 || true)
  if [[ -n $_jobs ]]; then
    export CMAKE_BUILD_PARALLEL_LEVEL="${CMAKE_BUILD_PARALLEL_LEVEL:-$_jobs}"
    export QEXTRA_JOBS="${QEXTRA_JOBS:-$_jobs}"
  fi
  export CARGO_NET_OFFLINE=true
  QML_MATERIAL_SRC="$srcdir/QmlMaterial" QML_MATERIAL_PIN="$_qm_pin" \
    bash "$srcdir/rexon/tools/build_qml_material.sh" "$srcdir/qml_modules"
  QML_CONTROL_BUILD="$srcdir/qml_control-build" \
    bash "$srcdir/rexon/tools/build_qml_control.sh" "$srcdir/qml_modules"

  # Третий — настоящий QExtra (без него вкладка идёт на QML-подмене).
  _qextra_build

  if [[ $_bundled_engine == 1 ]]; then
    _owe_source_bundle
  fi
}

# Вшитый движок: плагин OWE — в свой каталог (в корне zip лежат bin/, lib/,
# main.lua). Версия внутри обязана совпасть с прибитой: иначе в пакет поехал
# бы не тот плагин, под который сверена совместимость с демоном.
_owe_prepare() {
  rm -rf "$srcdir/owe-plugin"
  install -d "$srcdir/owe-plugin"
  bsdtar -xf "$srcdir/$_owe_zip" -C "$srcdir/owe-plugin"
  grep -qx "id = \"$_owe_id\"" "$srcdir/owe-plugin/plugin.toml" \
    && grep -qx "version = \"$_owe_ver\"" "$srcdir/owe-plugin/plugin.toml" || {
    echo "ERROR: в $_owe_zip не $_owe_id $_owe_ver" >&2
    return 1
  }
  # Исходник того же тега: версия workspace в lito.toml — та же, что у плагина.
  grep -q "^version = \"$_owe_ver\"" "$srcdir/open-wallpaper-engine/lito.toml" || {
    echo "ERROR: исходник OWE не версии $_owe_ver" >&2
    return 1
  }
}

# Архив полного исходника плагина OWE (GPL-2.0-only §3(a)): тег v${_owe_ver} +
# всё, что lito подтягивает в сборку, + исходники обёртки CEF. Без .git:
# ревизии записаны в SOURCES.txt и в lito.lock самого тега. Архив
# воспроизводим: порядок имён, владелец и время файлов фиксированы.
_owe_source_bundle() {
  local top="open-wallpaper-engine-${_owe_ver}"
  local root="$srcdir/owe-src/$top"
  local bundle="$root/.lito/source-bundle/v1"
  local e n u c d v
  rm -rf "$srcdir/owe-src"
  install -d "$root" "$bundle/git" "$bundle/registry/source" "$root/third_party-cef"
  git -C "$srcdir/open-wallpaper-engine" archive --format=tar "$_owe_commit" | tar -x -C "$root"
  for e in "${_owe_git[@]}"; do
    IFS='|' read -r n u c d <<<"$e"
    install -d "$bundle/git/$d"
    git -C "$srcdir/owe-dep-$n" archive --format=tar "$c" | tar -x -C "$bundle/git/$d"
  done
  for e in "${_owe_reg[@]}"; do
    IFS='|' read -r n v c <<<"$e"
    install -m644 "$srcdir/lito-$n-$v.tar.zst" \
      "$bundle/registry/source/$n-$v-${c:0:16}.tar.zst"
  done
  bsdtar -xf "$srcdir/$_cef_archive" -C "$root/third_party-cef" \
    --include '*/include/*' --include '*/libcef_dll/*' --include '*/cmake/*' \
    --include '*/CMakeLists.txt' --include '*/LICENSE.txt' --include '*/README.txt'
  {
    echo "Open Wallpaper Engine ${_owe_ver} — полный исходник к бинарям плагина"
    echo "${_owe_id} в пакете Rexon (/usr/lib/rexon/engine/plugins/)."
    echo "Лицензия: GPL-2.0-only (LICENSE в корне)."
    echo
    echo "Исходник: https://github.com/waywallen/open-wallpaper-engine коммит ${_owe_commit} (тег v${_owe_ver})."
    echo "Зависимости сборки (lito.lock тега), раскладка .lito/source-bundle/v1/:"
    for e in "${_owe_git[@]}"; do
      IFS='|' read -r n u c d <<<"$e"
      echo "  git/$d  $u @ $c"
    done
    for e in "${_owe_reg[@]}"; do
      IFS='|' read -r n v c <<<"$e"
      echo "  registry/source/$n-$v-${c:0:16}.tar.zst  https://registry.litocpp.org/ sha256 $c"
    done
    echo "third_party-cef/: исходники обёртки libcef_dll_wrapper и заголовки CEF (BSD-3-Clause)"
    echo "  из $_cef_url"
    echo "  sha256 $_cef_sha; бинарная часть CEF (libcef.so и ресурсы) лежит в самом плагине."
    echo
    echo "Сборка: см. BUILD.md (сборщик lito, https://github.com/hypengw/lito)."
  } > "$root/SOURCES.txt"
  tar --sort=name --owner=0 --group=0 --numeric-owner --mtime='@0' \
    -C "$srcdir/owe-src" -cf - "$top" | xz -T0 -9 > "$srcdir/owe-src/$top-src.tar.xz"
}

# Набор исходников lito для сборки QExtra без сети. Раскладка — та, что lito
# сам выгружает из lock-файла (`lito lock export --format flatpak-sources`):
# git-источник — рабочая копия на закреплённом коммите в v1/git/<имя>, архив
# реестра — v1/registry/source/<пакет>-<версия>-<16 знаков суммы>.tar.zst.
# Имя git-каталога вычисляет lito, поэтому оно не записано здесь, а
# спрашивается у него же: выгрузка сети не требует.
_qextra_source_bundle() {
  local bundle="$srcdir/qextra-bundle" map="$srcdir/qextra-sources.json"
  local e n u c v d
  rm -rf "$bundle"
  install -d "$bundle/v1/git" "$bundle/v1/registry/source"
  XDG_DATA_HOME="$srcdir/qextra-data" "${LITO:-lito}" \
    -C "$srcdir/rexon/tools/qextra_plugin" \
    lock export --format flatpak-sources --output "$map"
  for e in "${_qe_git[@]}"; do
    IFS='|' read -r n u c <<<"$e"
    d=$(grep -A1 -F "\"commit\": \"$c\"" "$map" | grep -oE 'v1/git/[0-9a-f]{64}' | head -1 || true)
    [[ -n "$d" ]] || {
      echo "ERROR: lito не назвал каталог набора исходников для $n@$c ($map)" >&2
      return 1
    }
    cp -a "$srcdir/qextra-src-$n" "$bundle/$d"
  done
  for e in "${_qe_reg[@]}"; do
    IFS='|' read -r n v c <<<"$e"
    install -m644 "$srcdir/lito-$n-$v.tar.zst" \
      "$bundle/v1/registry/source/$n-$v-${c:0:16}.tar.zst"
  done
}

# Сборка настоящего QExtra тем же сценарием, что у разработчика. Сеть ей не
# нужна: исходники берутся из набора выше, свой каталог данных lito
# (распакованные архивы реестра) уведён из $HOME в $srcdir. Флаги makepkg и
# карта путей из build() доходят до clang через `lito --use-env-flags` — без
# карты в плагине остаются пути сборочной машины. Ключи, которые lito
# оставляет профилю release (-O*, -g*, LTO, strip), и _FORTIFY_SOURCE
# сценарий срезает сам (QEXTRA_ENV_FLAGS=1): иначе с -O2 из makepkg.conf Arch
# lito отказывает ещё до сборки. Число потоков — из MAKEFLAGS (см. build()),
# без -jN — 4, как у разработчика; другой lito — переменной LITO.
_qextra_build() {
  _qextra_source_bundle
  QEXTRA_SOURCE_BUNDLE="$srcdir/qextra-bundle" QEXTRA_ENV_FLAGS=1 \
  QEXTRA_BUILD="$srcdir/qextra-build" XDG_DATA_HOME="$srcdir/qextra-data" \
    bash "$srcdir/rexon/tools/build_qml_qextra.sh" "$srcdir/qml_modules"
}

# Свои бинари стрипаем сами: общий strip makepkg выключен ради плазмоида и
# вшитого AppImage (см. options). Чужие сборки не трогаем: каталог вшитого
# движка (AppImage и плагин, уже стрипнутые апстримом) и плазмоид
# org.waywallen.kde — его .so обязан ехать бит в бит как в выпуске апстрима
# (по хэшу рантайма Rexon узнаёт версию чужой установки, KNOWN_RUNTIME_SHA).
_strip_own_binaries() {
  local f
  while IFS= read -r -d '' f; do
    # только ELF: сигнатура \x7fELF в первых байтах
    [[ "$(head -c4 "$f" | od -An -c | tr -d ' ')" == '177ELF' ]] || continue
    case "$f" in
      *.so|*.so.*) strip --strip-unneeded "$f" ;;
      *) strip --strip-all "$f" ;;
    esac
  done < <(find "$pkgdir" \( -path "$pkgdir/usr/lib/rexon/engine" \
                         -o -path "$pkgdir/usr/lib/rexon/rexon/kpackage" \) -prune \
                         -o -type f -print0)
}

check() {
  desktop-file-validate "$srcdir/rexon.desktop" "$srcdir/rexon-recover.desktop"
  # Карточка для Discover/GNOME Software. Две метки понижены до сведения
  # намеренно, остальное по-прежнему валит сборку:
  #  * cid-desktopapp-is-not-rdns — id обязан совпадать с именем ярлыка
  #    rexon.desktop, а ярлык так зовут и ручная установка, и удаление;
  #  * url-homepage-missing — сайта у продукта пока нет, выдумывать адрес
  #    нельзя.
  appstreamcli validate --no-net \
    --override=cid-desktopapp-is-not-rdns=info,url-homepage-missing=info \
    "$srcdir/rexon/packaging/rexon.metainfo.xml"
}

package() {
  cd "$srcdir/rexon"
  local rel=rust/target/release
  local lib="$pkgdir/usr/lib/rexon"

  # ── Rust-окно — основной вход ярлыка ────────────────────────────
  # Путь — `installer::PACKAGE_MAIN_WINDOW` ядра: на него ведёт ярлык,
  # сверка `app_parity.rs` краснеет, если путь здесь разойдётся.
  # QML окна запечён в сам бинарь (статический модуль org.rexon.gui).
  install -Dm755 "$rel/rexon-main-window" "$pkgdir/usr/lib/rexon/rexon-main-window"
  # Помощник плиток «Оформления» (снимок стиля Qt и темы GTK настоящими
  # виджетами) — рядом с окном: ядро ищет его возле своего бинаря
  # (`widget_shot::find_helper`, путь пакета `widget_shot::PACKAGE_HELPER`).
  install -Dm755 "$rel/rexon-theme-shot" "$pkgdir/usr/lib/rexon/rexon-theme-shot"

  # ── Страховка экрана входа: текст на консоли вместо чёрного экрана ──
  # Программа без Qt (`login_rescue::RESCUE_BIN_PACKAGE`) и её юниты:
  # служба rexon-login-rescue и drop-in'ы `OnFailure=` у display-manager
  # и каждого известного экрана входа. Тексты и список печатает ядро —
  # второй копии в пакете нет. Файлы в учёте пакета: `pacman -R` снимает
  # их сам.
  install -Dm755 "$rel/rexon-login-rescue" "$pkgdir/usr/lib/rexon/rexon-login-rescue"
  local unit
  for unit in $("$rel/rexon-login-rescue" --list-files); do
    install -d "$pkgdir$(dirname "$unit")"
    "$rel/rexon-login-rescue" --file "$unit" > "$pkgdir$unit"
    chmod 644 "$pkgdir$unit"
  done

  # ── Хост обоев и заставка входа → PATH ──────────────────────────
  # Ядро ищет их в дереве разработчика, затем по PATH
  # (wallpaper_engine::find_wallpaper_host_binary, session_splash).
  # Хост обоев ОДИН — видео, веб и Flash его режимы (`--mode video|web|swf`).
  local b
  for b in rexon-wallpaper-host rexon-splash-overlay; do
    install -Dm755 "$rel/$b" "$pkgdir/usr/bin/$b"
  done

  # ── Лаунчер /usr/bin/rexon ──────────────────────────────────────
  # Вход продукта из командной строки и из чужих ярлыков. Ведёт на
  # Rust-окно: оно понимает ВСЕ флаги продукта одной дверью ядра
  # (`cli::run_headless` + `cli::start_section`) — --tray, --page=,
  # --apply-defaults, --sanitize-gtk, --session-splash, --recover-kde,
  # пять флагов одиночных вкладок и --selftest. Аргументы едут как есть.
  # REXON_PACKAGED — признак пакетной установки для ядра
  # (`installer::detect_default_mode`): предлагать установку поверх
  # пакета нельзя.
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/rexon" <<'LAUNCHER'
#!/bin/sh
# Rexon — лаунчер (пакетная установка: AUR / pacman).
REXON_PACKAGED=1
export REXON_PACKAGED
# `rexon doctor` — без Qt: он нужен, когда Qt мог сломаться.
if [ "${1:-}" = doctor ]; then
  exec /usr/lib/rexon/rexon-login-rescue doctor
fi
exec /usr/lib/rexon/rexon-main-window "$@"
LAUNCHER
  chmod 755 "$pkgdir/usr/bin/rexon"

  # ── Каталог QML-модулей системы ─────────────────────────────────
  # Ядро ищет его как `qml_modules::SYSTEM_MODULE_DIRS`
  # (/usr/lib/rexon/qml_modules) и требует в нём ДВА плагина (третий,
  # QExtra/libqextraplugin.so, берёт, когда он есть и собран под Qt процесса):
  # Qcm/Material/libqml_materialplugin.so (оформление) и
  # waywallen/control/libwaywallen-controlplugin.so (value-типы
  # Qt-Protobuf). Рядом с control лежит наша Rust-сборка
  # librexon_qt_filter.so (редактор фильтров обоев); типы вкладок вшиты
  # в rexon-main-window статически, своей .so у них нет.
  # Путь литералом, а не через $lib: сверка `app_parity.rs` ищет в PKGBUILD
  # ровно ту строку, которую ядро держит в `qml_modules::SYSTEM_MODULE_DIRS`.
  local qmod="$pkgdir/usr/lib/rexon/qml_modules"
  install -d "$qmod"
  cp -a "$srcdir/qml_modules/." "$qmod/"
  # Входные файлы rcc этапа сборки: внутри абсолютный путь $srcdir, которого на
  # машине покупателя нет. Qt их в работе не читает — плагин уже собран.
  find "$qmod" -name '*_qml_module_dir_map.qrc' -delete
  # Отметка протокола модуля (её пишет tools/build_qml_control.sh). Без неё
  # ядро не отличит пакетный waywallen.control от устаревшей сборки в
  # домашней папке (`qml_modules::stale_control_dirs`), и та заслонит его.
  [ -s "$qmod/waywallen/control/proto.sha256" ] || {
    echo "нет отметки протокола waywallen.control (proto.sha256)" >&2
    return 1
  }
  # Настоящий QExtra без отметки версии Qt ядро не берёт
  # (`qml_modules::choose_qextra`: «рядом с плагином нет отметки») и молча
  # показывает QML-подмену — пакет вышел бы без того, ради чего плагин в нём.
  [ -s "$qmod/QExtra/QT_VERSION" ] && [ -s "$qmod/QExtra/libqextraplugin.so" ] || {
    echo "нет плагина QExtra или его отметки версии Qt (QExtra/QT_VERSION)" >&2
    return 1
  }
  install -Dm755 "$rel/librexon_qt_filter.so" "$qmod/waywallen/control/librexon_qt_filter.so"

  # ── Данные продукта: data/ дерева → /usr/lib/rexon/rexon ────────
  # Каталог, который ядро ищет как `installer::package_data_dir_candidates`
  # и признаёт по `installer::PACKAGE_MARKER_REL`. Раньше сюда клали весь
  # пакет Python; теперь — ТОЛЬКО данные, которые читает Rust-окно:
  #   * qt_wallpaper_engine/qml_ui — вендорный QML waywallen, PageHost,
  #     прогревочная сцена и каталог перевода .qm (`remote_l10n`);
  #   * qt_wallpaper_engine/proto/UPSTREAM_TAG — тег снапшота протокола,
  #     по нему бейдж сверки видит устаревший протокол (`we_parity`);
  #   * kpackage/org.waywallen.kde — Plasma-плагин обоев, его ставит
  #     kpackagetool6 (`waywallen_kde_plugin::bundle_dir`). Из дерева едет
  #     только vendor.toml (по нему Rexon узнаёт «ставили мы» и версию),
  #     сам плазмоид — официальный архив выпуска, распакованный как есть;
  #   * themes.json — встроенная база тем (`themes::builtin_json_path`);
  #   * assets/fonts — бандл-шрифты заголовков скинов (`ui_base`);
  #   * assets/screenshots — свои снимки столов, которых нет ни у проекта,
  #     ни на Commons (River; `screenshots::BUNDLED_SUBDIR`).
  local data="$lib/rexon"
  install -d "$data/qt_wallpaper_engine" "$data/kpackage"
  cp -a data/qt_wallpaper_engine/qml_ui "$data/qt_wallpaper_engine/qml_ui"
  install -Dm644 data/qt_wallpaper_engine/proto/UPSTREAM_TAG \
    "$data/qt_wallpaper_engine/proto/UPSTREAM_TAG"
  # Корень архива — уже каталог org.waywallen.kde/.
  bsdtar -xf "$srcdir/$_wwd_zip" -C "$data/kpackage"
  install -m644 data/kpackage/org.waywallen.kde/vendor.toml \
    "$data/kpackage/org.waywallen.kde/vendor.toml"
  install -Dm644 data/themes.json "$data/themes.json"
  cp -a data/assets "$data/assets"

  # ── Модель перевода описаний → <данные>/translate/<пара> ────────
  # Порядок поиска задаёт ядро: переменная REXON_TRANSLATE_MODEL_DIR (путь
  # разработчика), затем каталоги поставки + `translate/<пара>`
  # (`translator_engine::MODEL_DIR_REL`, `model_dir_candidates`). Имена
  # файлов — те же, что у скачанной модели Firefox
  # (`translator_engine::model_files_in`): model.<пара>.intgemm.alphas.bin и
  # vocab.<пара>.spm. Разойдётся путь или имя — движок молча скажет «модели
  # нет», и описания останутся по-английски; за это краснеет сверка
  # `tests/translator_engine.rs`.
  install -Dm644 "$srcdir/translate/$_mt_pair/$_mt_model" \
    "$data/translate/$_mt_pair/$_mt_model"
  install -Dm644 "$srcdir/translate/$_mt_pair/$_mt_vocab" \
    "$data/translate/$_mt_pair/$_mt_vocab"

  # Питоновских исходников в каталоге данных нет (Python — архив с
  # 02.10.2026); снимаем на всякий случай кэш байт-кода, если он приехал.
  find "$data" -name '__pycache__' -type d -prune -exec rm -rf {} +
  find "$data" -name '*.py' -delete

  # ── Переводы интерфейса → /usr/share/locale ──────────────────────
  # Каталоги собрал build.rs крейта rexon-gui (`scripts/i18n-update.sh
  # --build`) рядом с бинарями: <язык>/LC_MESSAGES/rexon.mo из
  # po/<язык>.po — один каталог и для строк Rust, и для строк QML (их
  # переводчик окна спрашивает то же ядро). Ядро ищет его в
  # `i18n::SYSTEM_LOCALEDIR` — ровно этот путь. Новый язык = новый .po в
  # po/LINGUAS, рецепт при этом не меняется.
  install -d "$pkgdir/usr/share/locale"
  cp -r "$rel/locale/." "$pkgdir/usr/share/locale/"

  # Значок лотка: `tray::icon_candidates` ищет его по этому пути.
  install -Dm644 rexon_icon.png "$lib/rexon_icon.png"

  # ── Привилегированные помощники и polkit-политики ───────────────
  # Без них КАЖДАЯ системная операция спрашивает пароль сырым pkexec, а
  # темы экрана входа и загрузки из «Оформления» не ставятся вовсе. С ними
  # пароль спрашивается реже: auth_admin_keep держит его 5 минут для окна
  # Rexon, и подтверждённое org.rexon.pkg покрывает остальные три действия.
  # Тексты печатает ядро (`system_plan`, `installer`) — второй копии в
  # пакете нет, расходятся они молча; список помощников тоже у ядра
  # (`--list`). Путь у пакета свой, /usr/lib: в /usr/local пакету писать
  # нельзя (нормы Arch, и pacman -R такие файлы не снял бы), а политика
  # annotate'ит ровно тот путь, по которому помощник лежит.
  # ⚠️ Passwordless-правило (/etc/polkit-1/rules.d) пакет НЕ ставит
  # намеренно: это отдельный выбор человека, а не умолчание пакета.
  local who path
  for who in $("$rel/package-polkit" --list); do
    path=$("$rel/package-polkit" --path "$who")
    install -d "$pkgdir$(dirname "$path")"
    "$rel/package-polkit" --helper "$who" > "$pkgdir$path"
    chmod 755 "$pkgdir$path"
    path=$("$rel/package-polkit" --policy-path "$who")
    install -d "$pkgdir$(dirname "$path")"
    "$rel/package-polkit" --policy "$who" > "$pkgdir$path"
    chmod 644 "$pkgdir$path"
  done

  # ── Помощник сеанса прав («один пароль на запуск») ─────────────
  # rexon-priv-helper — не скрипт, а бинарь ядра (cargo собрал его вместе с
  # rexon-core): берём файл из каталога сборки по имени из `--path`, политику
  # org.rexon.session печатает тот же генератор. Политика спрашивает пароль
  # на КАЖДЫЙ подъём сеанса (auth_admin без keep) — один пароль держит сам
  # помощник, пока открыто окно. Права 755 и владелец root обязательны:
  # окно не поднимет помощника, если файл или каталог над ним доступны на
  # запись не только root (`privilege::client::check_ownership`).
  for who in $("$rel/package-polkit" --list-binaries); do
    path=$("$rel/package-polkit" --path "$who")
    install -Dm755 "$rel/${path##*/}" "$pkgdir$path"
    path=$("$rel/package-polkit" --policy-path "$who")
    install -d "$pkgdir$(dirname "$path")"
    "$rel/package-polkit" --policy "$who" > "$pkgdir$path"
    chmod 644 "$pkgdir$path"
  done
  # «sudo» сборщиков AUR (paru/yay) в окне Rexon — шим сеанса прав: прав не
  # имеет, строку pacman передаёт окну (`privilege::aur`). Лежит рядом с
  # помощником сеанса — там его ищет окно.
  install -Dm755 "$rel/rexon-sudo-shim" "$pkgdir/usr/lib/rexon-sudo-shim"

  # ── .desktop — напечатаны генератором ядра в build() ────────────
  # Автозапуск пакет НЕ ставит: его пишет трей по выбору человека.
  install -Dm644 "$srcdir/rexon.desktop" \
    "$pkgdir/usr/share/applications/rexon.desktop"
  install -Dm644 "$srcdir/rexon-recover.desktop" \
    "$pkgdir/usr/share/applications/rexon-recover.desktop"

  # ── AppStream: без карточки центры приложений продукта не видят ─
  install -Dm644 packaging/rexon.metainfo.xml \
    "$pkgdir/usr/share/metainfo/rexon.metainfo.xml"

  # ── Иконки: hicolor (8 растровых размеров) + pixmap fallback ────
  # Вектора нет намеренно: rexon_icon.svg старого рисунка удалён вместе с
  # приходом нового значка (2a09adc), до 512 px хватает растровых.
  local size
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "rexon_icon_${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/rexon.png"
  done
  install -Dm644 rexon_icon_128.png "$pkgdir/usr/share/pixmaps/rexon.png"

  # ── GNOME Shell + Cinnamon extensions (Mutter/Muffin без layer-shell:
  #    обои через расширение оболочки + mmap frame-streaming) ───────
  local ext='rexon-wallpaper@rexon.app' d
  install -d "$pkgdir/usr/share/gnome-shell/extensions" \
             "$pkgdir/usr/share/cinnamon/extensions"
  cp -a "data/gnome-extension/$ext" \
    "$pkgdir/usr/share/gnome-shell/extensions/$ext"
  cp -a "data/cinnamon-extension/$ext" \
    "$pkgdir/usr/share/cinnamon/extensions/$ext"
  for d in "$pkgdir/usr/share/gnome-shell/extensions/$ext/schemas" \
           "$pkgdir/usr/share/cinnamon/extensions/$ext/schemas"; do
    [[ -d "$d" ]] && glib-compile-schemas "$d"
  done
  # Те же схемы — в общий каталог: без этого `gsettings set` (так Rexon
  # передаёт расширению обои) отвечает «Схема … не существует». Собирает
  # общий каталог хук pacman пакета glib2, сами не компилируем. Каталог
  # расширения выше тоже нужен: getSettings() расширения читает свой.
  install -Dm644 -t "$pkgdir/usr/share/glib-2.0/schemas" \
    "data/gnome-extension/$ext/schemas/"*.gschema.xml \
    "data/cinnamon-extension/$ext/schemas/"*.gschema.xml

  # ── Лицензии ────────────────────────────────────────────────────
  # Своя (Apache-2.0: LICENSE и NOTICE) — обязательна в /usr/share/licenses; рядом чужие:
  # MIT плагина Qcm.Material, MIT плагина QExtra с его статическими частями
  # и OFL-1.1 шрифта Noto Sans, встроенного в хост обоев (Ruffle, фича
  # default_font).
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE  "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 "$srcdir/QmlMaterial/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.QmlMaterial"
  install -Dm644 "$srcdir/rexon/rust/rexon-swf/NotoSans-OFL-1.1.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.NotoSans-OFL-1.1"

  # QML-плагин QExtra (MIT OR Apache-2.0, берём на условиях MIT) и то, что
  # вошло в него статически: wavsen, vvk, licrypto (тот же текст и та же
  # строка © 2026 hypengw, что у QExtra), ncrequest (MIT, © 2024-2025
  # hypengw), lihttpto, liwebsocketo и rstd (© 2025 hypengw; архивы rstd
  # своего файла лицензии не несут, текст и строка у них те же, что у
  # lihttpto). MIT требует везти
  # уведомление с каждой копией — поэтому три текста, по одному на каждую
  # строку авторства. Перечень — NOTICE, раздел «QExtra».
  install -Dm644 "$srcdir/qextra-src-QExtra/LICENSE-MIT" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.QExtra-MIT"
  install -Dm644 "$srcdir/qextra-src-ncrequest/LICENSE.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.ncrequest-MIT"
  local _e _n _v
  for _e in "${_qe_reg[@]}"; do
    IFS='|' read -r _n _v _ <<<"$_e"
    [[ "$_n" == lihttpto ]] || continue
    bsdtar -xOf "$srcdir/lito-$_n-$_v.tar.zst" "$_n-$_v/LICENSE-MIT" \
      > "$pkgdir/usr/share/licenses/$pkgname/LICENSE.lihttpto-MIT"
  done
  [ -s "$pkgdir/usr/share/licenses/$pkgname/LICENSE.lihttpto-MIT" ] || {
    echo "в архиве lihttpto не нашёлся текст лицензии (LICENSE-MIT)" >&2
    return 1
  }
  chmod 644 "$pkgdir/usr/share/licenses/$pkgname/LICENSE.lihttpto-MIT"

  # ⚖️ Plasma-плагин обоев org.waywallen.kde (официальный архив выпуска без
  # изменений, едет в /usr/lib/rexon/rexon/kpackage/ и ставится
  # kpackagetool6). Лицензия у апстрима записана двояко: extensions/kde/LICENSE
  # — MIT © hypengw, metadata.json — GPL-2.0-or-later. Вопрос задан автору
  # (waywallen/waywallen-display#70); до ответа ставим ОБА текста: его LICENSE
  # и GPL-2.0, на который ссылается metadata.json. С 0.4.2 LICENSE лежит в
  # самом архиве выпуска (#71; бит в бит тот же, что extensions/kde/LICENSE
  # тега) — отдельно его больше не качаем.
  [ -s "$data/kpackage/org.waywallen.kde/LICENSE" ] || {
    echo "в архиве плазмоида $_wwd_zip не нашёлся LICENSE" >&2
    return 1
  }
  install -Dm644 "$data/kpackage/org.waywallen.kde/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.waywallen-kde-MIT"
  install -Dm644 packaging/licenses/GPL-2.0.txt \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.waywallen-kde-GPL-2.0"

  # Движок автоперевода описаний: вендорный крейт fxtranslate (MPL-2.0) и
  # чужие заголовки внутри него — gemmology (MIT) и xsimd (BSD-3-Clause).
  # BSD-3-Clause прямо требует воспроизвести уведомление в документации,
  # поэтому оба текста ставятся, а не только MPL.
  local _fx="$srcdir/rexon/rust/vendor/fxtranslate"
  install -Dm644 "$_fx/crate/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.fxtranslate-MPL-2.0"
  install -Dm644 "$_fx/crate/vendor/gemmology/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.gemmology-MIT"
  install -Dm644 "$_fx/crate/vendor/xsimd/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.xsimd-BSD-3-Clause"
  # ⭐ MPL-2.0 — копилефт ПОФАЙЛОВЫЙ: обязанность у нас одна — выложить
  # исходники тех файлов крейта, которые мы изменили. Все правки лежат
  # одним патчем, поэтому обязанность закрывается установкой ЭТОГО файла
  # рядом с лицензией — и закрывается целиком, без раскрытия кода Rexon.
  # Разбор — rust/vendor/fxtranslate/ATTRIBUTION.md.
  install -Dm644 "$_fx"/patches/0001-*.patch \
    "$pkgdir/usr/share/licenses/$pkgname/fxtranslate-0.4.2-rexon.patch"

  # Модель перевода en→ru (mozilla/translations) — та же MPL-2.0, что у
  # крейта: «The model files are distributed under the MPL 2.0 license»
  # (README апстрима). Своего файла лицензии ведро модели не отдаёт, а текст
  # MPL-2.0 — один дословный документ, поэтому кладётся текст из вендорного
  # дерева под своим именем: покупатель видит, чем накрыты 43 МБ рядом с
  # продуктом, отдельной строкой, а не догадкой.
  # Раскрывать по модели нечего: файлы едут НЕИЗМЕНЁННЫМИ (менять их нам
  # нечем), поэтому пофайлового копилефта они не задевают. Уведомление —
  # в NOTICE выше, раздел «Модель перевода Firefox en→ru».
  install -Dm644 "$_fx/crate/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.translations-model-MPL-2.0"

  if [[ $_bundled_engine == 1 ]]; then
    _package_bundled_engine
  fi

  _strip_own_binaries
}

# ── Вшитый движок: waywallen + плагин Open Wallpaper Engine ─────────
# Путь — `we_client::ENGINE_DIR` ядра (сверка app_parity.rs ищет его здесь
# литералом). Ядро запускает отсюда AppImage, если системного движка нет
# (`we_client::engine_layouts`) и управляемый ~/.local/share/waywallen не
# новее, и передаёт демону `--plugin /usr/lib/rexon/engine`: демон ищет
# плагины в <каталог>/plugins/. Копия плагина у человека в
# ~/.local/share/waywallen/plugins остаётся его: демон берёт новую из двух,
# при равенстве — копию человека.
# ⚠️ Плагин НЕ самодостаточен: libwaywallen-bridge.so и ffmpeg ему подаёт
# AppImage демона при запуске рендерера (namcap об этом предупреждает).
# С пакетами waywallen/open-wallpaper-engine файлы не пересекаются: те живут
# в /usr/bin, /usr/lib и /usr/share/waywallen.
_package_bundled_engine() {
  local eng="$pkgdir/usr/lib/rexon/engine"
  install -Dm755 "$srcdir/$_ww_appimage" "$eng/waywallen.AppImage"
  install -d "$eng/plugins"
  cp -a --no-preserve=ownership "$srcdir/owe-plugin" "$eng/plugins/$_owe_id"
  chmod -R u+rwX,go+rX,go-w "$eng/plugins/$_owe_id"

  # GPL-2.0-only §3(a): полный исходник рядом с бинарём + текст лицензии.
  install -Dm644 "$srcdir/owe-src/open-wallpaper-engine-${_owe_ver}-src.tar.xz" \
    "$pkgdir/usr/share/rexon/sources/open-wallpaper-engine-${_owe_ver}-src.tar.xz"
  install -Dm644 "$srcdir/open-wallpaper-engine/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.open-wallpaper-engine-GPL-2.0"
  install -Dm644 "$srcdir/waywallen-${_ww_ver}-LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.waywallen-MIT"
  install -Dm644 "$srcdir/owe-src/open-wallpaper-engine-${_owe_ver}/third_party-cef/"*/LICENSE.txt \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.CEF-BSD-3-Clause"
}
