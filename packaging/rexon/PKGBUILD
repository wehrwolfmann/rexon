  'vectext|https://github.com/vecren/vectext.git|36fc965d8cb418f9dc17d31683dc268dabb52cb2|21970ad8a7f3b1c43ee2acdaf92336ce20163dc1ec66cfbb3bdaa7a05b1dff35'
  'vrento|https://github.com/vecren/vrento.git|02101d93c5fd76d8d4892910ba16765892d197c0|dd545781aaa95b1ccd52e4193abedb3430e5ba9553c3ec5b6724e959cc7ffa15'
