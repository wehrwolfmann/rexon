# Release package: built from the signed v${pkgver} tag of the public
#   repository (_giturl below). Fresh code from the branch is the rexon-git
#   package (packaging/aur/PKGBUILD).

pkgname=rexon
pkgver=0.1.1
pkgrel=4
pkgdesc="Universal desktop environment manager for Linux: install/switch DE, themes, live wallpapers"
url="https://github.com/wehrwolfmann/rexon"
# The package used to ship Python alone (arch=any); now it carries built
# binaries: the Rust window, the wallpaper host, the login splash and the
# privileged helpers. There is no interpreter in the package at all — the
# /usr/bin/rexon entry point leads to the Rust window.
arch=('x86_64')
# Wallpaper engine build variant. By default (1) the engine is BUNDLED: the
# waywallen AppImage, the OWE plugin and the archive of its GPL sources ship
# inside the package itself, in /usr/lib/rexon/engine — the waywallen and
# open-wallpaper-engine packages are not in the Arch and CachyOS
# repositories, and without the engine Wallpaper Engine wallpapers are not
# shown (Wehrwolfmann's decision of 2026-11-02, CachyOS submission). Only
# this variant is described in .SRCINFO. 0 — the engine from separate
# distribution packages (where they exist), enabled from the environment:
#   REXON_BUNDLED_ENGINE=0 makepkg
# Details: the "Wallpaper engine" block after options, and README.md.
case "${REXON_BUNDLED_ENGINE:-1}" in
  1) _bundled_engine=1 ;;
  0) _bundled_engine=0 ;;
  *) echo "ERROR: REXON_BUNDLED_ENGINE=${REXON_BUNDLED_ENGINE} — allowed values are 0 or 1" >&2
     _bundled_engine=invalid ;;   # prepare() stops the build
esac
# Lower bounds of the wallpaper engine packages (depends below); why exactly
# these — see the "Wallpaper engine" block after options.
_ww_min=0.6.1
_owe_min=0.3.4
# Our own code is Apache-2.0 (LICENSE + NOTICE), but the package also ships
# third-party code: the machine translation engine (fxtranslate, MPL-2.0)
# with gemmology (MIT) and xsimd (BSD-3-Clause) compiled in, the Mozilla
# model files (MPL-2.0).
# The QExtra QML plugin (built from the author's sources without changes)
# and wavsen, ncrequest, rstd, vvk, lihttpto statically linked into it are
# MIT (all except ncrequest offer "MIT OR Apache-2.0"; we take MIT).
# The field must list the licenses of EVERYTHING in the package, otherwise
# it lies to users and maintainers; all license texts are installed into
# /usr/share/licenses.
#
# By default the wallpaper engine is BUNDLED (since 2026-11-02): the package
# ships the waywallen AppImage (MIT; it contains third-party libraries under
# their own licenses, see NOTICE) and the OWE plugin — GPL-2.0-only, with
# the complete source of the same tag in /usr/share/rexon/sources
# (GPL-2 §3(a)); the plugin contains CEF (BSD-3-Clause, notice in a
# separate file). They are not linked with Rexon code: the daemon is a
# separate process, Rexon talks to it over D-Bus and WebSocket, and the OWE
# renderers are started by the daemon — "mere aggregation" (GPL-2 §2).
# The REXON_BUNDLED_ENGINE=0 variant does not ship the engine: the waywallen
# daemon and the Open Wallpaper Engine plugin are separate distribution
# packages in depends; their files, licenses and sources are the business
# of their own packages.
# The bundled variant also ships the org.waywallen.kde Plasma wallpaper
# plugin (the official release archive, unmodified; the =0 variant leaves it
# to the plasma-wallpaper-waywallen distribution package, see optdepends).
# Upstream states the plasmoid license in two ways: extensions/kde/LICENSE
# says MIT, while metadata.json says GPL-2.0-or-later; the author has been
# asked (waywallen/waywallen-display#70), and until there is an answer the
# field lists both and both texts are installed. The bundled
# libwaywallen-display-qml.so is MIT (a build of their waywallen-display
# library, linked only against Qt6).
license=('Apache-2.0' 'MPL-2.0' 'MIT' 'BSD-3-Clause')
if [[ $_bundled_engine == 1 ]]; then license+=('GPL-2.0-only' 'GPL-2.0-or-later'); fi
depends=(
  glibc
  libgcc               # libgcc_s; in Arch gcc-libs is a metapackage of all GCC libraries
  libstdc++            # (libgfortran, libasan…), and only these two are needed
  bash                 # the polkit helpers are bash scripts, and so is the /usr/bin/rexon launcher
  qt6-base             # Core/Gui/Widgets/DBus/Network/WaylandClient
  qt6-declarative      # QML / QtQuick / Controls / Layouts
  qt6-translations     # Qt's own standard strings (text field edit menu, dialog
                       # buttons) in Rexon's language; without it they are in English
  qt6-svg              # the window, theme snapshots and the wallpaper host link against libQt6Svg
  qt6-imageformats     # Qt plugin for .webp: without it extension pictures from
                       # extensions.gnome.org (and other webp images) are not shown
  qt6-webengine        # web wallpapers: rexon-wallpaper-host --mode web (dlopen + QML import)
  qt6-multimedia       # sound of scene wallpapers: QtMultimedia QML import
  qt6-websockets       # the Wallpaper Engine tab (QtWebSockets)
  layer-shell-qt       # wlr-layer-shell BACKGROUND on Wayland
  vulkan-icd-loader    # Flash wallpapers: rexon-wallpaper-host --mode swf renders via Vulkan (wgpu)
  alsa-lib             # sound of Flash wallpapers: cpal uses libasound (PipeWire serves it via its plugin);
                       # its headers are also needed for the build — not duplicated in makedepends
  mpv                  # rexon-splash-overlay links against libmpv (login splash)
  wayland
  libglvnd             # EGL for the login splash
  dbus
  openssl
  polkit               # pkexec + named org.rexon.* actions (fewer password prompts: auth_admin_keep)
  pacman-contrib       # checkupdates: what an update will bring — without root and without
                       # touching the system database; the "the update would install a
                       # mismatched set of packages" warning (update_guard) and AeroThemePlasma rely on it
  qt6ct                # Qt style selection outside KDE and LXQt (Kvantum themes:
                       # style, fonts and icons of Qt programs). 180 KiB,
                       # pulls in only qt6-base/qt6-svg — already listed here
  hicolor-icon-theme
  noto-fonts-emoji     # icons of tabs, categories and buttons are emoji in text;
                       # without a color font, emoji are boxes on a clean system
                       # (checked in a container with GNOME 51.1, 2026-10-16)
  noto-fonts           # fallback fonts for Arabic script and Hebrew (Noto Sans
                       # Arabic UI, Noto Sans Hebrew; `qt_app::RTL_FALLBACK_FONTS`),
                       # rather than relying on qt6-webengine pulling them in
  qt6-grpc             # waywallen.control: Qt Protobuf + ProtobufQuick
  libarchive           # bsdtar: unpacking .rar/.7z when importing Windows cursors
                       # (`importers::extract_other_archive`); on Arch pacman already has it
  xorg-server-xvfb     # invisible X server: snapshots of Conky widgets for tiles without
                       # showing them on screen, also on Wayland (`conky_preview`); without it —
                       # a placeholder. On SteamOS — the same package inside the Rexon sysext
  # The QExtra QML plugin (images and animations of the wallpaper tab).
  # ⚠️When the distribution bumps the ffmpeg major version, the package must
  # be rebuilt: the plugin records libavcodec.so.N and its siblings.
  ffmpeg               # frame decoder: libavcodec/avformat/avutil/swscale
  # With makepkg's LDFLAGS (--as-needed) these two do not end up in the
  # plugin's NEEDED — only their headers are needed at build time; without
  # --as-needed the plugin links against them too (libva.so.2,
  # libva-drm.so.2, libcurl.so.4).
  libva
  curl
)
if [[ $_bundled_engine == 1 ]]; then
  # Bundled engine (the default). We neither require the engine packages nor conflict with them:
  # the bundled files live in their own directories (/usr/lib/rexon/engine,
  # /usr/share/rexon/sources), and if both are installed the core uses the system one.
  depends+=(
    fuse3                # the AppImage runtime (type2-runtime) mounts the image
                         # via fusermount from PATH
    at-spi2-core         # OWE plugin: the web renderer's libcef.so links against
                         # libatk/libatspi (namcap: E: Dependency at-spi2-core)
    # The other libraries the OWE plugin binaries are linked against directly
    # (libcef.so, libGLESv2.so, the scene renderer). On a machine with
    # graphics they are already installed as transitive dependencies, but
    # direct dependencies are listed explicitly.
    nss nspr libcups expat systemd-libs mesa
    libx11 libxcb libxext libxfixes libxcomposite libxdamage libxrandr
    libxkbcommon cairo pango
    lz4 fontconfig freetype2 libva
  )
else
  # REXON_BUNDLED_ENGINE=0: the wallpaper engine as separate packages. The lower bounds are the versions
  # the vendored interface and protocol were checked against (see the
  # "Wallpaper engine" block below): a daemon older than 0.6.1 does not know
  # the control.proto fields the core sends.
  depends+=(
    "waywallen>=${_ww_min}"                 # the /usr/bin/waywallen daemon
    "open-wallpaper-engine>=${_owe_min}"    # Wallpaper Engine scene and web wallpapers
  )
fi
makedepends=(git glib2 rust
             cmake ninja protobuf qt6-shadertools
             # The QExtra QML plugin is built by the lito build tool (C++23
             # with modules — clang only, linked by lld). lito is not in the
             # Arch repositories (AUR only), so it is a source of this
             # package: build() builds it from the release source
             # (_lito_ver, block below) in $srcdir; it does not go into the
             # package. It is built by clang with libc++, zstd is the system
             # one. A ready lito can be given via the LITO variable — then
             # our own build is skipped.
             clang lld llvm libc++ zstd
             glslang vulkan-headers libpulse   # wavsen inside QExtra
             # Flash wallpapers: the build.rs of the ruffle_core crate builds
             # the built-in ActionScript 3 classes (playerglobal) with a Java
             # compiler and fails without `java` in PATH: "Java could not be
             # found on your computer". Needed only at build time; Java does
             # not go into the package.
             java-runtime-headless
             gettext)    # msgfmt: po/*.po → .mo interface translations (build.rs of
                         # rexon-gui); QML reads the same catalog — there is no separate .qm
# The bundled engine needs patchelf at build time: to strip the upstream
# build RUNPATH from the OWE renderers (_owe_fix_runpath).
if [[ $_bundled_engine == 1 ]]; then makedepends+=(patchelf); fi
checkdepends=(desktop-file-utils appstream)
optdepends=(
  'yt-dlp: YouTube wallpapers (streamed video as wallpaper)'
  'yay: install AUR themes from the Appearance tab (AeroThemePlasma etc.)'
  'xdg-terminal-exec: correct default terminal for GLib launches (AUR)'
  'kvantum: apply Kvantum themes (Qt style engine)'
  'vulkan-driver: Flash wallpapers (any GPU Vulkan driver: vulkan-radeon, vulkan-intel, nvidia-utils)'
  '7zip: fallback extraction of .7z/.rar cursor archives that bsdtar cannot open'
  'unrar: fallback extraction of RAR cursor archives that bsdtar and 7zip cannot open'
  'kwin: KDE window decoration preview (QML module org.kde.kwin.private.kdecoration)'
  'plasma-wallpaper-waywallen: live waywallen wallpapers on the Plasma desktop (AUR; Rexon installs it on KDE by itself)'
  'waywallen-display: Wallpaper Engine scenes on X11 desktops without Plasma (XFCE, MATE, Cinnamon on X11)'
)

conflicts=(rexon-git)
# The C++ parts of cxx-qt are built via cc with makepkg's CFLAGS: without
# !lto the static libraries contain only GIMPLE, and rustc cannot link them.
# This does not disable LTO for Rust itself: that is set by the release
# profile in rust/Cargo.toml (lto = true), makepkg flags do not affect it.
#
# !strip: with the bundled engine third-party files must ship untouched —
# ⛔ the AppImage (strip sees an ordinary ELF in it and cuts off the attached
# squashfs: 78 MiB → <1 MiB, the engine is dead) and the .so of the
# org.waywallen.kde plasmoid, bit for bit as in the release (the core
# recognizes its version by its hash, KNOWN_RUNTIME_SHA). makepkg's strip has
# no exclusion list (it only skips files without owner write permission —
# removing u+w from third-party files for that was rejected), so package()
# strips our own binaries itself (_strip_own_binaries). !debug follows:
# makepkg builds the debug package only together with strip.
options=('!lto' '!strip' '!debug')
# post_remove: remove the login screen safeguard from /etc (see the file itself).
install=rexon.install

# ── Wallpaper engine ─────────────────────────────────────────────────
# By default (since 2026-11-02) the engine is BUNDLED — see the "Bundled
# engine" block below: the `waywallen` and `open-wallpaper-engine` packages
# are not in the Arch and CachyOS repositories, and a release package
# depending on them could not be installed there.
# The REXON_BUNDLED_ENGINE=0 variant (the main one from 2026-10-30 to
# 2026-11-02) depends on these packages instead of the bundle — the package
# manager keeps them up to date. Where they install files and how the core
# finds them — `we_client::SYSTEM_DAEMON` and `we_client::SYSTEM_ENGINE_DIR`
# (the daemon from /usr/bin finds /usr/share/waywallen/plugins on its own,
# it does not need the --plugin flag). If both are installed, the core uses
# the system one.
#
# The lower version bounds are not a formality, they are tied to the vendored
# parts of the tree:
#   * _ww_min — the tag the control plane protocol
#     (data/qt_wallpaper_engine/proto/UPSTREAM_TAG) and the vendored tab
#     interface were taken from; prepare() fails if they diverge. With an
#     older daemon the core would send fields it does not know;
#   * _owe_min — the plugin checked against the _ww_min daemon: entry_version 5,
#     spawn_version 10 (the plugin contract of daemon 0.6.1:
#     SUPPORTED_ENTRY_VERSIONS = [3..8], SPAWN_VERSION = 10, bridge — protocol
#     3; checked against the upstream tags on 2026-11-23).
# There are no upper bounds on purpose: upstream's plugin contract and
# control.proto grow by additions, and a ceiling in depends would block the
# whole system upgrade. A daemon newer than the checked one is visible in
# Rexon: the protocol check badge (`we_parity`) and the plasmoid's output
# protocol table (`waywallen_kde_plugin::DAEMON_PROTOCOLS_CHECKED_UP_TO`) —
# outside the table the plasmoid is not installed over a newer daemon and
# does not guess compatibility.
#
# The org.waywallen.kde plasmoid is the plasma-wallpaper-waywallen
# distribution package (AUR, split package of waywallen-display), and it is
# an optdepends, not a dependency: it pulls in libplasma, kirigami and
# plasma-workspace, i.e. all of Plasma onto any desktop. On KDE Rexon installs
# it by itself when it is missing (owner's decision of 2026-11-25), never puts
# its own copy over it, and moves its older copy out of ~/.local/share (a copy
# there hides the package). The X11 output host takes the Waywallen.Display
# QML module of waywallen-display (no Plasma). The daemon and the plasmoid
# speak output protocol v9: waywallen-display 0.4.6 (checked 2026-11-25) fits
# daemon 0.6.1 (display protocol still 9..9, checked 2026-11-23).
# ⚠️The daemon's database only migrates forward: a daemon that has ever been
# run in a newer version leaves a database an older one cannot start on — an
# engine rollback only together with the database.
# (_ww_min and _owe_min are set above depends: bash expands the array at once.)
# Bundled engine variant only: the org.waywallen.kde Plasma wallpaper plugin
# is the official waywallen-display release archive, installed UNMODIFIED
# (no patches of ours on top), and the daemon and the plasmoid are updated
# ONLY together (plasmoid 0.4.5 checked 2026-11-08 against daemon 0.6.1).
# The version and checksum are also recorded in
# data/kpackage/org.waywallen.kde/vendor.toml; `vendor-check` turns red if
# they diverge between here and there, or if the checksum does not match the
# release digest on GitHub.
# ${CARCH} in file names is always x86_64 (arch above): that is how upstream
# names its releases.
_wwd_ver=0.4.5
# Since 0.4.5 the archive has no "-embed" suffix (waywallen-display 4bbbfcc),
# the contents are the same.
_wwd_zip="waywallen-kde-${_wwd_ver}-${CARCH}.zip"

# ── Bundled engine (the default, REXON_BUNDLED_ENGINE=1) ─────────────
# The release package for Arch and CachyOS, Steam, manual installation —
# everywhere the waywallen and open-wallpaper-engine packages are missing.
# The directory is the core's `we_client::ENGINE_DIR`: the daemon AppImage
# with plugins/<id>/ next to it; it is passed to the daemon with the
# --plugin flag, and the daemon looks for plugins in <directory>/plugins/
# (checked by app_parity.rs). The core uses this layout only if there is no
# system engine (`we_client::engine_layouts`).
# The versions are pinned: the daemon and the org.waywallen.kde plasmoid are
# updated ONLY together, and the OWE plugin must fit the daemon
# (entry_version 4, spawn_version 10 — checked by git diff of the tags, see
# the block above). The AppImage is exactly the tag the protocol and the
# vendored interface were taken from (_ww_ver = proto/UPSTREAM_TAG,
# prepare() checks this), the plugin is not older than _owe_min. When
# changing one of the versions, check the other two.
_ww_ver=0.6.1
_ww_appimage="waywallen-${_ww_ver}-${CARCH}.AppImage"
_owe_ver=0.3.4
_owe_commit=5dd7b4cfb38fe21c64e9c036bbd89ae5b866b49e   # tag v0.3.4
_owe_id=org.waywallen.open-wallpaper-engine
_owe_zip="${_owe_id}-${_owe_ver}-linux-${CARCH}.zip"

# The complete OWE source (GPL-2.0-only §3(a)). The tag has no git
# submodules, but the build pulls dependencies with its own lito build
# tool: their list, revisions and checksums are the tag's lito.lock,
# exported with `lito lock export --format flatpak-sources`. Everything
# compiled into the plugin binaries ships in the source archive: git
# dependencies by commit and lito registry packages by the checksum from
# lito.lock. The layout inside the archive is the same as lito's portable
# source set (.lito/source-bundle/v1/).
# git: name|url|commit|lito bundle directory
_owe_git=(
