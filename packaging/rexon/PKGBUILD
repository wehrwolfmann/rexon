        "${_wwd_zip}::https://github.com/waywallen/waywallen-display/releases/download/v${_wwd_ver}/${_wwd_zip}")
_e=
for _e in "${_qe_git[@]}"; do
  IFS='|' read -r _n _u _c <<<"$_e"
  source+=("qextra-src-${_n}::git+${_u}#commit=${_c}")
done
for _e in "${_qe_reg[@]}"; do
  IFS='|' read -r _n _v _ <<<"$_e"
  source+=("lito-${_n}-${_v}.tar.zst::https://registry.litocpp.org/packages/${_n}/${_n}-${_v}.tar.zst")
done
# Распаковывает модель prepare() сам: у makepkg встроенная распаковка .gz
# кладёт файл рядом с архивом в $srcdir, а ядру нужны имена БЕЗ префикса
# редакции и в каталоге направления.
noextract=("${_mt_tag:0:8}-${_mt_model}.gz"
           "${_mt_tag:0:8}-${_mt_vocab}.gz"
           "${_wwd_zip}")         # распаковывает package(): прямо в каталог данных
for _e in "${_qe_reg[@]}"; do
  IFS='|' read -r _n _v _ <<<"$_e"
  noextract+=("lito-${_n}-${_v}.tar.zst")   # распаковывает сам lito из набора
done
sha256sums=('SKIP'
            'SKIP'
            '143e9b3d74c73e856478680149d51015e9cb37263510c6fce9e8c840166fb755'
            '78edd47b5b770f4c14bafda458214c2ea07bbaf2add54919dbcfcfaf5d2729e5'
            '7ad2da5886792f7169fa73728e86bf1dc165afd88aa2741d27a4112051b64c72'
            '72d77058be3c7f5b1a729ac3470daae79efea6a47a04b3a3fd11a76a0d410f62'
            '22663f2633246da809ba5e3b08161e774117135500c22664a17352c10eb1db34'
            '3c6e3ffd275c96a220ae28ddb55b8c2b86b44ffecc1eeb6c8195c1536de4ac74'
            '07ed9055319f2adc50a16bc7e636fe1547ab745eb986e40b6384956dc1fc6cfd'
            'dd5bb9934e2c0fb0ead14960571cd3fb84b66dbde3266cef81e4ab7ea8e51edb') # плазмоид (= digest выпуска)
for _e in "${_qe_git[@]}"; do sha256sums+=('SKIP'); done    # прибиты коммитами
for _e in "${_qe_reg[@]}"; do
  IFS='|' read -r _ _ _s <<<"$_e"
  sha256sums+=("$_s")
