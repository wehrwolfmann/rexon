# The lito build tool (litocpp/lito, MIT OR Apache-2.0) is only for building
# QExtra and does not go into the package. It is not in the Arch
# repositories, and a makedepends on an AUR package would stop
# `makepkg -s` for distribution maintainers, so it is built right here from
# the release source — with the same cmake recipe as the lito package in
# the AUR, offline (dependencies are the sources below, revisions come from
# the tag's deps.json). Not older than 0.8.7: the wavsen 7564374 manifest
# (QExtra b3fd790, waywallen 0.5.0) carries a `condition` field on a
# dependency that 0.8.5 cannot parse; tools/build_qml_qextra.sh rejects
# such a lito itself. When changing the version, rewrite the commits from
# the new tag's deps.json.
_lito_ver=0.8.8
_lito_commit=66ee45dcfc77391b51fe63a6bd8cece8e6e345e4   # tag v0.8.8
# name|url|commit (the tag's deps.json; zstd is the system one, LITO_USE_SYSTEM_ZSTD)
_lito_deps=(
  'rstd|https://github.com/litocpp/rstd.git|05748d842307476dd86dfa14237838295cb5ec77'
  'luato|https://github.com/litocpp/luato.git|df0c6f2d1cce2051b4711d36067619eda7933683'
  'licrypto|https://github.com/litocpp/licrypto.git|1199a8fe2b119774a85adbd33043fc5ef7b20d3c'
)

# The Material Symbols fonts are stored in the QmlMaterial repository as
# git-lfs pointers, so the real files are downloaded as separate sources —
# network is used only at the download step, the build runs without it. The
# checksums are sha256 of the files themselves (they match the oids from the
# git-lfs pointers).
_qm_fonts=(MaterialSymbolsRounded.wght_400.opsz_24.fill_0.ttf
           MaterialSymbolsRounded.wght_400.opsz_24.fill_0.woff2
           MaterialSymbolsRounded.wght_400.opsz_24.fill_1.ttf
           MaterialSymbolsRounded.wght_400.opsz_24.fill_1.woff2
           MaterialSymbolsRounded.wght_400.opsz_24.woff2)

# The en→ru translation model for appearance descriptions — the
# implementation of Firefox's translation engine (fxtranslate) loads its
# files as is. The maintainer decided to ship the model IN THE PACKAGE
# rather than download it on demand: translation must work right after
# installation and without network. The cost is 43.9 MB in the package for
# a 31 MB download.
#
# The revision is pinned down hard: the Mozilla bucket, the `base`
# architecture, status "Release Desktop" (⛔NOT `base-memory`/Release
# Android — it is worse by 0.34 chrF++). The `lex.50.50.enru.s2t.bin`
# shortlist is deliberately NOT shipped: measured on 2026-09-20 — minus 0.4
# chrF++ and plus 2.8 MB for a speed-up that is not noticeable on short
# descriptions (see also translator_engine::model_files_in).
#
# Checksums: sha256sums below are of the DOWNLOADED archives, `_mt_*_sum` of
# the unpacked files (checked against the `uncompressedHash` field of the
# Mozilla `models.json` registry). The second check is not redundant: the
# unpacked file goes into the package, and makepkg would no longer catch
# corruption during unpacking.
_mt_pair=enru
_mt_tag=AYqN3ysXRp2EGkEqeaA5Rg
_mt_model="model.${_mt_pair}.intgemm.alphas.bin"
_mt_vocab="vocab.${_mt_pair}.spm"
_mt_model_sum=0ef9a209c5edc46692750e7505b3695655b1c7c3ec73058b641201ef18c481ce
_mt_vocab_sum=56ee63e14e8cb926c394242adc3ed7cc602644c3d33058cff2ce2959d52a6258
_mt_base="https://storage.googleapis.com/moz-fx-translations-data--303e-prod-translations-data"
_mt_url="${_mt_base}/models/en-ru/student_base_${_mt_tag}/exported"

# The release is the signed v${pkgver} tag; makepkg verifies the signature with the key from validpgpkeys.
_giturl="git+https://github.com/wehrwolfmann/rexon.git#tag=v${pkgver}?signed"
validpgpkeys=('B4505C7C7841ECC12D7A0E9D0083083C32159A72') # Wehrwolfmann <256216494+wehrwolfmann@users.noreply.github.com>
_qm_media="https://media.githubusercontent.com/media/hypengw/QmlMaterial/${_qm_pin}/assets"
source=("rexon::${_giturl}"
        "QmlMaterial::git+https://github.com/hypengw/QmlMaterial.git#commit=${_qm_pin}"
        "${_qm_pin:0:12}-${_qm_fonts[0]}::${_qm_media}/${_qm_fonts[0]}"
        "${_qm_pin:0:12}-${_qm_fonts[1]}::${_qm_media}/${_qm_fonts[1]}"
        "${_qm_pin:0:12}-${_qm_fonts[2]}::${_qm_media}/${_qm_fonts[2]}"
        "${_qm_pin:0:12}-${_qm_fonts[3]}::${_qm_media}/${_qm_fonts[3]}"
        "${_qm_pin:0:12}-${_qm_fonts[4]}::${_qm_media}/${_qm_fonts[4]}"
        "${_mt_tag:0:8}-${_mt_model}.gz::${_mt_url}/${_mt_model}.gz"
        "${_mt_tag:0:8}-${_mt_vocab}.gz::${_mt_url}/${_mt_vocab}.gz")
_e=
for _e in "${_qe_git[@]}"; do
  IFS='|' read -r _n _u _c <<<"$_e"
  source+=("qextra-src-${_n}::git+${_u}#commit=${_c}")
done
for _e in "${_qe_reg[@]}"; do
  IFS='|' read -r _n _v _ <<<"$_e"
  source+=("lito-${_n}-${_v}.tar.zst::https://registry.litocpp.org/packages/${_n}/${_n}-${_v}.tar.zst")
done
source+=("lito::git+https://github.com/litocpp/lito.git#commit=${_lito_commit}")
for _e in "${_lito_deps[@]}"; do
  IFS='|' read -r _n _u _c <<<"$_e"
  source+=("lito-dep-${_n}::git+${_u}#commit=${_c}")
done
# prepare() unpacks the model itself: makepkg's built-in .gz extraction puts
# the file next to the archive in $srcdir, while the core needs the names
# WITHOUT the revision prefix and inside the direction directory.
noextract=("${_mt_tag:0:8}-${_mt_model}.gz"
           "${_mt_tag:0:8}-${_mt_vocab}.gz")
for _e in "${_qe_reg[@]}"; do
  IFS='|' read -r _n _v _ <<<"$_e"
  noextract+=("lito-${_n}-${_v}.tar.zst")   # lito unpacks it itself from the source set
done
sha256sums=('SKIP'
            'SKIP'
            '143e9b3d74c73e856478680149d51015e9cb37263510c6fce9e8c840166fb755'
            '78edd47b5b770f4c14bafda458214c2ea07bbaf2add54919dbcfcfaf5d2729e5'
            '7ad2da5886792f7169fa73728e86bf1dc165afd88aa2741d27a4112051b64c72'
            '72d77058be3c7f5b1a729ac3470daae79efea6a47a04b3a3fd11a76a0d410f62'
            '22663f2633246da809ba5e3b08161e774117135500c22664a17352c10eb1db34'
            '3c6e3ffd275c96a220ae28ddb55b8c2b86b44ffecc1eeb6c8195c1536de4ac74'
            '07ed9055319f2adc50a16bc7e636fe1547ab745eb986e40b6384956dc1fc6cfd')
for _e in "${_qe_git[@]}"; do sha256sums+=('SKIP'); done    # pinned by commits
for _e in "${_qe_reg[@]}"; do
  IFS='|' read -r _ _ _s <<<"$_e"
  sha256sums+=("$_s")
done
sha256sums+=('SKIP')                                             # lito — pinned by commit
for _e in "${_lito_deps[@]}"; do sha256sums+=('SKIP'); done    # pinned by commits

# The bundled engine sources go at the end of the arrays: the
# REXON_BUNDLED_ENGINE=0 variant differs from the default (and .SRCINFO)
# only in the tail.
if [[ $_bundled_engine == 1 ]]; then
  source+=("${_ww_appimage}::https://github.com/waywallen/waywallen/releases/download/v${_ww_ver}/${_ww_appimage}"
           "waywallen-${_ww_ver}-LICENSE::https://raw.githubusercontent.com/waywallen/waywallen/v${_ww_ver}/LICENSE"
           "${_owe_zip}::https://github.com/waywallen/open-wallpaper-engine/releases/download/v${_owe_ver}/${_owe_zip}"
           "open-wallpaper-engine::git+https://github.com/waywallen/open-wallpaper-engine.git#commit=${_owe_commit}"
           "${_cef_archive}::${_cef_url}")
  sha256sums+=('dd1c58c7eacdee1291fc3ad9b0e0bcd864d6b5feb1c5065b8ab17378d176e62d'  # AppImage (= GitHub release digest)
               '2d1edaf74e77c63e166ed948c2fee17a50dd15f73d8e9db249117e5fde8bef24'  # MIT waywallen
               '94db107147c62ca29a1b44ca99a32d809ed9f0f889f381ca268f66e9cd087ae2'  # OWE plugin (= release digest)
               'SKIP'                                                              # OWE git — pinned by commit
               "$_cef_sha")
  noextract+=("${_owe_zip}"          # unpacked by prepare(): into its own directory
              "${_cef_archive}")     # of its 300 MB only the wrapper sources are needed
  source+=("${_wwd_zip}::https://github.com/waywallen/waywallen-display/releases/download/v${_wwd_ver}/${_wwd_zip}")
  sha256sums+=('dfcb0ea49e87e42d395f27a6278c21f5564ae2f6e02dbc5cc5e6ff9565459d41')  # plasmoid (= release digest)
  noextract+=("${_wwd_zip}")         # unpacked by package(): straight into the data directory
  for _e in "${_owe_git[@]}"; do
    IFS='|' read -r _n _u _c _ <<<"$_e"
    source+=("owe-dep-${_n}::git+${_u}#commit=${_c}")
    sha256sums+=('SKIP')            # pinned by commits
  done
  # A registry archive that already ships as a source for QExtra (same name
  # and same checksum) is not named a second time: makepkg does not accept
  # two sources with the same file name.
  for _e in "${_owe_reg[@]}"; do
    [[ " ${_qe_reg[*]} " == *" ${_e} "* ]] && continue
    IFS='|' read -r _n _v _s <<<"$_e"
    source+=("lito-${_n}-${_v}.tar.zst::https://registry.litocpp.org/packages/${_n}/${_n}-${_v}.tar.zst")
    sha256sums+=("$_s")
    noextract+=("lito-${_n}-${_v}.tar.zst")   # go into the source archive as is
  done
fi
unset _e _n _u _c _v _s


prepare() {
  if [[ $_bundled_engine != [01] ]]; then
    echo "ERROR: REXON_BUNDLED_ENGINE=${REXON_BUNDLED_ENGINE} — allowed values are 0 (engine from system packages) or 1 (bundled)" >&2
    return 1
  fi
  # The core recognizes packaged mode in two ways: REXON_PACKAGED from the
  # /usr/bin/rexon launcher (installer::detect_default_mode) and the location
  # of its own file under /usr — thanks to it the first-run wizard stays
  # silent even for a desktop entry that calls the window binary directly
  # (installer::packaged_location).
  # The Qcm.Material pin must match the one written next to the vendor code.
  local pinfile="$srcdir/rexon/data/qt_wallpaper_engine/qml_ui/waywallen/ui/QML_MATERIAL_PIN"
  local want
  want=$(tr -d '[:space:]' < "$pinfile")
  if [[ "$want" != "$_qm_pin" ]]; then
    echo "ERROR: _qm_pin=$_qm_pin lags behind the vendor code ($want) — update the source and sha256" >&2
    return 1
  fi

  # The QExtra sources must be exactly those pinned in the wrapper's
  # lito.lock: the build runs with --frozen and would reject an extra or
  # missing package only after half an hour of building Rust — here it is
  # visible at once.
  local lock="$srcdir/rexon/tools/qextra_plugin/lito.lock" e n u c v
  for e in "${_qe_git[@]}"; do
    IFS='|' read -r n u c <<<"$e"
    grep -qxF "source = \"git+${u}#${c}\"" "$lock" || {
      echo "ERROR: _qe_git: $n@$c is not in tools/qextra_plugin/lito.lock — update the list and checksums" >&2
      return 1
    }
  done
  for e in "${_qe_reg[@]}"; do
    IFS='|' read -r n v c <<<"$e"
    grep -qxF "checksum = \"$c\"" "$lock" || {
      echo "ERROR: _qe_reg: $n $v ($c) is not in tools/qextra_plugin/lito.lock — update the list and checksums" >&2
      return 1
    }
  done
  if (( $(grep -c '^source = ' "$lock") != ${#_qe_git[@]} + ${#_qe_reg[@]} )); then
    echo "ERROR: tools/qextra_plugin/lito.lock has a different number of sources than _qe_git and _qe_reg" >&2
    return 1
  fi
  # lito: the source of exactly that release, and its dependencies are the
  # revisions from the tag's deps.json (the same ones FetchContent would
  # fetch from the network).
  grep -qx "  VERSION ${_lito_ver}" "$srcdir/lito/CMakeLists.txt" || {
    echo "ERROR: the lito source is not version $_lito_ver — check _lito_ver and _lito_commit" >&2
    return 1
  }
  for e in "${_lito_deps[@]}"; do
    IFS='|' read -r n u c <<<"$e"
    grep -qF "\"rev\": \"$c\"" "$srcdir/lito/deps.json" || {
      echo "ERROR: _lito_deps: $n@$c is not in deps.json of lito $_lito_ver — rewrite the revisions" >&2
      return 1
    }
  done
  # The QExtra build script rejects a build directory whose path is not pure
  # Latin (lito used to crash on such paths) — say so before building Rust,
  # not after.
  if LC_ALL=C grep -q '[^ -~]' <<<"$srcdir"; then
    echo "ERROR: the build directory must be an ASCII-only path (BUILDDIR): $srcdir" >&2
    return 1
  fi

  # Real fonts instead of git-lfs pointers: then tools/build_qml_material.sh
  # downloads nothing and builds offline.
  local f
  for f in "${_qm_fonts[@]}"; do
    cp "$srcdir/${_qm_pin:0:12}-$f" "$srcdir/QmlMaterial/assets/$f"
  done

  # Translation model: unpack INTO THE DIRECTION DIRECTORY and verify the
  # checksum of the UNPACKED file — that is the one that goes into the package.
  local mt="$srcdir/translate/$_mt_pair"
  install -d "$mt"
  gzip -dc "$srcdir/${_mt_tag:0:8}-${_mt_model}.gz" > "$mt/$_mt_model"
  gzip -dc "$srcdir/${_mt_tag:0:8}-${_mt_vocab}.gz" > "$mt/$_mt_vocab"
  printf '%s  %s\n%s  %s\n' \
    "$_mt_model_sum" "$mt/$_mt_model" \
    "$_mt_vocab_sum" "$mt/$_mt_vocab" | sha256sum --check --quiet || return 1

  # The daemon's lower bound in depends is the tag the protocol and the
  # vendored interface were taken from: if the vendor code were updated but
  # the bound forgotten, the package would promise to work with a daemon the
  # core no longer understands.
  local tag
  tag=$(awk 'NR==1{print $1}' "$srcdir/rexon/data/qt_wallpaper_engine/proto/UPSTREAM_TAG")
  # One guard for both variants: the system package must be no older than
  # the tag, the bundled AppImage must be exactly this tag.
  if [[ "$tag" != "v$_ww_min" ]]; then
    echo "ERROR: _ww_min=$_ww_min, but the protocol was taken from $tag (proto/UPSTREAM_TAG) — check depends" >&2
    return 1
  fi
  if [[ $_bundled_engine == 1 && "$tag" != "v$_ww_ver" ]]; then
    echo "ERROR: bundled AppImage _ww_ver=$_ww_ver, but the protocol was taken from $tag (proto/UPSTREAM_TAG) — update _ww_ver and sha256" >&2
    return 1
  fi
  if [[ $_bundled_engine == 1 ]] && (( $(vercmp "$_owe_ver" "$_owe_min") < 0 )); then
    echo "ERROR: bundled OWE plugin $_owe_ver is older than _owe_min=$_owe_min" >&2
    return 1
  fi
  if [[ $_bundled_engine == 1 ]]; then
    _owe_prepare || return 1
  fi

  # Crates are downloaded here; after that the build runs offline (--frozen).
  cd "$srcdir/rexon/rust"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$srcdir/rexon/rust"
  export CARGO_TARGET_DIR="$srcdir/rexon/rust/target"

  # ── Build paths do not leak out ─────────────────────────────────
  # Without this map the finished binaries keep absolute paths of the build
  # machine, and makepkg complains "Package contains reference to
  # '$srcdir'". There are TWO sources, and they are fixed by different flags:
  #   * rustc prints the file path into the panic metadata (`core::panic::
  #     Location`) — that gives ~250 strings per binary with crate paths from
  #     $CARGO_HOME/registry and the path of `waywallen.control.v1.rs`
  #     generated by prost in OUT_DIR;
  #   * gcc substitutes __FILE__ into the Q_ASSERTs of the cxx-qt headers,
  #     which cxx-qt-build puts into OUT_DIR and includes with an absolute -I
  #     (qlist_private.h, qmap_private.h, cxx-qt/thread.h).
  # There is no debug info in the release build at all (the profile's
  # `debug` is off), so this is NOT it — the strings live in .rodata and are
  # not removed by strip.
  #
  # Cargo's standard `trim-paths` profile option does not work here: in
  # cargo 1.98 it is not stabilized yet ("feature `trim-paths` is required …
  # not stabilized in this version of Cargo", the unstable `-Z trim-paths`
  # is needed). So the map is given by hand to both halves — rustc via
  # --remap-path-prefix, gcc via -ffile-prefix-map (which also fixes
  # __FILE__, not just debug info).
  #
  # The dev profile is not affected: the variables live only inside the
  # package's build(), and a local debug build still finds its sources.
  local _cargo_home="${CARGO_HOME:-$HOME/.cargo}"
  local _remap="-ffile-prefix-map=$srcdir=/usr/src/rexon"
  _remap+=" -ffile-prefix-map=$_cargo_home=/usr/src/cargo"
  export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }--remap-path-prefix=$srcdir=/usr/src/rexon --remap-path-prefix=$_cargo_home=/usr/src/cargo"
  export CFLAGS="$CFLAGS $_remap"
  export CXXFLAGS="$CXXFLAGS $_remap"

  # The packages are named with -p: rust/Cargo.toml has
  # `default-members = ["rexon-core"]`, and a bare `cargo build --release`
  # would build only the core. The set is the same as the `cargo build-app`
  # alias.
  # Flash wallpapers with sound (host mode --mode swf, Ruffle) are the
  # `swf-sound` feature of rexon-gui, enabled by default: the wallpaper
  # volume is shared by video and Flash, and a silent build would mean a
  # slider that does nothing for half of the wallpapers.
  cargo build --frozen --release -p rexon-core -p rexon-gui -p rexon-qt-filter
  # The login splash is a separate run, like `cargo build-splash`: in a
  # shared run the feature unification would change and rexon-gui would be
  # built twice.
  cargo build --frozen --release -p rexon-splash-overlay

  # The desktop entries are printed by the core's generator — the entry point to
  # the Rust window at the package path. The package has no static copies:
  # the previous one fell behind the generator and left a desktop entry pointing
  # at the Python entry point.
  target/release/desktop-entry --package > "$srcdir/rexon.desktop"
  target/release/desktop-entry --package --recover > "$srcdir/rexon-recover.desktop"

  # ── QML plugins of the Wallpaper Engine tab ─────────────────────
  # The first two are mandatory: without them `qml_modules::qml_plugins_ready` says "no",
  # and the vendored pages do not load either in the Rust window or in the classic one.
  # Built with the same tools/ scripts the developer uses (a second copy of
  # the cmake commands would silently drift apart from them), but the source
  # and fonts are fed to them from $srcdir, and the build directories are
  # moved there as well — they touch neither the network nor $HOME.
  # C++ build jobs come from MAKEFLAGS in makepkg.conf (-jN / --jobs=N):
  # `cmake --build` does not read MAKEFLAGS (Ninja generator), neither does
  # lito. Without this cmake and lito use all cores, and with LTO on 8 GB of
  # RAM the build was killed by OOM (cc1plus on control.qpb.cpp). Variables
  # set explicitly are left alone.
  local _jobs
  _jobs=$(grep -oE '(^|[[:space:]])(-j[[:space:]]*|--jobs[=[:space:]]+)[0-9]+' \
    <<<"${MAKEFLAGS:-}" | grep -oE '[0-9]+$' | tail -n1 || true)
  if [[ -n $_jobs ]]; then
    export CMAKE_BUILD_PARALLEL_LEVEL="${CMAKE_BUILD_PARALLEL_LEVEL:-$_jobs}"
    export QEXTRA_JOBS="${QEXTRA_JOBS:-$_jobs}"
  fi
  export CARGO_NET_OFFLINE=true
  QML_MATERIAL_SRC="$srcdir/QmlMaterial" QML_MATERIAL_PIN="$_qm_pin" \
    bash "$srcdir/rexon/tools/build_qml_material.sh" "$srcdir/qml_modules"
  QML_CONTROL_BUILD="$srcdir/qml_control-build" \
    bash "$srcdir/rexon/tools/build_qml_control.sh" "$srcdir/qml_modules"

  # The third one is the real QExtra (without it the tab runs on a QML stand-in);
  # it is built by lito, and lito is built first (unless given via the LITO variable).
  _lito_build
  _qextra_build

  if [[ $_bundled_engine == 1 ]]; then
    _owe_source_bundle
  fi
}

# Bundled engine: the OWE plugin goes into its own directory (the zip root
# has bin/, lib/, main.lua). The version inside must match the pinned one:
# otherwise the package would ship a plugin other than the one whose
# compatibility with the daemon was checked.
_owe_prepare() {
  rm -rf "$srcdir/owe-plugin"
  install -d "$srcdir/owe-plugin"
  bsdtar --no-same-owner -xf "$srcdir/$_owe_zip" -C "$srcdir/owe-plugin"
  grep -qx "id = \"$_owe_id\"" "$srcdir/owe-plugin/plugin.toml" \
    && grep -qx "version = \"$_owe_ver\"" "$srcdir/owe-plugin/plugin.toml" || {
    echo "ERROR: $_owe_zip does not contain $_owe_id $_owe_ver" >&2
    return 1
  }
  # Source of the same tag: the workspace version in lito.toml is the same as the plugin's.
  grep -q "^version = \"$_owe_ver\"" "$srcdir/open-wallpaper-engine/lito.toml" || {
    echo "ERROR: the OWE source is not version $_owe_ver" >&2
    return 1
  }
}

# Archive of the complete source of the OWE plugin (GPL-2.0-only §3(a)): tag
# v${_owe_ver} + everything lito pulls into the build + the CEF wrapper
# sources. Without .git: the revisions are recorded in SOURCES.txt and in
# the tag's own lito.lock. The archive is reproducible: name order, owner
# and file times are fixed.
_owe_source_bundle() {
  local top="open-wallpaper-engine-${_owe_ver}"
  local root="$srcdir/owe-src/$top"
  local bundle="$root/.lito/source-bundle/v1"
  local e n u c d v
  rm -rf "$srcdir/owe-src"
  install -d "$root" "$bundle/git" "$bundle/registry/source" "$root/third_party-cef"
  git -C "$srcdir/open-wallpaper-engine" archive --format=tar "$_owe_commit" | tar -x -C "$root"
  for e in "${_owe_git[@]}"; do
    IFS='|' read -r n u c d <<<"$e"
    install -d "$bundle/git/$d"
    git -C "$srcdir/owe-dep-$n" archive --format=tar "$c" | tar -x -C "$bundle/git/$d"
  done
  for e in "${_owe_reg[@]}"; do
    IFS='|' read -r n v c <<<"$e"
    install -m644 "$srcdir/lito-$n-$v.tar.zst" \
      "$bundle/registry/source/$n-$v-${c:0:16}.tar.zst"
  done
  bsdtar --no-same-owner -xf "$srcdir/$_cef_archive" -C "$root/third_party-cef" \
    --include '*/include/*' --include '*/libcef_dll/*' --include '*/cmake/*' \
    --include '*/CMakeLists.txt' --include '*/LICENSE.txt' --include '*/README.txt'
  {
    echo "Open Wallpaper Engine ${_owe_ver} — complete source for the binaries of the"
    echo "${_owe_id} plugin in the Rexon package (/usr/lib/rexon/engine/plugins/)."
    echo "License: GPL-2.0-only (LICENSE in the root)."
    echo
    echo "Source: https://github.com/waywallen/open-wallpaper-engine commit ${_owe_commit} (tag v${_owe_ver})."
    echo "Build dependencies (the tag's lito.lock), layout .lito/source-bundle/v1/:"
    for e in "${_owe_git[@]}"; do
      IFS='|' read -r n u c d <<<"$e"
      echo "  git/$d  $u @ $c"
    done
    for e in "${_owe_reg[@]}"; do
      IFS='|' read -r n v c <<<"$e"
      echo "  registry/source/$n-$v-${c:0:16}.tar.zst  https://registry.litocpp.org/ sha256 $c"
    done
    echo "third_party-cef/: sources of the libcef_dll_wrapper and CEF headers (BSD-3-Clause)"
    echo "  from $_cef_url"
    echo "  sha256 $_cef_sha; the binary part of CEF (libcef.so and resources) is inside the plugin itself."
    echo
    echo "Build: see BUILD.md (the lito build tool, https://github.com/hypengw/lito)."
  } > "$root/SOURCES.txt"
  tar --sort=name --owner=0 --group=0 --numeric-owner --mtime='@0' \
    -C "$srcdir/owe-src" -cf - "$top" | xz -T0 -9 > "$srcdir/owe-src/$top-src.tar.xz"
}

# Building lito from source — the recipe of the lito AUR package: clang +
# libc++, no LTO, FetchContent dependencies from $srcdir (offline), system
# zstd. _FORTIFY_SOURCE is removed: with it glibc declares open/openat as
# inline wrappers, and the rstd C++ modules do not export them (the same
# case as in tools/build_qml_qextra.sh). Installed into $srcdir/lito-root,
# it does not go into the package; _qextra_source_bundle and the build
# script then use it via LITO.
_lito_build() {
  if [[ -n ${LITO:-} ]]; then
    echo "lito given via LITO=$LITO — our own build skipped"
    return 0
  fi
  local t cflags=() cxxflags=()
  for t in $CFLAGS; do
    [[ $t == *_FORTIFY_SOURCE* ]] || cflags+=("$t")
  done
  for t in $CXXFLAGS; do
    [[ $t == *_FORTIFY_SOURCE* ]] || cxxflags+=("$t")
  done
  CFLAGS="${cflags[*]}" CXXFLAGS="${cxxflags[*]}" \
  cmake -B "$srcdir/lito-build" -S "$srcdir/lito" -G Ninja -Wno-dev \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_C_COMPILER=clang \
    -DCMAKE_CXX_COMPILER=clang++ \
    -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
    -DFETCHCONTENT_SOURCE_DIR_RSTD="$srcdir/lito-dep-rstd" \
    -DFETCHCONTENT_SOURCE_DIR_LUATO="$srcdir/lito-dep-luato" \
    -DFETCHCONTENT_SOURCE_DIR_LICRYPTO="$srcdir/lito-dep-licrypto" \
    -DLITO_USE_SYSTEM_ZSTD=ON
  cmake --build "$srcdir/lito-build"
  rm -rf "$srcdir/lito-root"
  DESTDIR="$srcdir/lito-root" cmake --install "$srcdir/lito-build" >/dev/null
  export LITO="$srcdir/lito-root/usr/bin/lito"
  "$LITO" --version
}

# A lito source set for building QExtra offline. The layout is the one lito
# exports from the lock file itself (`lito lock export --format
# flatpak-sources`): a git source is a working copy at the pinned commit in
# v1/git/<name>, a registry archive is
# v1/registry/source/<package>-<version>-<16 chars of checksum>.tar.zst.
# The git directory name is computed by lito, so it is not recorded here but
# asked from lito itself: the export does not need network.
_qextra_source_bundle() {
  local bundle="$srcdir/qextra-bundle" map="$srcdir/qextra-sources.json"
  local e n u c v d
  rm -rf "$bundle"
  install -d "$bundle/v1/git" "$bundle/v1/registry/source"
  XDG_DATA_HOME="$srcdir/qextra-data" "${LITO:-lito}" \
    -C "$srcdir/rexon/tools/qextra_plugin" \
    lock export --format flatpak-sources --output "$map"
  for e in "${_qe_git[@]}"; do
    IFS='|' read -r n u c <<<"$e"
    d=$(grep -A1 -F "\"commit\": \"$c\"" "$map" | grep -oE 'v1/git/[0-9a-f]{64}' | head -1 || true)
    [[ -n "$d" ]] || {
      echo "ERROR: lito did not name a source set directory for $n@$c ($map)" >&2
      return 1
    }
    cp -a "$srcdir/qextra-src-$n" "$bundle/$d"
  done
  for e in "${_qe_reg[@]}"; do
    IFS='|' read -r n v c <<<"$e"
    install -m644 "$srcdir/lito-$n-$v.tar.zst" \
      "$bundle/v1/registry/source/$n-$v-${c:0:16}.tar.zst"
  done
}

# Building the real QExtra with the same script the developer uses. It needs
# no network: the sources come from the set above, lito's own data directory
# (unpacked registry archives) is moved from $HOME to $srcdir. makepkg flags
# and the path map from build() reach clang via `lito --use-env-flags` —
# without the map the plugin keeps paths of the build machine. The flags
# lito leaves to the release profile (-O*, -g*, LTO, strip) and
# _FORTIFY_SOURCE are cut by the script itself (QEXTRA_ENV_FLAGS=1):
# otherwise, with -O2 from Arch's makepkg.conf, lito refuses before the
# build even starts. The job count comes from MAKEFLAGS (see build()),
# without -jN it is 4, as for the developer; another lito via the LITO
# variable.
_qextra_build() {
  _qextra_source_bundle
  QEXTRA_SOURCE_BUNDLE="$srcdir/qextra-bundle" QEXTRA_ENV_FLAGS=1 \
  QEXTRA_BUILD="$srcdir/qextra-build" XDG_DATA_HOME="$srcdir/qextra-data" \
    bash "$srcdir/rexon/tools/build_qml_qextra.sh" "$srcdir/qml_modules"
}

# We strip our own binaries ourselves: makepkg's global strip is disabled
# for the sake of the bundled engine variant (see options).
# Third-party builds of the bundled engine variant are left alone: the engine
# directory (the AppImage and the plugin, already stripped upstream) and the
# org.waywallen.kde plasmoid — its .so must ship bit for bit as in the
# upstream release (Rexon recognizes the version of a foreign install by
# the runtime hash, KNOWN_RUNTIME_SHA). The default package has neither.
_strip_own_binaries() {
  local f
  local keep=(-path "$pkgdir/usr/lib/rexon/engine")
  if [[ $_bundled_engine == 1 ]]; then
    keep+=(-o -path "$pkgdir/usr/lib/rexon/rexon/kpackage")
  fi
  while IFS= read -r -d '' f; do
    # ELF only: the \x7fELF signature in the first bytes
    [[ "$(head -c4 "$f" | od -An -c | tr -d ' ')" == '177ELF' ]] || continue
    case "$f" in
      *.so|*.so.*) strip --strip-unneeded "$f" ;;
      *) strip --strip-all "$f" ;;
    esac
  done < <(find "$pkgdir" \( "${keep[@]}" \) -prune -o -type f -print0)
}

check() {
  desktop-file-validate "$srcdir/rexon.desktop" "$srcdir/rexon-recover.desktop"
  # The card for Discover/GNOME Software. Two tags are deliberately
  # downgraded to info, everything else still fails the build:
  #  * cid-desktopapp-is-not-rdns — the id must match the desktop entry name
  #    rexon.desktop, and both the manual install and the uninstall use
  #    that desktop entry name;
  #  * url-homepage-missing — the product has no website yet, and an
  #    address must not be made up.
  appstreamcli validate --no-net \
    --override=cid-desktopapp-is-not-rdns=info,url-homepage-missing=info \
    "$srcdir/rexon/packaging/rexon.metainfo.xml"
}

package() {
  cd "$srcdir/rexon"
  local rel=rust/target/release
  local lib="$pkgdir/usr/lib/rexon"

  # ── Rust window — the main entry point of the desktop entry ─────
  # The path is the core's `installer::PACKAGE_MAIN_WINDOW`: the desktop entry
  # points to it, and the `app_parity.rs` check turns red if the path here
  # diverges.
  # The window's QML is baked into the binary itself (static module org.rexon.gui).
  install -Dm755 "$rel/rexon-main-window" "$pkgdir/usr/lib/rexon/rexon-main-window"
  # The Appearance tile helper (snapshots of the Qt style and GTK theme with
  # real widgets) goes next to the window: the core looks for it next to its
  # own binary (`widget_shot::find_helper`, package path
  # `widget_shot::PACKAGE_HELPER`).
  install -Dm755 "$rel/rexon-theme-shot" "$pkgdir/usr/lib/rexon/rexon-theme-shot"

  # ── Login screen safeguard: console text instead of a black screen ──
  # A program without Qt (`login_rescue::RESCUE_BIN_PACKAGE`) and its units:
  # the rexon-login-rescue service and `OnFailure=` drop-ins for
  # display-manager and every known login screen. The texts and the list
  # are printed by the core — there is no second copy in the package. The
  # files are tracked by the package: `pacman -R` removes them itself.
  install -Dm755 "$rel/rexon-login-rescue" "$pkgdir/usr/lib/rexon/rexon-login-rescue"
  local unit
  for unit in $("$rel/rexon-login-rescue" --list-files); do
    install -d "$pkgdir$(dirname "$unit")"
    "$rel/rexon-login-rescue" --file "$unit" > "$pkgdir$unit"
    chmod 644 "$pkgdir$unit"
  done

  # ── Wallpaper host and login splash → PATH ──────────────────────
  # The core looks for them in the developer tree, then in PATH
  # (wallpaper_engine::find_wallpaper_host_binary, session_splash).
  # There is ONE wallpaper host — video, web and Flash are its modes (`--mode video|web|swf`).
  local b
  for b in rexon-wallpaper-host rexon-splash-overlay; do
    install -Dm755 "$rel/$b" "$pkgdir/usr/bin/$b"
  done

  # ── The /usr/bin/rexon launcher ─────────────────────────────────
  # The product's entry point from the command line and from foreign
  # desktop entries. It leads to the Rust window: it understands ALL product flags
  # through the single door of the core (`cli::run_headless` +
  # `cli::start_section`) — --tray, --page=, --apply-defaults,
  # --sanitize-gtk, --session-splash, --recover-kde, the five single-tab
  # flags and --selftest. Arguments are passed through as is.
  # REXON_PACKAGED tells the core it is a packaged install
  # (`installer::detect_default_mode`): offering an install on top of the
  # package is not allowed.
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/rexon" <<'LAUNCHER'
#!/bin/sh
# Rexon launcher (packaged install: AUR / pacman).
REXON_PACKAGED=1
export REXON_PACKAGED
# `rexon doctor` runs without Qt: it is needed when Qt may be broken.
if [ "${1:-}" = doctor ]; then
  exec /usr/lib/rexon/rexon-login-rescue doctor
fi
exec /usr/lib/rexon/rexon-main-window "$@"
LAUNCHER
  chmod 755 "$pkgdir/usr/bin/rexon"

  # ── System QML module directory ─────────────────────────────────
  # The core looks for it as `qml_modules::SYSTEM_MODULE_DIRS`
  # (/usr/lib/rexon/qml_modules) and requires TWO plugins in it (the third,
  # QExtra/libqextraplugin.so, is used when present and built for the
  # process's Qt): Qcm/Material/libqml_materialplugin.so (styling) and
  # waywallen/control/libwaywallen-controlplugin.so (Qt-Protobuf value
  # types). Next to control lies our Rust build librexon_qt_filter.so (the
  # wallpaper filter editor); the tab types are statically built into
  # rexon-main-window and have no .so of their own.
  # The path is a literal, not via $lib: the `app_parity.rs` check looks in
  # the PKGBUILD for exactly the string the core keeps in
  # `qml_modules::SYSTEM_MODULE_DIRS`.
  local qmod="$pkgdir/usr/lib/rexon/qml_modules"
  install -d "$qmod"
  cp -a "$srcdir/qml_modules/." "$qmod/"
  # Build-time rcc input files: they contain the absolute $srcdir path, which
  # does not exist on the user's machine. Qt does not read them at run time —
  # the plugin is already built.
  find "$qmod" -name '*_qml_module_dir_map.qrc' -delete
  # The module's protocol stamp (written by tools/build_qml_control.sh).
  # Without it the core cannot tell the packaged waywallen.control from a
  # stale build in the home directory (`qml_modules::stale_control_dirs`),
  # and the latter would shadow it.
  [ -s "$qmod/waywallen/control/proto.sha256" ] || {
    echo "missing the waywallen.control protocol stamp (proto.sha256)" >&2
    return 1
  }
  # The core does not use the real QExtra without its Qt version stamp
  # (`qml_modules::choose_qextra`: "no stamp next to the plugin") and
  # silently shows the QML stand-in — the package would ship without the
  # very thing the plugin is in it for.
  [ -s "$qmod/QExtra/QT_VERSION" ] && [ -s "$qmod/QExtra/libqextraplugin.so" ] || {
    echo "missing the QExtra plugin or its Qt version stamp (QExtra/QT_VERSION)" >&2
    return 1
  }
  install -Dm755 "$rel/librexon_qt_filter.so" "$qmod/waywallen/control/librexon_qt_filter.so"

  # ── Product data: the tree's data/ → /usr/lib/rexon/rexon ───────
  # The directory the core looks for as
  # `installer::package_data_dir_candidates` and recognizes by
  # `installer::PACKAGE_MARKER_REL`. It used to hold the whole Python
  # package; now ONLY the data the Rust window reads:
  #   * qt_wallpaper_engine/qml_ui — vendored waywallen QML, PageHost, the
  #     warm-up scene and the .qm translation catalog (`remote_l10n`);
  #   * qt_wallpaper_engine/proto/UPSTREAM_TAG — the protocol snapshot tag,
  #     by which the check badge detects an outdated protocol (`we_parity`);
  #   * kpackage/org.waywallen.kde — bundled engine variant only: the Plasma
  #     wallpaper plugin, installed by kpackagetool6
  #     (`waywallen_kde_plugin::bundle_dir`). Only vendor.toml comes from the
  #     tree (by it Rexon knows "we installed it" and the version); the
  #     plasmoid itself is the official release archive, unpacked as is. The
  #     default package has no bundle: the plugin is plasma-wallpaper-waywallen;
  #   * themes.json — the built-in theme database (`themes::builtin_json_path`);
  #   * assets/fonts — bundled skin heading fonts (`ui_base`);
  #   * assets/screenshots — our own desktop screenshots that neither the
  #     project nor Commons has (River; `screenshots::BUNDLED_SUBDIR`).
  local data="$lib/rexon"
  install -d "$data/qt_wallpaper_engine"
  cp -a data/qt_wallpaper_engine/qml_ui "$data/qt_wallpaper_engine/qml_ui"
  install -Dm644 data/qt_wallpaper_engine/proto/UPSTREAM_TAG \
    "$data/qt_wallpaper_engine/proto/UPSTREAM_TAG"
  if [[ $_bundled_engine == 1 ]]; then
    install -d "$data/kpackage"
    # The archive root is already the org.waywallen.kde/ directory.
    bsdtar --no-same-owner -xf "$srcdir/$_wwd_zip" -C "$data/kpackage"
    install -m644 data/kpackage/org.waywallen.kde/vendor.toml \
      "$data/kpackage/org.waywallen.kde/vendor.toml"
  fi
  install -Dm644 data/themes.json "$data/themes.json"
  cp -a data/assets "$data/assets"

  # ── Description translation model → <data>/translate/<pair> ─────
  # The search order is set by the core: the REXON_TRANSLATE_MODEL_DIR
  # variable (developer path), then the distribution directories +
  # `translate/<pair>` (`translator_engine::MODEL_DIR_REL`,
  # `model_dir_candidates`). The file names are the same as in the
  # downloaded Firefox model (`translator_engine::model_files_in`):
  # model.<pair>.intgemm.alphas.bin and vocab.<pair>.spm. If the path or a
  # name diverges, the engine silently says "no model" and descriptions stay
  # in English; the `tests/translator_engine.rs` check turns red for that.
  install -Dm644 "$srcdir/translate/$_mt_pair/$_mt_model" \
    "$data/translate/$_mt_pair/$_mt_model"
  install -Dm644 "$srcdir/translate/$_mt_pair/$_mt_vocab" \
    "$data/translate/$_mt_pair/$_mt_vocab"

  # There are no Python sources in the data directory (Python has been
  # archived since 2026-10-02); remove any bytecode cache just in case it
  # came along.
  find "$data" -name '__pycache__' -type d -prune -exec rm -rf {} +
  find "$data" -name '*.py' -delete

  # ── Interface translations → /usr/share/locale ──────────────────
  # The catalogs were built by the build.rs of the rexon-gui crate
  # (`scripts/i18n-update.sh --build`) next to the binaries:
  # <lang>/LC_MESSAGES/rexon.mo from po/<lang>.po — one catalog for both the
  # Rust strings and the QML strings (the window's QML translator asks the
  # same core). The core looks for it in `i18n::SYSTEM_LOCALEDIR` — exactly
  # this path. A new language = a new .po in po/LINGUAS, the recipe does not
  # change.
  install -d "$pkgdir/usr/share/locale"
  cp -r "$rel/locale/." "$pkgdir/usr/share/locale/"

  # Tray icon: `tray::icon_candidates` looks for it at this path.
  install -Dm644 rexon_icon.png "$lib/rexon_icon.png"

  # ── Privileged helpers and polkit policies ──────────────────────
  # Without them EVERY system operation asks for the password through raw
  # pkexec, and login screen and boot themes from Appearance cannot be
  # installed at all. With them the password is asked less often:
  # auth_admin_keep keeps it for 5 minutes for the Rexon window, and a
  # confirmed org.rexon.pkg covers the other three actions.
  # The texts are printed by the core (`system_plan`, `installer`) — there
  # is no second copy in the package, such copies drift apart silently; the
  # list of helpers also belongs to the core (`--list`). The package has its
  # own path, /usr/lib: a package must not write to /usr/local (Arch
  # packaging rules, and pacman -R would not remove such files), and the
  # policy annotates exactly the path the helper lives at.
  # ⚠️ The package deliberately does NOT install the passwordless rule
  # (/etc/polkit-1/rules.d): that is a separate choice of the person, not a
  # package default.
  local who path
  for who in $("$rel/package-polkit" --list); do
    path=$("$rel/package-polkit" --path "$who")
    install -d "$pkgdir$(dirname "$path")"
    "$rel/package-polkit" --helper "$who" > "$pkgdir$path"
    chmod 755 "$pkgdir$path"
    path=$("$rel/package-polkit" --policy-path "$who")
    install -d "$pkgdir$(dirname "$path")"
    "$rel/package-polkit" --policy "$who" > "$pkgdir$path"
    chmod 644 "$pkgdir$path"
  done

  # ── Privilege session helper ("one password per launch") ────────
  # rexon-priv-helper is not a script but a core binary (cargo built it
  # together with rexon-core): we take the file from the build directory by
  # the name from `--path`; the org.rexon.session policy is printed by the
  # same generator. The policy asks for the password on EVERY session start
  # (auth_admin without keep) — the helper itself holds the one password
  # while the window is open. Mode 755 and owner root are mandatory: the
  # window will not start the helper if the file or a directory above it is
  # writable by anyone other than root (`privilege::client::check_ownership`).
  for who in $("$rel/package-polkit" --list-binaries); do
    path=$("$rel/package-polkit" --path "$who")
    install -Dm755 "$rel/${path##*/}" "$pkgdir$path"
    path=$("$rel/package-polkit" --policy-path "$who")
    install -d "$pkgdir$(dirname "$path")"
    "$rel/package-polkit" --policy "$who" > "$pkgdir$path"
    chmod 644 "$pkgdir$path"
  done
  # The "sudo" of AUR helpers (paru/yay) inside the Rexon window is a shim of
  # the privilege session: it has no privileges, it passes the pacman command
  # line to the window (`privilege::aur`). It lives next to the session
  # helper — that is where the window looks for it.
  install -Dm755 "$rel/rexon-sudo-shim" "$pkgdir/usr/lib/rexon-sudo-shim"

  # ── .desktop files — printed by the core's generator in build() ─
  # The package does NOT install autostart: the tray writes it at the person's choice.
  install -Dm644 "$srcdir/rexon.desktop" \
    "$pkgdir/usr/share/applications/rexon.desktop"
  install -Dm644 "$srcdir/rexon-recover.desktop" \
    "$pkgdir/usr/share/applications/rexon-recover.desktop"

  # ── AppStream: without the card, software centers do not see the product ─
  install -Dm644 packaging/rexon.metainfo.xml \
    "$pkgdir/usr/share/metainfo/rexon.metainfo.xml"

  # ── Icons: hicolor (8 raster sizes) + pixmap fallback ───────────
  # There is deliberately no vector: the old rexon_icon.svg was removed when
  # the new icon arrived (2a09adc); raster sizes up to 512 px are enough.
  local size
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "rexon_icon_${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/rexon.png"
  done
  install -Dm644 rexon_icon_128.png "$pkgdir/usr/share/pixmaps/rexon.png"

  # ── GNOME Shell + Cinnamon extensions (Mutter/Muffin without layer-shell:
  #    wallpapers through a shell extension + mmap frame streaming) ──
  local ext='rexon-wallpaper@rexon.app' d
  install -d "$pkgdir/usr/share/gnome-shell/extensions" \
             "$pkgdir/usr/share/cinnamon/extensions"
  cp -a "data/gnome-extension/$ext" \
    "$pkgdir/usr/share/gnome-shell/extensions/$ext"
  cp -a "data/cinnamon-extension/$ext" \
    "$pkgdir/usr/share/cinnamon/extensions/$ext"
  for d in "$pkgdir/usr/share/gnome-shell/extensions/$ext/schemas" \
           "$pkgdir/usr/share/cinnamon/extensions/$ext/schemas"; do
    [[ -d "$d" ]] && glib-compile-schemas "$d"
  done
  # The same schemas go into the shared directory: without that
  # `gsettings set` (this is how Rexon passes wallpapers to the extension)
  # answers "Schema … does not exist". The shared directory is compiled by
  # the pacman hook of the glib2 package, we do not compile it ourselves.
  # The extension directory above is needed too: the extension's
  # getSettings() reads its own.
  install -Dm644 -t "$pkgdir/usr/share/glib-2.0/schemas" \
    "data/gnome-extension/$ext/schemas/"*.gschema.xml \
    "data/cinnamon-extension/$ext/schemas/"*.gschema.xml

  # ── Licenses ────────────────────────────────────────────────────
  # Our own (Apache-2.0: LICENSE and NOTICE) is mandatory in /usr/share/licenses; next to it the third-party ones:
  # MIT of the Qcm.Material plugin, MIT of the QExtra plugin with its static
  # parts, and OFL-1.1 of the Noto Sans font built into the wallpaper host
  # (Ruffle, the default_font feature).
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE  "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
  install -Dm644 "$srcdir/QmlMaterial/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.QmlMaterial"
  install -Dm644 "$srcdir/rexon/rust/rexon-swf/NotoSans-OFL-1.1.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.NotoSans-OFL-1.1"

  # The QExtra QML plugin (MIT OR Apache-2.0, taken under MIT) and what is
  # statically linked into it: wavsen, vvk, licrypto (the same text and the
  # same © 2026 hypengw line as QExtra), ncrequest (MIT, © 2024-2025
  # hypengw), lihttpto, liwebsocketo and rstd (© 2025 hypengw; the rstd
  # archives carry no license file of their own, their text and line are the
  # same as lihttpto's). MIT requires the notice to ship
  # with every copy — hence three texts, one per copyright line. The list is
  # in NOTICE, section "QExtra".
  install -Dm644 "$srcdir/qextra-src-QExtra/LICENSE-MIT" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.QExtra-MIT"
  local _e _n _v
  # Since QExtra 0.6.0, ncrequest comes as a lito registry package (archive
  # lito-ncrequest-*.tar.zst), not as the qextra-src-ncrequest git source.
  for _e in "${_qe_reg[@]}"; do
    IFS='|' read -r _n _v _ <<<"$_e"
    [[ "$_n" == ncrequest ]] || continue
    bsdtar -xOf "$srcdir/lito-$_n-$_v.tar.zst" "$_n-$_v/LICENSE.txt" \
      > "$pkgdir/usr/share/licenses/$pkgname/LICENSE.ncrequest-MIT"
  done
  for _e in "${_qe_reg[@]}"; do
    IFS='|' read -r _n _v _ <<<"$_e"
    [[ "$_n" == lihttpto ]] || continue
    bsdtar -xOf "$srcdir/lito-$_n-$_v.tar.zst" "$_n-$_v/LICENSE-MIT" \
      > "$pkgdir/usr/share/licenses/$pkgname/LICENSE.lihttpto-MIT"
  done
  [ -s "$pkgdir/usr/share/licenses/$pkgname/LICENSE.lihttpto-MIT" ] || {
    echo "no license text (LICENSE-MIT) found in the lihttpto archive" >&2
    return 1
  }
  chmod 644 "$pkgdir/usr/share/licenses/$pkgname/LICENSE.lihttpto-MIT"

  # ⚖️ The org.waywallen.kde Plasma wallpaper plugin (bundled engine variant
  # only: the official release archive, unmodified, ships in
  # /usr/lib/rexon/rexon/kpackage/ and is installed by kpackagetool6).
  # Upstream states the license in two ways: extensions/kde/LICENSE — MIT ©
  # hypengw, metadata.json — GPL-2.0-or-later. The author has been asked
  # (waywallen/waywallen-display#70); until there is an answer we install
  # BOTH texts: its LICENSE and the GPL-2.0 that metadata.json refers to.
  # Since 0.4.2 LICENSE is inside the release archive itself (#71; bit for
  # bit the same as the tag's extensions/kde/LICENSE) — we no longer
  # download it separately.
  if [[ $_bundled_engine == 1 ]]; then
    [ -s "$data/kpackage/org.waywallen.kde/LICENSE" ] || {
      echo "no LICENSE found in the plasmoid archive $_wwd_zip" >&2
      return 1
    }
    install -Dm644 "$data/kpackage/org.waywallen.kde/LICENSE" \
      "$pkgdir/usr/share/licenses/$pkgname/LICENSE.waywallen-kde-MIT"
    install -Dm644 packaging/licenses/GPL-2.0.txt \
      "$pkgdir/usr/share/licenses/$pkgname/LICENSE.waywallen-kde-GPL-2.0"
  fi

  # The description machine translation engine: the vendored fxtranslate
  # crate (MPL-2.0) and the third-party headers inside it — gemmology (MIT)
  # and xsimd (BSD-3-Clause). BSD-3-Clause explicitly requires reproducing
  # the notice in the documentation, so both texts are installed, not just
  # the MPL.
  local _fx="$srcdir/rexon/rust/vendor/fxtranslate"
  install -Dm644 "$_fx/crate/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.fxtranslate-MPL-2.0"
  install -Dm644 "$_fx/crate/vendor/gemmology/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.gemmology-MIT"
  install -Dm644 "$_fx/crate/vendor/xsimd/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.xsimd-BSD-3-Clause"
  # ⭐ MPL-2.0 is a PER-FILE copyleft: our only obligation is to publish the
  # sources of the crate files we modified. All changes are in a single
  # patch, so the obligation is fulfilled by installing THIS file next to
  # the license — fulfilled completely, without disclosing Rexon code.
  # Analysis: rust/vendor/fxtranslate/ATTRIBUTION.md.
  install -Dm644 "$_fx"/patches/0001-*.patch \
    "$pkgdir/usr/share/licenses/$pkgname/fxtranslate-0.4.2-rexon.patch"

  # The en→ru translation model (mozilla/translations) is under the same
  # MPL-2.0 as the crate: "The model files are distributed under the MPL 2.0
  # license" (upstream README). The model bucket provides no license file of
  # its own, and the MPL-2.0 text is one verbatim document, so the text from
  # the vendored tree is installed under its own name: the user sees what
  # covers the 43 MB next to the product as a separate entry, not a guess.
  # There is nothing to disclose for the model: the files ship UNMODIFIED
  # (we have nothing to change them with), so the per-file copyleft does not
  # apply to them. The notice is in NOTICE above, section "Firefox en→ru
  # translation model".
  install -Dm644 "$_fx/crate/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.translations-model-MPL-2.0"

  if [[ $_bundled_engine == 1 ]]; then
    _package_bundled_engine
  fi

  _strip_own_binaries
}

# ── Bundled engine: waywallen + the Open Wallpaper Engine plugin ────
# The path is the core's `we_client::ENGINE_DIR` (the app_parity.rs check
# looks for it here as a literal). The core starts the AppImage from here if
# there is no system engine (`we_client::engine_layouts`) and the managed
# ~/.local/share/waywallen is not newer, and passes the daemon
# `--plugin /usr/lib/rexon/engine`: the daemon looks for plugins in
# <directory>/plugins/. A user's own copy of the plugin in
# ~/.local/share/waywallen/plugins stays theirs: the daemon takes the newer
# of the two, and the user's copy when they are equal.
# ⚠️ The plugin is NOT self-contained: libwaywallen-bridge.so and ffmpeg are
# provided to it by the daemon's AppImage when the renderer starts (namcap
# warns about this).
# Files do not overlap with the waywallen/open-wallpaper-engine packages:
# those live in /usr/bin, /usr/lib and /usr/share/waywallen.
_package_bundled_engine() {
  local eng="$pkgdir/usr/lib/rexon/engine"
  install -Dm755 "$srcdir/$_ww_appimage" "$eng/waywallen.AppImage"
  install -d "$eng/plugins"
  cp -a --no-preserve=ownership "$srcdir/owe-plugin" "$eng/plugins/$_owe_id"
  chmod -R u+rwX,go+rX,go-w "$eng/plugins/$_owe_id"
  _owe_fix_runpath "$eng/plugins/$_owe_id"

  # GPL-2.0-only §3(a): the complete source next to the binary + the license text.
  install -Dm644 "$srcdir/owe-src/open-wallpaper-engine-${_owe_ver}-src.tar.xz" \
    "$pkgdir/usr/share/rexon/sources/open-wallpaper-engine-${_owe_ver}-src.tar.xz"
  install -Dm644 "$srcdir/open-wallpaper-engine/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.open-wallpaper-engine-GPL-2.0"
  install -Dm644 "$srcdir/waywallen-${_ww_ver}-LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.waywallen-MIT"
  install -Dm644 "$srcdir/owe-src/open-wallpaper-engine-${_owe_ver}/third_party-cef/"*/LICENSE.txt \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.CEF-BSD-3-Clause"
}

# The OWE renderers are built in upstream CI and remember its build RUNPATH
# (/home/runner/work/…/conda-envs/owe-plugin/lib). The user has no such
# directory, but any user named runner could create it — and plant their
# own libraries (namcap: E: Insecure RUNPATH). We keep only the $ORIGIN
# entries: the web renderer needs libcef.so from its own directory, while
# libwaywallen-bridge.so and ffmpeg are provided to both by the daemon via
# its image's LD_LIBRARY_PATH. The daemon and the core
# (`we_client::plugin_manifest_copy`) recognize the plugin by the version
# in plugin.toml, not by file checksums — editing the ELF does not break
# the check.
_owe_fix_runpath() {
  local f rp keep
  while IFS= read -r -d '' f; do
    [[ "$(head -c4 "$f" | od -An -c | tr -d ' ')" == '177ELF' ]] || continue
    rp=$(patchelf --print-rpath "$f") || return 1
    [[ -n $rp ]] || continue
    keep=$(tr ':' '\n' <<<"$rp" | { grep -E '^\$ORIGIN(/|$)' || true; } | paste -sd: -)
    if [[ -z $keep ]]; then
      patchelf --remove-rpath "$f" || return 1
    elif [[ $keep != "$rp" ]]; then
      patchelf --set-rpath "$keep" "$f" || return 1
    fi
  done < <(find "$1" -type f -print0)
}
