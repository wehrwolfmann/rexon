# Only the libcef_dll_wrapper sources of this archive are compiled into the
# plugin; libcef.so itself ships inside the plugin zip.
_cef_archive='cef_binary_149.0.4+g2f1bfd8+chromium-149.0.7827.156_linux64_minimal.tar.bz2'
