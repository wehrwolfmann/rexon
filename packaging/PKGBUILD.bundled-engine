_cef_sha=6d43607675e47ed6bfa40d1cfce136d04e7720529f8f1c4435d4ba1dcd1839b2

# The plasmoid states MIT (LICENSE) and GPL-2.0-or-later (metadata.json);
# both texts ship until upstream clarifies (waywallen/waywallen-display#70).
license+=('GPL-2.0-only' 'GPL-2.0-or-later')
_d=()
for _x in "${depends[@]}"; do
  [[ $_x == waywallen* || $_x == open-wallpaper-engine* ]] || _d+=("$_x")
done
# fuse3: the AppImage runtime; the rest are linked by the plugin's libcef.so and renderers.
depends=("${_d[@]}" fuse3 at-spi2-core nss nspr libcups expat systemd-libs mesa
         libx11 libxcb libxext libxfixes libxcomposite libxdamage libxrandr
         libxkbcommon cairo pango lz4 fontconfig freetype2)
makedepends+=(patchelf)
# The bundled plasmoid imports org.kde.taskmanager (WindowModel.qml).
optdepends+=('plasma-workspace: the bundled Plasma wallpaper plugin (org.kde.taskmanager)')
# makepkg's strip would cut the squashfs off the AppImage; ours skips the engine.
options=('!lto' '!strip' '!debug')
source+=("${_ww_appimage}::https://github.com/waywallen/waywallen/releases/download/v${_ww_ver}/${_ww_appimage}"
         "waywallen-${_ww_ver}-LICENSE::https://raw.githubusercontent.com/waywallen/waywallen/v${_ww_ver}/LICENSE"
         "${_owe_zip}::https://github.com/waywallen/open-wallpaper-engine/releases/download/v${_owe_ver}/${_owe_zip}"
         "open-wallpaper-engine::git+https://github.com/waywallen/open-wallpaper-engine.git#commit=${_owe_commit}"
         "${_cef_archive}::${_cef_url}"
         "${_wwd_zip}::https://github.com/waywallen/waywallen-display/releases/download/v${_wwd_ver}/${_wwd_zip}")
sha256sums+=('148cffac6a744e7b28e7d421ac9a069283a270ca5f5652365855149b00c2a238'
             '2d1edaf74e77c63e166ed948c2fee17a50dd15f73d8e9db249117e5fde8bef24'
             '94db107147c62ca29a1b44ca99a32d809ed9f0f889f381ca268f66e9cd087ae2'
             'SKIP'
             "$_cef_sha"
             'ed0438b4789d3987fca7cc844387b3b69916f07e06ecf794d933a377f2aa659f')
noextract+=("${_owe_zip}" "${_cef_archive}" "${_wwd_zip}")
for _x in "${_owe_git[@]}"; do
  IFS='|' read -r _n _u _c _ <<<"$_x"
  source+=("owe-dep-${_n}::git+${_u}#commit=${_c}")
  sha256sums+=('SKIP')
done
for _x in "${_owe_reg[@]}"; do
  IFS='|' read -r _n _v _s <<<"$_x"
  source+=("lito-${_n}-${_v}.tar.zst::https://registry.litocpp.org/packages/${_n}/${_n}-${_v}.tar.zst")
  sha256sums+=("$_s")
  noextract+=("lito-${_n}-${_v}.tar.zst")
done
unset _d _x _n _u _c _v _s

eval "_base_$(declare -f prepare)"
eval "_base_$(declare -f build)"
eval "_base_$(declare -f package)"

prepare() {
  _base_prepare
  local tag
  tag=$(awk 'NR==1{print $1}' "$srcdir/rexon/data/qt_wallpaper_engine/proto/UPSTREAM_TAG")
  if [[ "$tag" != "v$_ww_ver" ]]; then
    echo "bundled AppImage $_ww_ver, but the protocol was vendored from $tag" >&2
    return 1
  fi
  if (( $(vercmp "$_owe_ver" "$_owe_min") < 0 )); then
    echo "bundled OWE plugin $_owe_ver is older than $_owe_min" >&2
    return 1
  fi
  rm -rf "$srcdir/owe-plugin"
  install -d "$srcdir/owe-plugin"
  bsdtar --no-same-owner -xf "$srcdir/$_owe_zip" -C "$srcdir/owe-plugin"
  grep -qx "id = \"$_owe_id\"" "$srcdir/owe-plugin/plugin.toml" \
    && grep -qx "version = \"$_owe_ver\"" "$srcdir/owe-plugin/plugin.toml" \
    && grep -q "^version = \"$_owe_ver\"" "$srcdir/open-wallpaper-engine/lito.toml" || {
    echo "$_owe_zip or the OWE source is not $_owe_id $_owe_ver" >&2
    return 1
  }
}

build() {
  _base_build
  _owe_source_bundle
}

package() {
  _base_package
  local eng="$pkgdir/usr/lib/rexon/engine"
  install -Dm755 "$srcdir/$_ww_appimage" "$eng/waywallen.AppImage"
  install -d "$eng/plugins"
  cp -a --no-preserve=ownership "$srcdir/owe-plugin" "$eng/plugins/$_owe_id"
  chmod -R u+rwX,go+rX,go-w "$eng/plugins/$_owe_id"
  _owe_fix_runpath "$eng/plugins/$_owe_id"
  install -Dm644 "$srcdir/owe-src/open-wallpaper-engine-${_owe_ver}-src.tar.xz" \
    "$pkgdir/usr/share/rexon/sources/open-wallpaper-engine-${_owe_ver}-src.tar.xz"
  local kpkg="$pkgdir/usr/lib/rexon/rexon/kpackage"
  install -d "$kpkg"
  bsdtar --no-same-owner -xf "$srcdir/$_wwd_zip" -C "$kpkg"
  install -m644 "$srcdir/rexon/data/kpackage/org.waywallen.kde/vendor.toml" \
    "$kpkg/org.waywallen.kde/vendor.toml"
  local lic="$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 "$kpkg/org.waywallen.kde/LICENSE" "$lic/LICENSE.waywallen-kde-MIT"
  install -Dm644 "$srcdir/rexon/packaging/licenses/GPL-2.0.txt" "$lic/LICENSE.waywallen-kde-GPL-2.0"
  install -Dm644 "$srcdir/open-wallpaper-engine/LICENSE" "$lic/LICENSE.open-wallpaper-engine-GPL-2.0"
  install -Dm644 "$srcdir/waywallen-${_ww_ver}-LICENSE" "$lic/LICENSE.waywallen-MIT"
  install -Dm644 "$srcdir/owe-src/open-wallpaper-engine-${_owe_ver}/third_party-cef/"*/LICENSE.txt \
    "$lic/LICENSE.CEF-BSD-3-Clause"
  _strip_own_binaries
}

# Complete source of the OWE plugin: the tag, everything lito builds into it
# (lito's source-bundle layout) and the CEF wrapper sources. Reproducible.
_owe_source_bundle() {
  local top="open-wallpaper-engine-${_owe_ver}"
  local root="$srcdir/owe-src/$top" e n u c d v
  local bundle="$root/.lito/source-bundle/v1"
  rm -rf "$srcdir/owe-src"
  install -d "$bundle/git" "$bundle/registry/source" "$root/third_party-cef"
  git -C "$srcdir/open-wallpaper-engine" archive --format=tar "$_owe_commit" | tar -x -C "$root"
  for e in "${_owe_git[@]}"; do
    IFS='|' read -r n u c d <<<"$e"
    install -d "$bundle/git/$d"
    git -C "$srcdir/owe-dep-$n" archive --format=tar "$c" | tar -x -C "$bundle/git/$d"
  done
  for e in "${_owe_reg[@]}"; do
    IFS='|' read -r n v c <<<"$e"
    install -m644 "$srcdir/lito-$n-$v.tar.zst" "$bundle/registry/source/$n-$v-${c:0:16}.tar.zst"
  done
  bsdtar --no-same-owner -xf "$srcdir/$_cef_archive" -C "$root/third_party-cef" \
    --include '*/include/*' --include '*/libcef_dll/*' --include '*/cmake/*' \
    --include '*/CMakeLists.txt' --include '*/LICENSE.txt' --include '*/README.txt'
  {
    echo "Open Wallpaper Engine ${_owe_ver}: complete source of the ${_owe_id} plugin"
    echo "shipped in /usr/lib/rexon/engine/plugins/. License: GPL-2.0-only (LICENSE)."
    echo "Source: https://github.com/waywallen/open-wallpaper-engine commit ${_owe_commit}."
    echo "Build dependencies (the tag's lito.lock) in .lito/source-bundle/v1/:"
    for e in "${_owe_git[@]}"; do
      IFS='|' read -r n u c d <<<"$e"
      echo "  git/$d  $u @ $c"
    done
    for e in "${_owe_reg[@]}"; do
      IFS='|' read -r n v c <<<"$e"
      echo "  registry/source/$n-$v-${c:0:16}.tar.zst  sha256 $c"
    done
    echo "third_party-cef/: libcef_dll_wrapper and CEF headers (BSD-3-Clause) from"
    echo "  $_cef_url (sha256 $_cef_sha)."
    echo "Build: see BUILD.md (lito, https://github.com/litocpp/lito)."
  } > "$root/SOURCES.txt"
  tar --sort=name --owner=0 --group=0 --numeric-owner --mtime='@0' \
    -C "$srcdir/owe-src" -cf - "$top" | xz -T0 -9 > "$srcdir/owe-src/$top-src.tar.xz"
}

# The renderers carry upstream CI's RUNPATH (/home/runner/...), which any
# user named runner could populate. Keep only $ORIGIN entries.
_owe_fix_runpath() {
  local f rp keep
  while IFS= read -r -d '' f; do
    [[ "$(head -c4 "$f" | od -An -c | tr -d ' ')" == '177ELF' ]] || continue
    rp=$(patchelf --print-rpath "$f") || return 1
    [[ -n $rp ]] || continue
    keep=$(tr ':' '\n' <<<"$rp" | { grep -E '^\$ORIGIN(/|$)' || true; } | paste -sd: -)
    if [[ -z $keep ]]; then
      patchelf --remove-rpath "$f" || return 1
    elif [[ $keep != "$rp" ]]; then
      patchelf --set-rpath "$keep" "$f" || return 1
    fi
  done < <(find "$1" -type f -print0)
}

# Strip our binaries; leave the engine and the upstream plasmoid as shipped.
_strip_own_binaries() {
  local f
  while IFS= read -r -d '' f; do
    [[ "$(head -c4 "$f" | od -An -c | tr -d ' ')" == '177ELF' ]] || continue
    case "$f" in
      *.so|*.so.*) strip --strip-unneeded "$f" ;;
      *) strip --strip-all "$f" ;;
    esac
  done < <(find "$pkgdir" \( -path "$pkgdir/usr/lib/rexon/engine" \
                         -o -path "$pkgdir/usr/lib/rexon/rexon/kpackage" \) -prune \
                         -o -type f -print0)
}
