# Local build variant: the package from ./PKGBUILD (rexon or rexon-git) with
# the wallpaper engine bundled in /usr/lib/rexon/engine instead of depending
# on the waywallen and open-wallpaper-engine packages. For machines and
# channels without those packages (manual install, Steam); not for
# distribution repositories. Copy it next to the PKGBUILD and its .install
# file and run:
#   makepkg -p PKGBUILD.bundled-engine
#
# The daemon is a separate process and the OWE renderers are started by it,
# so the GPL-2.0-only plugin is only aggregated with Rexon (GPL-2 §2); its
# complete source of the same tag ships in /usr/share/rexon/sources (§3(a)).

. "${startdir:-.}/PKGBUILD"
# makepkg -p writes the pkgver() result into this file, not into ./PKGBUILD.
pkgver=$pkgver
pkgrel=$pkgrel

# The AppImage is exactly the tag the protocol was vendored from; the plugin
# fits that daemon (entry_version 5, spawn_version 10). Change them together.
_ww_ver=0.6.3
_ww_appimage="waywallen-${_ww_ver}-${CARCH}.AppImage"
# org.waywallen.kde Plasma wallpaper plugin of the same daemon generation
# (data/kpackage/org.waywallen.kde/vendor.toml), installed per user by Rexon.
